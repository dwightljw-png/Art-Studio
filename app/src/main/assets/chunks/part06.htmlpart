body.kids:not(.cyber) #marbleProgress{color:#5d72ac;background:#e7f1ff;border:1px solid #c0d4f4}
body.kids:not(.cyber) #marbleFlowStatus{color:#7a86b0}
body.kids:not(.cyber) #marbleDock summary{color:#6b6eb0}
body.kids:not(.cyber) #marbleDock #marbleDropMode,
body.kids:not(.cyber) #marbleDock #marbleStirMode,
body.kids:not(.cyber) #marbleDock #marbleClear,
body.kids:not(.cyber) #marbleDock #manualWave,
body.kids:not(.cyber) #marbleDock #sensorBtn,
body.kids:not(.cyber) #marbleDock #shakeBtn,
body.kids:not(.cyber) #marbleDock #marbleStamp{
  background:radial-gradient(ellipse 65% 35% at 43% 12%,#ffffffdd,transparent 78%),linear-gradient(160deg,#ffffff,#eef5ff 74%,#e1efff)!important;
}
body.kids:not(.cyber) #marbleDock #marbleApply,
body.kids:not(.cyber) #settingsApply,
body.kids:not(.cyber) dialog .actions button.primary{
  background:radial-gradient(ellipse 65% 35% at 43% 12%,#ffffffdd,transparent 78%),linear-gradient(160deg,#effff5,#bef2d1 78%,#9de4ba)!important;
  border-color:#7dcf9d!important;color:#377557!important;box-shadow:inset 0 2px 0 #ffffffde,0 3px 0 #9dd8b1,0 5px 7px #72ab8236!important;
}
body.kids:not(.cyber) #marbleCancel,
body.kids:not(.cyber) #closePanel,
body.kids:not(.cyber) dialog .actions button[data-close]{
  background:radial-gradient(ellipse 65% 35% at 43% 12%,#ffffffdd,transparent 78%),linear-gradient(160deg,#fff4f6,#ffd2dc 80%,#fbb7c7)!important;
  border-color:#f0a0b7!important;color:#a35672!important;box-shadow:inset 0 2px 0 #ffffffde,0 3px 0 #e7b0bf,0 5px 7px #a86f8130!important;
}
/* zero-footprint overlay icons */
.kids-button-art{display:none}
body.kids .kids-icon-target>.kids-button-art{display:flex;pointer-events:none;position:absolute;inset:0;align-items:center;justify-content:center;filter:drop-shadow(0 1px 0 #fff) drop-shadow(0 2px 1px #9aa7d055)}
body.kids .kids-icon-target>.kids-button-art svg{width:28px;height:28px;flex:none;fill:none;stroke:none}
body.kids nav .kids-icon-target>.kids-button-art svg{width:33px;height:33px}
body.kids .kids-icon-target>svg,
body.kids .kids-icon-target>.label,
body.kids .kids-icon-target>.kids-original-label,
body.kids #projectBtn>.brand,
body.kids #projectBtn>.kids-original-chevron{visibility:hidden}
.kids-original-label{display:contents}
body.kids .kids-original-label{display:contents;visibility:hidden}
body.kids #moreColorsBtn{color:transparent!important}
body.kids #moreColorsBtn .kids-button-art{display:flex;color:#6576a7}
.kids-option-art,.kids-option-thumb{display:none}
body.kids #panel .choices button .kids-option-label{display:none!important}
body.kids #panel .choices button .kids-option-art{display:inline-flex;justify-content:center;align-items:center;line-height:1;width:30px;height:30px;flex:none;filter:drop-shadow(0 2px 0 #ffffffa0)}
body.kids #panel .choices button .kids-option-art svg{width:28px;height:28px;display:block}
body.kids #panel .choices button .kids-option-thumb{display:block;width:34px;height:34px;max-width:34px;max-height:34px;object-fit:contain;flex:none;filter:drop-shadow(0 1px 0 white) drop-shadow(0 2px 1px #6f7fb54a)}
body.kids #panel .choices button{justify-content:center}
body.kids #panel .choices button[data-key="stamp"]{padding:5px 4px}
.kids-original-setting{display:inline}
body.kids .kids-original-setting{visibility:hidden}
.kids-setting-art{display:none;pointer-events:none}
body.kids .kids-setting-art{display:inline-flex;position:absolute;left:0;top:50%;transform:translateY(-50%);align-items:center;justify-content:center;line-height:1}
body.kids .kids-setting-art svg{width:20px;height:20px;display:block}
body.kids #bottom>label{position:relative}
body.kids .palette .swatch.active i{outline-color:#80a8ff}
body.kids .palette .swatch i{box-shadow:0 2px 3px #4f62823b,inset 0 2px 1px #ffffff55}
body.kids .kids-marble-title{display:inline-flex;align-items:center;gap:6px}
body.kids .kids-marble-title svg{width:22px;height:22px;filter:drop-shadow(0 1px 0 #fff)}
@media(prefers-reduced-motion:reduce){body.kids button{transition:none!important}}
@media print{body.kids #stage::before,body.kids #stage::after{display:none!important}}
body.kids:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle){
 background:radial-gradient(ellipse 65% 35% at 45% 11%,#ffffffeb,transparent 80%),linear-gradient(165deg,#fffefe,#edf5ff 75%,#ddeaff)!important;
 color:#6671a8!important;border-color:#bfd0ee!important;
 box-shadow:inset 0 2px 0 #ffffffdc,inset 0 -1px 0 #cfddf780,0 3px 0 #cad7f0,0 5px 7px #8f9dc62c!important;
}
body.kids:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle):is(.active,.primary){
 background:radial-gradient(ellipse 70% 35% at 43% 13%,#ffffffd9,transparent 78%),linear-gradient(160deg,#f5f8ff,#d7e7ff 78%)!important;
 border-color:#9fbbef!important;box-shadow:inset 0 2px 0 #fff9,0 3px 0 #b8ccf1,0 5px 7px #95a7cf2e!important;
}
body.kids:not(.cyber) nav button:not(#cyberToggle):nth-child(4n+1){background:linear-gradient(155deg,#fff6cb,#ffdf8a)!important;border-color:#ebc97a!important}
body.kids:not(.cyber) nav button:not(#cyberToggle):nth-child(4n+2){background:linear-gradient(155deg,#e5fbff,#c4efff)!important;border-color:#aad7ef!important}
body.kids:not(.cyber) nav button:not(#cyberToggle):nth-child(4n+3){background:linear-gradient(155deg,#f7edff,#dccdff)!important;border-color:#c8b8f2!important}
body.kids:not(.cyber) nav button:not(#cyberToggle):nth-child(4n){background:linear-gradient(155deg,#e8f7ff,#cbe9ff)!important;border-color:#add5ef!important}
body.kids:not(.cyber) nav button:not(#cyberToggle).active{outline:2px solid #82a7f4;outline-offset:-2px}
@media(min-width:956px){body.kids:not(.cyber) header #cyberToggle{width:92px!important;min-width:92px!important;max-width:92px!important;flex:0 0 92px!important;}}
@media (min-width:956px){
 body.cyber header #cyberToggle{width:92px!important;min-width:92px!important;max-width:92px!important;flex:0 0 92px!important;}
 body.cyber header #projectBtn .brand{position:relative}
 body.cyber header #projectBtn .cy-std-title{display:inline!important;visibility:hidden!important}
 body.cyber header #projectBtn .cy-neon-title{display:inline-block!important;position:absolute;left:0;top:0;max-width:100%;overflow:hidden;white-space:nowrap;text-overflow:clip;}
}
/* v4.0 — restore the original KIDS pictogram scale, no button geometry changes.
   v4.0 accidentally dropped the 23px option font-size. */
body.kids #panel .choices button .kids-option-art{
  font-size:23px;line-height:1;
}
body.kids #panel .choices button .kids-option-art svg{
  width:30px;height:30px;
}
/* Retain existing project button footprint. Sticker on the left, readable title
   on the right; both are pointer-transparent decoration. */
body.kids #projectBtn>.kids-button-art{
  left:7px;right:auto;width:35px;inset-block:0;
  justify-content:center;
}
body.kids #projectBtn>.kids-button-art svg{width:29px;height:29px}
body.kids #projectBtn::after{
  content:'ART STUDIO';position:absolute;z-index:3;
  top:50%;left:43px;right:7px;transform:translateY(-50%);
  overflow:hidden;white-space:nowrap;text-overflow:clip;
  font-family:system-ui,-apple-system,'Segoe UI',sans-serif;
  font-size:13px;font-weight:850;letter-spacing:.15px;
  line-height:1.2;text-align:left;color:#536ea3;
  text-shadow:0 1px 0 #fff,0 1px 3px #e8eeff;
  pointer-events:none;
}
@media(max-width:480px){
  body.kids #projectBtn>.kids-button-art{left:3px;width:24px}
  body.kids #projectBtn>.kids-button-art svg{width:23px;height:23px}
  body.kids #projectBtn::after{left:28px;right:2px;font-size:10px;letter-spacing:-.35px}
}
@media(max-width:350px){
  body.kids #projectBtn>.kids-button-art{left:1px;width:15px}
  body.kids #projectBtn>.kids-button-art svg{width:15px;height:15px}
  body.kids #projectBtn::after{left:17px;right:1px;font-size:8px;letter-spacing:-.6px}
}
/* v4.0.8 | Correct previous title patch rather than increasing button widths.
   Match the ORIGINAL button geometry across modes and restore the title's
   full flex width. No drawing/canvas or event styles are touched. */
body.kids #panel .choices button[data-val="airbrush"] .kids-option-art svg,
body.kids #panel .choices button[data-val="pastel"] .kids-option-art svg {
  width:39px!important;height:39px!important;
}
@media(min-width:956px){
  header #projectBtn,body.cyber header #projectBtn{
    width:157px!important;min-width:157px!important;max-width:157px!important;
    flex:0 0 157px!important;
  }
}
@media (min-width:481px) and (max-width:955px){
  body.cyber header #projectBtn{
    width:auto!important;max-width:186px!important;min-width:112px!important;
    flex:0 1 186px!important;
  }
}
@media(min-width:481px){
  body.cyber header #projectBtn{
    justify-content:center!important;align-items:center!important;
    overflow:hidden!important;
  }
  body.cyber header #projectBtn .brand{
    display:flex!important;flex:1 1 0!important;
    flex-direction:column!important;align-items:center!important;justify-content:center!important;
    position:static!important;width:0!important;min-width:0!important;max-width:none!important;
    overflow:visible!important;line-height:1!important;text-align:center!important;
  }
  body.cyber header #projectBtn .cy-std-title{
    display:none!important;visibility:hidden!important;
  }
  body.cyber header #projectBtn .cy-neon-title{
    display:block!important;position:static!important;
    width:max-content!important;max-width:none!important;
    white-space:nowrap!important;overflow:visible!important;text-overflow:clip!important;
    font-size:10.7px!important;letter-spacing:0!important;line-height:1.13!important;
  }
  body.cyber header #projectBtn .brand small{
    display:block!important;width:max-content!important;max-width:none!important;
    margin-top:2px!important;line-height:1.15!important;
    font-size:8.4px!important;letter-spacing:0!important;
    white-space:nowrap!important;overflow:visible!important;text-align:center!important;
  }
}
/* Preserve the original narrower, pictogram-friendly phone header rules. */
</style>

