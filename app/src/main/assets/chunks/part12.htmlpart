if(modal)new MutationObserver(()=>requestAnimationFrame(syncBlank)).observe(modal,{attributes:true,attributeFilter:['open']});
const buttons=['projectBtn','undoBtn','redoBtn','saveBtn','exportBtn','printBtn'];
buttons.forEach(id=>document.getElementById(id)?.addEventListener('click',()=>requestAnimationFrame(syncBlank)));

/* Reusable small local-electricity spark, only on user actions. */
let cv=null,g=null,raf=0,bolts=[],particles=[],rings=[],centerX=0,centerY=0;
const SIZE=340;
function ensureFX(x,y){
 if(!cv){cv=document.createElement('canvas');cv.className='cy-art-fx';cv.setAttribute('aria-hidden','true');
  Object.assign(cv.style,{position:'fixed',left:'0',top:'0',width:SIZE+'px',height:SIZE+'px',pointerEvents:'none',zIndex:'10000'});
  body.appendChild(cv);const d=Math.min(1.5,devicePixelRatio||1);cv.width=SIZE*d;cv.height=SIZE*d;g=cv.getContext('2d');g.setTransform(d,0,0,d,0,0);
 }
 centerX=x;centerY=y;cv.style.transform=`translate3d(${x-SIZE/2}px,${y-SIZE/2}px,0)`;
}
function makeBolt(cx,cy){const pts=[[cx,cy]];let a=Math.random()*Math.PI*2,len=20+Math.random()*42;
 for(let i=1;i<=5;i++)pts.push([cx+Math.cos(a)*len*i/5+(Math.random()-.5)*12,cy+Math.sin(a)*len*i/5+(Math.random()-.5)*12]);
 bolts.push({pts,life:7,col:Math.random()>.5?'#00e8ff':'#ff2bd1'});
}
function frame(){
 g.clearRect(0,0,SIZE,SIZE);g.globalCompositeOperation='lighter';g.lineCap='round';g.lineJoin='round';
 bolts=bolts.filter(b=>{const a=b.life/7;g.beginPath();b.pts.forEach((p,i)=>i?g.lineTo(...p):g.moveTo(...p));
 g.globalAlpha=a*.22;g.strokeStyle=b.col;g.lineWidth=7;g.stroke();g.globalAlpha=a*.85;g.lineWidth=2;g.stroke();g.globalAlpha=a;g.strokeStyle='#fff';g.lineWidth=.9;g.stroke();return --b.life>0});
 rings=rings.filter(r=>{g.globalAlpha=r.life/9*.75;g.strokeStyle='#00e8ff';g.lineWidth=1.2;g.beginPath();g.arc(r.x,r.y,r.r,0,Math.PI*2);g.stroke();r.r+=2.5;return --r.life>0});
 particles=particles.filter(p=>{const a=p.life/13;g.globalAlpha=a;g.strokeStyle=p.c;g.lineWidth=1;g.beginPath();g.moveTo(p.x,p.y);p.x+=p.vx;p.y+=p.vy;p.vy+=.12;g.lineTo(p.x,p.y);g.stroke();return --p.life>0});
 g.globalAlpha=1;
 if(bolts.length||rings.length||particles.length)raf=requestAnimationFrame(frame);
 else {raf=0;g.clearRect(0,0,SIZE,SIZE)}
}
function spark(el,amount=1){
 if(!CY()||RM()||document.hidden||!el)return;
 const r=el.getBoundingClientRect();if(r.width<4||r.height<4)return;
 const x=r.left+r.width/2,y=r.top+r.height/2;ensureFX(x,y);bolts=[];particles=[];rings=[];
 for(let i=0;i<Math.ceil(4*amount);i++)makeBolt(SIZE/2,SIZE/2);
 for(let i=0;i<Math.ceil(19*amount);i++){
  const a=Math.random()*2*Math.PI,sp=1+Math.random()*3;
  particles.push({x:SIZE/2,y:SIZE/2,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp,c:i%3?'#b5faff':'#ffdd77',life:10+Math.random()*3});
 }
 rings.push({x:SIZE/2,y:SIZE/2,r:4,life:9});
 if(!raf)raf=requestAnimationFrame(frame);
}
function magnet(el){if(!CY()||RM()||!el?.animate)return;
 el.animate([{translate:'0 0'},{translate:'-1px .3px'},{translate:'1.1px -.3px'},{translate:'0 0'}],{duration:150,easing:'ease-out'});
}
const loadIds=new Set(['projectBtn','saveBtn','exportBtn','printBtn','marbleApply','marbleStamp','importStamp','canvasStamp','mosaicPreview','outputGo']);
const hotIds=new Set(['undoBtn','redoBtn','marbleDropMode','marbleStirMode','marbleClear','settingsApply','fitBtn']);
/* Capturing passive presentation listener does not preventDefault or stop propagation. */
document.addEventListener('click',ev=>{
 if(!CY())return;
 const b=ev.target.closest?.('button');if(!b||b.disabled||b===button)return;
 const load=loadIds.has(b.id);
 const hot=load||hotIds.has(b.id)||b.hasAttribute('data-tool');
 if(load)spark(b,1.10);
 if(hot){magnet(b);b.classList.add('cy-hot');setTimeout(()=>b.classList.remove('cy-hot'),220)}
},{capture:true,passive:true});
button.addEventListener('click',()=>{if(CY()){spark(button,1.15);magnet(button)}});
const prog=document.getElementById('marbleProgress');
function syncProgressBar(){
 if(!prog)return;
 const m=(prog.textContent||'').match(/(\d{1,3})\s*%/);
 const pct=Math.max(0,Math.min(100,m?Number(m[1]):0));
 prog.style.setProperty('--cy-progress',pct+'%');
 prog.style.setProperty('--cy-bar-active',(!prog.hidden&&pct<100&&pct>0)?'1':'0');
}
 if(prog){let prior=!prog.hidden,lastMilestone=0;
  new MutationObserver(()=>{
    syncProgressBar();
    if(CY()&&!prog.hidden&&!prior){
      spark(document.getElementById('marbleApply'),.75);
      lastMilestone=0;
    }
    const match=(prog.textContent||'').match(/(\d{1,3})\s*%/);
    const milestone=match?Math.floor(Math.min(100,+match[1])/25):0;
    if(CY()&&!prog.hidden&&milestone>lastMilestone&&milestone>0)spark(prog,.55);
    lastMilestone=milestone;
    if(prog.hidden)lastMilestone=0;
    prior=!prog.hidden;
  }).observe(prog,{attributes:true,attributeFilter:['hidden'],childList:true,subtree:true,characterData:true});
  syncProgressBar();
 }
/* On load completion, artwork itself is not flashed or modified; a short
   confirmation at the actual stage is safe even for saved transparent art. */
const imageInput=document.getElementById('imageInput');
imageInput?.addEventListener('change',()=>{if(CY())spark(document.querySelector('[data-tool=stamp]')||button,.6)});
let saved='watercolor';try{saved=localStorage.getItem(KEY)||(localStorage.getItem(OLD_KEY)==='1'?'cyber':'watercolor')}catch(_){}
setMode(saved,false);
})();
</script>

<script id="kids-ui-presentation">
/* v4.0 Sticker Playground refresh. Presentation only — no listener replacement. */
(function(){
'use strict';
const $id=id=>document.getElementById(id);
const sticker=(inner,bg='#ffffff',border='#a8c8ef')=>`<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><path d="M24 2C38 2 46 10 46 24S39 46 24 46 2 38 2 24 10 2 24 2Z" fill="${bg}" stroke="${border}" stroke-width="2"/><ellipse cx="19" cy="9" rx="12" ry="4" fill="#ffffff" opacity=".76"/>${inner}</svg>`;
const mini=inner=>`<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">${inner}</svg>`;
const A={
 project:sticker('<path d="M11 14h23v23H11z" fill="#ffe086" stroke="#c59d4f" stroke-width="2"/><path d="M16 10h22v25H16z" fill="#d8caf9" stroke="#8f82c9" stroke-width="2"/><path d="M26 14l2 5 6 1-5 4 1 6-4-3-5 3 1-6-5-4 6-1Z" fill="#8fcbff"/>','#f0fbff','#9ecff2'),
