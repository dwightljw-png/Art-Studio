 shape:sticker('<rect x="8" y="12" width="17" height="17" rx="3" fill="#8fd2ff" stroke="#5d8ec1" stroke-width="2"/><circle cx="31" cy="29" r="10" fill="#ffd480" stroke="#da9552" stroke-width="2"/><path d="M31 12l4 7h-8Z" fill="#cdb5f5"/>','#eefcff','#98d8d4'),
 fill:sticker('<g transform="rotate(-24 21 23)"><path d="M10 14h22v19H10Z" fill="#e4ddff" stroke="#8a7fc1" stroke-width="2"/><path d="M13 14h16" stroke="#ffffff" stroke-width="3"/></g><path d="M33 30q-6 9 0 13 8 0 3-9Z" fill="#71d8e8" stroke="#3b9fbc" stroke-width="1.5"/>','#edf9ff','#95d2eb'),
 stamp:sticker('<rect x="15" y="9" width="19" height="8" rx="4" fill="#ffd486" stroke="#b98666" stroke-width="2"/><path d="M19 16h11l4 13H15Z" fill="#cdc2ff" stroke="#8c80c7" stroke-width="2"/><path d="M13 31h24v7H13z" fill="#98dbde" stroke="#4da4aa" stroke-width="2"/><path d="M24 20l2 4h4l-3 3 1 4-4-2-4 2 1-4-3-3h4Z" fill="#fff3a4"/>','#fff8e3','#f0c8a0'),
 effects:sticker('<path d="M20 8l3.3 8.7L32 20l-8.7 3.3L20 32l-3.3-8.7L8 20l8.7-3.3Z" fill="#fff0a3" stroke="#8272bd" stroke-width="2.8" stroke-linejoin="round"/><path d="M34 6v10m-5-5h10" stroke="#6ebfdd" stroke-width="3.3" stroke-linecap="round"/><path d="M34 30v8m-4-4h8" stroke="#e3b1f9" stroke-width="2.7" stroke-linecap="round"/>','#f8f6ff','#b7c8f3'),
 eraser:sticker('<g transform="rotate(-28 24 24)"><rect x="13" y="12" width="22" height="26" rx="6" fill="#ffd0e7" stroke="#b987c2" stroke-width="2"/><path d="M13 26h22v5H13z" fill="#fff" opacity=".75"/></g>','#f8f4ff','#d6bef0'),
 undo:sticker('<path d="M17 18l-8 7 8 7" fill="none" stroke="#6f7cb2" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 25h15c15 0 15 13 3 13" fill="none" stroke="#6ed4e4" stroke-width="5" stroke-linecap="round"/>','#effbff','#98d8eb'),
 redo:sticker('<path d="M31 18l8 7-8 7" fill="none" stroke="#6f7cb2" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><path d="M37 25H22C7 25 7 38 19 38" fill="none" stroke="#c9b2ff" stroke-width="5" stroke-linecap="round"/>','#f6f2ff','#c3d4f2'),
 save:sticker('<path d="M10 22h28v17H10Z" fill="#ffd57e" stroke="#b98c56" stroke-width="2"/><path d="M8 17h32v9H8Z" fill="#cbd5ff" stroke="#8795ca" stroke-width="2"/><path d="M21 17V9h6v8" fill="none" stroke="#6fa7d8" stroke-width="3"/><path d="M20 29h8" stroke="#ffffff" stroke-width="3"/>','#f8ffeb','#bde1ca'),
