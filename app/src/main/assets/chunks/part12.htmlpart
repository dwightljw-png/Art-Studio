 settings:sticker('<circle cx="24" cy="24" r="14" fill="#c9bef8" stroke="#8f85ca" stroke-width="2"/><circle cx="24" cy="24" r="7" fill="#fff4cf" stroke="#9c90b8" stroke-width="2"/><path d="M24 4v7m0 26v7M4 24h7m26 0h7M9 9l5 5m20 20 5 5M39 9l-5 5M14 34l-5 5" stroke="#9cd8f2" stroke-width="4"/>','#fbf8ff','#cfcbf0'),
