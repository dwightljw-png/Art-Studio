}
/* Canvas alone remains exactly the original unfiltered, untinted white paper.
   Stage image is purely a background, never composited into document/export. */
body:not(.cyber) #view,body:not(.cyber) #exportPreview,
body:not(.cyber) #marbleCanvas,body:not(.cyber) .work img{
 filter:none!important;
}
body:not(.cyber) .brand{
 color:#396c80;
 text-shadow:0 1px 0 #fff,0 1px 7px #75bac12b;
}
body:not(.cyber) .brand small{color:#729cab}
body:not(.cyber) .divider{background:linear-gradient(180deg,transparent,#8dc4caab,transparent)}
body:not(.cyber) #panel,
body:not(.cyber) #marbleDock,
body:not(.cyber) #viewbar,
body:not(.cyber) #context,
body:not(.cyber) dialog,
body:not(.cyber) #headerMoreMenu{
 background:#fbffff url("data:image/jpeg;base64,") center / cover no-repeat;
 border-color:#a9d1d6;
 box-shadow:0 12px 36px #386f8e29,0 1px 0 #fff inset;
}
body:not(.cyber) .panelhead strong,
body:not(.cyber) #marbleDock strong{color:#376e81}
body:not(.cyber) .section,
body:not(.cyber) .note,
body:not(.cyber) label{color:#6d909a}
body:not(.cyber) .field label{color:#375b68}
body:not(.cyber) #saveState{color:#658c9a}
body:not(.cyber) .status{background:#eaf7f5bd;color:#507581}
body:not(.cyber) #marbleFlowStatus{background:#e5f6f5d9}
/* Original buttons keep their actual dimensions and typography. The two
   translucent washes and tiny shadows are paint on their existing surfaces. */
body:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle){
 background:#faffff url("data:image/jpeg;base64,") center / cover no-repeat;
 color:#427587;
 border-color:#add3da;
 box-shadow:inset 0 1px 0 #ffffffc7,0 2px 4px #387f961b,
   0 0 0 1px #ffffff52;
}
body:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle):hover:not(:disabled){
 background-color:#e9faf8;
 border-color:#7ab8c3;
 box-shadow:inset 0 1px 0 #fff,0 3px 8px #3e829b30;
}
body:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle):is(.active,.primary){
 color:#176c88;
 background:#d6f2f0 url("data:image/jpeg;base64,") center / cover no-repeat;
 border-color:#62afb8;
 box-shadow:inset 0 1px 1px #fff,0 2px 6px #468ca42f,
   0 0 0 1px #c4e5e7;
}
body:not(.cyber) #cyberToggle{
 background:linear-gradient(135deg,#d8f3f1,#f9fffc);
 color:#2f7f95;border-color:#75bdc7;
 box-shadow:inset 0 1px 1px #ffffffb0,0 2px 7px #3e839a26;
}
body:not(.cyber) #cyberToggle:hover{background:linear-gradient(135deg,#c5edea,#edf9ff)}
body:not(.cyber) #panel .choices button.active,
body:not(.cyber) #marbleDock .marble-mode button.active{
 border-color:#63b4b8;background:#d3f2ee;color:#196f89;
}
body:not(.cyber) input:not([type=color]):not([type=range]):not([type=checkbox]),
body:not(.cyber) select,body:not(.cyber) textarea{
 background:#fcffff;border-color:#b7d7dc;color:#375b68;
}
body:not(.cyber) input[type=color]{background:#faffff;border-color:#b0d3d9}
body:not(.cyber) input[type=range],body:not(.cyber) input[type=checkbox]{accent-color:#4798ac}
body:not(.cyber) .swatch.active i{outline-color:#3e9aaf}
body:not(.cyber) .color-controls .more-colors{
 background:#edf9f9 url("data:image/jpeg;base64,") center / cover no-repeat;
 border-color:#aad0d7;color:#3b798d;
}
body:not(.cyber) .color-chip i,body:not(.cyber) .swatch i{
 filter:none!important;
}
body:not(.cyber) .custom-stamp-row,body:not(.cyber) .work{
 border-color:#bbdce0;
}
body:not(.cyber) #toast{background:#2e6878;color:#fff}
/* The print stylesheet still hides UI and outputs ONLY #printRoot.
   Do not introduce stage decorations into printable or exported content. */

</style>
</head><body>
<header><button id="projectBtn" title="프로젝트 관리"><span class="brand"><span class="cy-std-title">ART STUDIO</span><span class="cy-neon-title">C<span class="cy-bad">Y</span>BER ART STUDIO</span><small>나의 작은 작업실 · v3.0</small></span><span>⌄</span></button><button id="cyberToggle" type="button" aria-pressed="false" title="사이버UI 켜기"><span class="cy-switch-symbol">◢</span><span class="cy-switch-label">CYBER UI</span></button><button id="fullscreenBtn" title="전체화면" aria-label="전체화면"></button><span class="divider"></span><button id="undoBtn" title="실행취소 (Ctrl+Z)"></button><button id="redoBtn" title="다시실행 (Ctrl+Shift+Z)"></button><span class="divider"></span><button id="saveBtn" title="원본 파일 저장"></button><button id="exportBtn" title="이미지 · PDF 내보내기"></button><button id="printBtn" title="인쇄"></button><button id="headerMoreBtn" type="button" aria-label="더보기 메뉴" title="내보내기 · 인쇄 · 설정" aria-expanded="false" aria-controls="headerMoreMenu" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.8" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.8" fill="currentColor" stroke="none"/></svg></button><span class="spacer"></span><span id="saveState">새 작업</span><button id="settingsBtn" title="설정"></button></header>
<div id="headerMoreMenu" role="menu" aria-label="추가 기능" hidden><button type="button" class="more-redo" data-header-action="redoBtn" role="menuitem">다시실행</button><button type="button" data-header-action="exportBtn" role="menuitem">내보내기</button><button type="button" data-header-action="printBtn" role="menuitem">인쇄</button><button type="button" data-header-action="settingsBtn" role="menuitem">설정</button></div>
<div id="workspace"><nav id="toolbar"></nav><main id="stage"><canvas id="view"></canvas><div class="cy-art-mark" aria-hidden="true"><div class="cy-art-logo"></div><span class="cy-art-sub">CREATIVE DRAWING SYSTEM · V3.0</span></div><div id="hint">마음 가는 대로, 가볍게 시작하세요.</div><section id="marbleDock" hidden aria-label="캔버스 마블링 조작">
 <div class="marble-top"><strong>🌊 마블링</strong><button id="marbleCancel">취소</button><button id="marbleApply" class="primary">적용</button></div>
 <div class="marble-quick"><div class="marble-mode" aria-label="마블링 입력 모드"><button id="marbleDropMode" class="active" aria-pressed="true">● 물감 떨어뜨리기</button><button id="marbleStirMode" aria-pressed="false">〰 휘젓기</button></div><label id="marbleDropSizeRow">방울 크기 <input id="dropSize" type="range" min="3" max="40" value="16"><output id="dropSizeValue" for="dropSize">16</output></label><label id="marbleStirSizeRow" hidden>휘젓기 굵기 <input id="stirSize" type="range" min="3" max="65" value="35"><output id="stirSizeValue" for="stirSize">35</output></label><button id="marbleClear" title="마블링 물감 초기화">초기화</button></div>
 <div id="marbleFlowStatus" class="note" aria-live="off">물감 모드에서는 한 번 눌러 방울을 놓고, 휘젓기 모드에서는 손가락으로 물감을 밀어보세요.</div><div id="marbleProgress" hidden></div>
 <details id="marbleMore"><summary>기울기 · 점도 · 출력 옵션</summary><div class="marble-fields">
 <label>점도<input id="viscosity" type="range" min="0" max="100" value="60"></label>
 <label>흐름 강도<input id="flow" type="range" min="0" max="100" value="50"></label>
 <label>가로 기울기<input id="tiltX" type="range" min="-30" max="30" value="0"></label>
 <label>세로 기울기<input id="tiltY" type="range" min="-30" max="30" value="0"></label>
 <label>센서 민감도<input id="sensitivity" type="range" min="10" max="200" value="100"></label>
 <label>최종 화질<select id="marbleQuality"><option value="auto">자동 (최대 1600px)</option><option value="640">빠르게 640px</option><option value="1280">표준 1280px</option><option value="2048">인쇄 2048px</option></select></label></div>
 <div class="marble-tools"><button id="sensorBtn">기울기 센서 ON</button><button id="shakeBtn">흔들림 센서 ON</button><button id="manualWave">파동 만들기</button><button id="marbleStamp">소재로 저장</button></div></details>
 <canvas id="marbleCanvas" width="320" height="220" hidden></canvas></section><div id="viewbar"><button id="zoomOut" title="축소">−</button><span id="zoomLabel">100%</span><button id="zoomIn" title="확대">+</button><button id="fitBtn" title="화면 맞춤"></button></div><div id="context" hidden></div></main><aside id="panel" hidden><div class="panelhead"><strong id="panelTitle"></strong><div class="panelhead-actions"><button id="pinBtn" type="button" title="패널 고정" aria-label="패널 고정" aria-pressed="false"></button><button id="closePanel" type="button" title="패널 닫기" aria-label="패널 닫기"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button></div></div><div id="panelBody"></div></aside></div>
<section id="runtimeAlert" role="alert"><strong>그림판 실행이 시작되지 않았습니다.</strong><p>현재 HTML 보기에서 JavaScript 실행이 차단되었거나 시작 중 오류가 발생했습니다. 그래서 도구와 그림판이 보이지 않습니다.</p><p><b>확인:</b> Chrome 설정 → 사이트 설정 → JavaScript 허용. 또는 파일 관리자 미리보기를 거치지 않고 스크립트 실행이 허용된 웹 주소(HTTPS)에서 열어주세요.</p><p>이 메시지가 보이면 화면을 눌러도 그림이 그려지지 않습니다.</p><p id="runtimeErrorDetail"></p></section><footer id="bottom"><div id="colorControls" class="color-controls" title="현재 색상"><input type="color" id="color" value="#0284c7" title="현재 색상"><div class="palette" id="palette"></div><button id="moreColorsBtn" class="more-colors" title="더 많은 색상" aria-label="더 많은 색상">색상 +</button></div><span class="divider"></span><label>굵기 <input id="size" type="range" min="1" max="160" value="8"><span id="sizeOut">8</span></label><label>농도 <input id="alpha" type="range" min="1" max="100" value="100"><span id="alphaOut">100%</span></label><button id="optionsBtn" title="도구 옵션"></button></footer>
<dialog id="modal"><div id="modalBody"></div></dialog><div id="toast" hidden></div><div id="printRoot"></div><input type="file" id="imageInput" accept="image/*" hidden><input type="file" id="projectInput" accept=".artstudio,application/json" hidden>
<script>
/* Catch startup errors to avoid a silently empty work area. */
window.addEventListener('error', function(e){
  var p=document.getElementById('runtimeErrorDetail');
  if(p && !document.documentElement.classList.contains('art-ready')){
    p.textContent='오류: '+(e.message||'알 수 없는 실행 오류');
  }
});
'use strict';
/* ART STUDIO 1.5 — dependency-free single-file source.
   Sections: UI / Scene & renderer / Input / Selection / Effects / Persistence / Output / Validation.
   Document coordinates are immutable under viewport changes. No layer UI. */
const $=id=>document.getElementById(id), clamp=(n,a,b)=>Math.max(a,Math.min(b,n)), clone=o=>JSON.parse(JSON.stringify(o));
const paths={undo:'M9 5 4 10l5 5M4 10h10a6 6 0 0 1 0 12',redo:'m15 5 5 5-5 5m5-5H10a6 6 0 0 0 0 12',save:'M5 3h12l4 4v14H3V3h2Zm2 0v7h10V3M7 21v-7h10v7',export:'M12 15V3m-4 4 4-4 4 4M4 13v8h16v-8',print:'M6 9V3h12v6M6 17H3V9h18v8h-3M6 14h12v7H6Z',settings:'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8M12 2v3m0 14v3M2 12h3m14 0h3M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2',help:'M9 8a3 3 0 1 1 5 2c-2 1-2 2-2 4m0 3v.1M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20',select:'m5 3 14 10-7 1-3 7Z',draw:'m4 17-1 4 4-1L20 7l-4-4Zm10-12 4 4',shape:'M3 4h10v10H3ZM16 11a5 5 0 1 0 0 10 5 5 0 0 0 0-10',fill:'m5 4 12 12M3 12l9-9 9 9-9 9ZM2 22h20',stamp:'M8 13V9a4 4 0 0 1 8 0v4l4 3v3H4v-3ZM5 22h14',effects:'m12 3 2 6 7 3-7 2-2 7-3-7-6-2 6-3ZM19 2v4m-2-2h4',eraser:'m3 14 10-11 8 8-9 10H9ZM7 10l9 8M12 21h9',fit:'M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5',options:'M3 6h18M3 12h18M3 18h18M8 3v6m8 0v6m-8 0v6',pin:'M8 3h8l-1 6 2 3v2H7v-2l2-3-1-6M12 14v8',fullscreen:'M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5',restore:'M3 9h6V3m12 6h-6V3M3 15h6v6m12-6h-6v6'};
const icon=n=>`<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${paths[n]||paths.draw}"/></svg>`;
for(const [id,n,t] of [['undoBtn','undo',''],['redoBtn','redo',''],['saveBtn','save','저장'],['exportBtn','export','내보내기'],['printBtn','print','인쇄'],['settingsBtn','settings',''],['fitBtn','fit',''],['fullscreenBtn','fullscreen',''],['optionsBtn','options',''],['pinBtn','pin','']])$(id).innerHTML=icon(n)+(t?`<span class="label">${t}</span>`:'');
const toolNames={select:'선택',draw:'그리기',shape:'도형',fill:'채우기',stamp:'스탬프',effects:'미술기법',eraser:'지우개'};
for(const [k,v] of Object.entries(toolNames)){const b=document.createElement('button');b.innerHTML=icon(k)+v;b.title=v+' · 다시 누르면 옵션';b.dataset.tool=k;b.onclick=()=>setTool(k);let tm;b.onpointerdown=()=>tm=setTimeout(()=>{setTool(k);showPanel()},450);b.onpointerup=b.onpointerleave=()=>clearTimeout(tm);$('toolbar').append(b)}
// V1.4: expanded, categorized swatches with a compact quick palette.
const palette=['#0f172a','#ffffff','#64748b','#ef4444','#f97316','#facc15','#22c55e','#0284c7','#6366f1','#a855f7','#ec4899','#a16207','#06b6d4','#84cc16','#fb7185','#f9a8d4','#fef08a','#c4b5fd','#94a3b8','#000000'];
const extraColorGroups={
 '기본·회색':['#000000','#0f172a','#334155','#64748b','#94a3b8','#cbd5e1','#e2e8f0','#f1f5f9','#ffffff'],
 '빨강·주황':['#7f1d1d','#b91c1c','#ef4444','#f87171','#fecaca','#9a3412','#ea580c','#f97316','#fb923c','#fed7aa'],
 '노랑·초록':['#854d0e','#ca8a04','#eab308','#facc15','#fef08a','#365314','#65a30d','#84cc16','#16a34a','#86efac'],
 '청록·파랑':['#115e59','#0d9488','#2dd4bf','#06b6d4','#67e8f9','#1e3a8a','#2563eb','#0284c7','#60a5fa','#bae6fd'],
 '보라·분홍':['#4c1d95','#7c3aed','#8b5cf6','#a855f7','#c4b5fd','#831843','#db2777','#ec4899','#f9a8d4','#fce7f3'],
 '자연·파스텔':['#78350f','#a16207','#b45309','#d6b58a','#e7c9ad','#b3c8a4','#c1e1c1','#a7c7e7','#b8d8e8','#eac7d7']
};
// Only tools that actively consume the selected color can change the palette.
// Marbling is an overlay session: it consumes the same shared color as the bottom bar.
function colorControlsActive(){return !!marble||tool==='draw'&&settings.brush!=='smudge'||tool==='shape'||tool==='stamp'||tool==='fill'&&settings.brush==='bucket'||tool==='effects'&&settings.effect==='tile'}
function applyColor(c){if(!colorControlsActive())return;settings.color=c;$('color').value=c;document.querySelectorAll('.swatch').forEach(b=>b.classList.toggle('active',b.dataset.color===c));syncSelectedStyle()}
for(const c of palette){const b=document.createElement('button');b.className='swatch';b.dataset.color=c;b.style.setProperty('--c',c);b.title=c;b.setAttribute('aria-label','색상 '+c);b.innerHTML='<i></i>';b.onclick=()=>applyColor(c);$('palette').append(b)}

// All quick colors remain present; only the palette's own viewport scrolls horizontally.
function updateQuickPaletteLayout(){
 const cc=$('colorControls'), pal=$('palette');
 if(!cc||!pal)return;
 cc.classList.toggle('compact',(window.innerWidth||document.documentElement.clientWidth)<=760);
 pal.querySelectorAll('.swatch').forEach(b=>b.classList.remove('is-hidden'));
}
window.addEventListener('resize',()=>requestAnimationFrame(updateQuickPaletteLayout));

function openMoreColors(){if(!colorControlsActive())return;const content=Object.entries(extraColorGroups).map(([name,colors])=>`<section class="color-section"><strong>${name}</strong><div class="color-grid">${colors.map(c=>`<button class="color-chip" style="--c:${c}" data-color="${c}" title="${c}" aria-label="색상 ${c}"><i></i></button>`).join('')}</div></section>`).join('');modal(`<h2>색상 팔레트</h2><p class="note">색을 선택하면 현재 브러시 또는 선택한 도형에 적용됩니다.</p><div class="color-sections">${content}</div><div class="actions"><button data-close>닫기</button></div>`);$('modalBody').querySelectorAll('.color-chip').forEach(b=>b.onclick=()=>{applyColor(b.dataset.color);closeModal()})}
$('moreColorsBtn').onclick=openMoreColors;
function updateColorControls(){const enabled=colorControlsActive(),off=!enabled,el=$('colorControls');el.classList.toggle('is-eraser',off);el.setAttribute('aria-disabled',String(off));el.title=enabled?'현재 도구의 색상 선택':'이 도구에서는 색상을 사용하지 않습니다';$('color').disabled=off;$('moreColorsBtn').disabled=off;el.querySelectorAll('.swatch').forEach(b=>b.disabled=off)}
const brushProfiles={pencil:{size:3,alpha:.78},pen:{size:8,alpha:1},brush:{size:20,alpha:.88},marker:{size:26,alpha:.88},airbrush:{size:50,alpha:.50},pastel:{size:32,alpha:.72},smudge:{size:36,alpha:.65},eraser:{size:34,alpha:1}};
let lastDrawingBrush='pen';
function rememberBrushProfile(){let name=tool==='eraser'?'eraser':tool==='draw'?settings.brush:null;if(name&&brushProfiles[name]){brushProfiles[name]={size:settings.size,alpha:settings.alpha};if(tool==='draw')lastDrawingBrush=name}}
function restoreBrushProfile(name){const p=brushProfiles[name];if(!p)return;settings.size=p.size;settings.alpha=p.alpha;$('size').value=String(p.size);$('sizeOut').textContent=String(p.size);$('alpha').value=String(Math.round(p.alpha*100));$('alphaOut').textContent=Math.round(p.alpha*100)+'%'}
let doc={format:'ART-STUDIO',version:1,id:uid(),name:'제목 없는 작품',w:1400,h:990,bg:'#ffffff',objects:[],updated:Date.now()};
let settings={color:'#0284c7',size:8,alpha:1,brush:'pen',smooth:.35,pressure:true,penOnly:false,shape:'rect',fillShape:true,stroke:true,select:'tap',stamp:'flower',stampSize:100,stampSpace:65,effect:'mirror',spread:5,press:0.3,tile:'square',tileSize:32,gap:3,tileAngle:0,tileColors:16,tolerance:30,snap:false,grid:false,pin:false};
let tool='draw',selected=null,live=null,axis=null,preview=null,gesture=null,drag=null,history=[],future=[],dirty=false,saving=false,saveTimer,db=null,assets=new Map(),pointerMap=new Map(),penActive=false,gestureBlock=false,framePending=false,copyBuffer=null;
const stage=$('stage'),view=$('view'),vctx=view.getContext('2d'),board=canvas(doc.w,doc.h),ctx=board.getContext('2d',{willReadFrequently:true});
let camera={z:1,x:0,y:0},dpr=1;
function uid(){return typeof crypto.randomUUID==='function'?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)}
function canvas(w,h){const c=document.createElement('canvas');c.width=Math.max(1,Math.round(w));c.height=Math.max(1,Math.round(h));return c}
function toast(s){$('toast').textContent=s;$('toast').hidden=false;clearTimeout(toast.timer);toast.timer=setTimeout(()=>$('toast').hidden=true,3300)}
function toDoc(x,y){return{x:(x-camera.x)/camera.z,y:(y-camera.y)/camera.z}}
function point(e){const r=stage.getBoundingClientRect(),p=toDoc(e.clientX-r.left,e.clientY-r.top);if(settings.snap){p.x=Math.round(p.x/25)*25;p.y=Math.round(p.y/25)*25}p.p=e.pointerType==='pen'&&settings.pressure?Math.max(.08,e.pressure||.5):.5;return p}
function fit(){camera.z=Math.max(.02,Math.min((stage.clientWidth-70)/doc.w,(stage.clientHeight-70)/doc.h));camera.x=(stage.clientWidth-doc.w*camera.z)/2;camera.y=(stage.clientHeight-doc.h*camera.z)/2;paint()}
function zoom(f,x=stage.clientWidth/2,y=stage.clientHeight/2){const p=toDoc(x,y);camera.z=clamp(camera.z*f,.02,12);camera.x=x-p.x*camera.z;camera.y=y-p.y*camera.z;paint()}
function resize(){const w=stage.clientWidth,h=stage.clientHeight,oldW=view.width/dpr,oldH=view.height/dpr;dpr=Math.min(window.devicePixelRatio||1,2);view.width=Math.round(w*dpr);view.height=Math.round(h*dpr);view.style.width=w+'px';view.style.height=h+'px';camera.x+=(w-oldW)/2;camera.y+=(h-oldH)/2;paint()}
new ResizeObserver(resize).observe(stage);
function objectById(){return doc.objects.find(o=>o.id===selected)}
function checkpoint(){history.push(JSON.stringify(doc));let bytes=history.reduce((n,s)=>n+s.length*2,0);while(history.length>1&&(history.length>40||bytes>64e6))bytes-=history.shift().length*2;future=[];updateUndo()}
function changed(skipFullRender=false){pruneAssets();doc.updated=Date.now();dirty=true;clearTimeout(saveTimer);saveTimer=setTimeout(()=>saveLocal(),900);if(skipFullRender)paint();else render();updateUndo()}
function updateUndo(){$('undoBtn').disabled=!history.length;$('redoBtn').disabled=!future.length}
async function undo(){if(live||drag||pointerMap.size)return;cancelEffect();if(!history.length)return;future.push(JSON.stringify(doc));await loadDoc(JSON.parse(history.pop()),false);dirty=true;saveTimer=setTimeout(saveLocal,400);updateUndo()}
async function redo(){if(live||drag||pointerMap.size)return;if(!future.length)return;history.push(JSON.stringify(doc));await loadDoc(JSON.parse(future.pop()),false);dirty=true;saveTimer=setTimeout(saveLocal,400);updateUndo()}
function pathShape(g,type,w,h){g.beginPath();if(type==='rect')g.rect(-w/2,-h/2,w,h);else if(type==='round')g.roundRect(-w/2,-h/2,w,h,Math.min(w,h)*.18);else if(type==='ellipse'||type==='circle')g.ellipse(0,0,w/2,h/2,0,0,Math.PI*2);else if(type==='line'){g.moveTo(-w/2,-h/2);g.lineTo(w/2,h/2)}else if(type==='heart'){g.moveTo(0,h*.48);g.bezierCurveTo(-w*.9,-h*.05,-w*.45,-h*.85,0,-h*.22);g.bezierCurveTo(w*.45,-h*.85,w*.9,-h*.05,0,h*.48)}else if(type==='arrow'){g.moveTo(-w/2,-h*.17);g.lineTo(w*.1,-h*.17);g.lineTo(w*.1,-h/2);g.lineTo(w/2,0);g.lineTo(w*.1,h/2);g.lineTo(w*.1,h*.17);g.lineTo(-w/2,h*.17);g.closePath()}else if(type==='bubble'){g.roundRect(-w/2,-h/2,w,h*.8,Math.min(w,h)*.12);g.moveTo(-w*.15,h*.3);g.lineTo(-w*.25,h*.5);g.lineTo(w*.1,h*.3)}else{const n={triangle:3,diamond:4,pentagon:5,hexagon:6,star:10}[type]||4;for(let i=0;i<n;i++){let r=type==='star'&&i%2?.43:1,a=-Math.PI/2+i*Math.PI*2/n;g[i?'lineTo':'moveTo'](Math.cos(a)*w*.5*r,Math.sin(a)*h*.5*r)}g.closePath()}}
const builtInStamps=[
 ['flower','꽃'],['leaf','잎'],['tree','나무'],['sun','태양'],['cloud','구름'],['cat','고양이'],
 ['fish','물고기'],['butterfly','나비'],['car','자동차'],['boat','배'],['sparkle','별'],['heart','하트'],
 ['dog','강아지'],['rabbit','토끼'],['owl','부엉이'],['mountain','산'],['rainbow','무지개'],
 ['mushroom','버섯'],['house','집'],['rocket','로켓'],['bicycle','자전거'],
 ['cupcake','컵케이크'],['gift','선물'],['snowman','눈사람']
];
const builtInExtraNames=new Set(builtInStamps.slice(12).map(([key])=>key));
// Additional built-in stamps (v1.6.8). Each uses the same document-space
// vector coordinates as the twelve original stamps (roughly -50..50).
function stampArtExtra(g,name,color){