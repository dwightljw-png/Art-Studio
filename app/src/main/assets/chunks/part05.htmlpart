}
/* Canvas alone remains exactly the original unfiltered, untinted white paper.
   Stage image is purely a background, never composited into document/export. */
body:not(.cyber) #view,body:not(.cyber) #exportPreview,
body:not(.cyber) #marbleCanvas,body:not(.cyber) .work img{
 filter:none!important;
}
body:not(.cyber) .brand{
 color:#396c80;
 text-shadow:0 1px 0 #fff,0 1px 7px #75bac12b;
}
body:not(.cyber) .brand small{color:#729cab}
body:not(.cyber) .divider{background:linear-gradient(180deg,transparent,#8dc4caab,transparent)}
body:not(.cyber) #panel,
body:not(.cyber) #marbleDock,
body:not(.cyber) #viewbar,
body:not(.cyber) #context,
body:not(.cyber) dialog,
body:not(.cyber) #headerMoreMenu{
 background:#fbffff url("data:image/jpeg;base64,") center / cover no-repeat;
 border-color:#a9d1d6;
 box-shadow:0 12px 36px #386f8e29,0 1px 0 #fff inset;
}
body:not(.cyber) .panelhead strong,
body:not(.cyber) #marbleDock strong{color:#376e81}
body:not(.cyber) .section,
body:not(.cyber) .note,
body:not(.cyber) label{color:#6d909a}
body:not(.cyber) .field label{color:#375b68}
body:not(.cyber) #saveState{color:#658c9a}
body:not(.cyber) .status{background:#eaf7f5bd;color:#507581}
body:not(.cyber) #marbleFlowStatus{background:#e5f6f5d9}
/* Original buttons keep their actual dimensions and typography. The two
   translucent washes and tiny shadows are paint on their existing surfaces. */
body:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle){
 background:#faffff url("data:image/jpeg;base64,") center / cover no-repeat;
 color:#427587;
 border-color:#add3da;
 box-shadow:inset 0 1px 0 #ffffffc7,0 2px 4px #387f961b,
   0 0 0 1px #ffffff52;
}
body:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle):hover:not(:disabled){
 background-color:#e9faf8;
 border-color:#7ab8c3;
 box-shadow:inset 0 1px 0 #fff,0 3px 8px #3e829b30;
}
body:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):not(#cyberToggle):is(.active,.primary){
 color:#176c88;
 background:#d6f2f0 url("data:image/jpeg;base64,") center / cover no-repeat;
 border-color:#62afb8;
 box-shadow:inset 0 1px 1px #fff,0 2px 6px #468ca42f,
   0 0 0 1px #c4e5e7;
}
body:not(.cyber) #cyberToggle{
 background:linear-gradient(135deg,#d8f3f1,#f9fffc);
 color:#2f7f95;border-color:#75bdc7;
 box-shadow:inset 0 1px 1px #ffffffb0,0 2px 7px #3e839a26;
}
body:not(.cyber) #cyberToggle:hover{background:linear-gradient(135deg,#c5edea,#edf9ff)}
body:not(.cyber) #panel .choices button.active,
body:not(.cyber) #marbleDock .marble-mode button.active{
 border-color:#63b4b8;background:#d3f2ee;color:#196f89;
}
body:not(.cyber) input:not([type=color]):not([type=range]):not([type=checkbox]),
body:not(.cyber) select,body:not(.cyber) textarea{
 background:#fcffff;border-color:#b7d7dc;color:#375b68;
}
body:not(.cyber) input[type=color]{background:#faffff;border-color:#b0d3d9}
body:not(.cyber) input[type=range],body:not(.cyber) input[type=checkbox]{accent-color:#4798ac}
body:not(.cyber) .swatch.active i{outline-color:#3e9aaf}
body:not(.cyber) .color-controls .more-colors{
 background:#edf9f9 url("data:image/jpeg;base64,") center / cover no-repeat;
 border-color:#aad0d7;color:#3b798d;
}
body:not(.cyber) .color-chip i,body:not(.cyber) .swatch i{
 filter:none!important;
}
body:not(.cyber) .custom-stamp-row,body:not(.cyber) .work{
 border-color:#bbdce0;
}
body:not(.cyber) #toast{background:#2e6878;color:#fff}
/* The print stylesheet still hides UI and outputs ONLY #printRoot.
   Do not introduce stage decorations into printable or exported content. */

</style><style id="kids-sticker-skin">

/* v4.0 KIDS sticker playground refresh.
   Presentation only. Keep geometry, layout, engine, and interactions intact. */
body.kids:not(.cyber){
  --bg:#edf4ff;--panel:#fbfdff;--line:#c9d7f2;--blue:#87aef7;
  --text:#5b638d;--muted:#7d89b6;background:#f2f6ff;
}
body.kids:not(.cyber) header{
  background:radial-gradient(ellipse 190px 72px at 8% -5%,#fff7cf 0%,transparent 76%),
             radial-gradient(ellipse 190px 75px at 84% 70%,#d7f4ff 0%,transparent 78%),
             linear-gradient(180deg,#fcfdff,#eef5ff);
  border-color:#d4ddf4;box-shadow:inset 0 2px 0 #ffffffd9,0 4px 0 #dae5fb,0 7px 16px #9db4df29;
}
body.kids:not(.cyber) nav{
  background:radial-gradient(ellipse at 20% 12%,#fef4ca,transparent 45%),
             radial-gradient(ellipse at 85% 88%,#d9f5ff,transparent 54%),
             linear-gradient(180deg,#f9fbff,#eef4ff 68%,#eef6fb);
  border-color:#d6dff5;box-shadow:inset -2px 0 0 #fff9,2px 0 11px #9bb7db1f;
}
body.kids:not(.cyber) #bottom{
  background:radial-gradient(ellipse 220px 85px at 4% 0%,#fff8d3,transparent 84%),
             radial-gradient(ellipse 220px 100px at 86% 0%,#dcf7ff,transparent 85%),
             linear-gradient(180deg,#fdfdff,#edf4ff);
  border-color:#d6dff4;box-shadow:inset 0 2px 0 #fff9,0 -4px 0 #dfe8fb;
}
body.kids:not(.cyber) #stage{
  background:
    radial-gradient(circle at 7% 8%,#ffe39bb8 0 17px,transparent 28px),
    radial-gradient(circle at 96% 19%,#f0bfeab0 0 20px,transparent 38px),
    radial-gradient(circle at 14% 87%,#94dde2ad 0 22px,transparent 38px),
    radial-gradient(circle at 92% 87%,#cbc4f6aa 0 21px,transparent 40px),
    linear-gradient(135deg,#dff4ff,#f1e8ff 48%,#fff4d6);
}
body.kids:not(.cyber) #stage::before{
  content:'✦      ✧       ❉';pointer-events:none;position:absolute;z-index:0;
  inset:14px 16px auto;display:block;text-align:center;
  color:#c8b1f0;letter-spacing:2rem;opacity:.4;
  background:none;border:0;box-shadow:none;
}
body.kids:not(.cyber) #stage::after{
  content:'✦        ❉        ✧';pointer-events:none;position:absolute;z-index:0;
  left:0;right:0;bottom:12px;text-align:center;letter-spacing:1.8rem;
  color:#9bcde2;opacity:.34;
}
body.kids:not(.cyber) #stage #view{z-index:1}
body.kids:not(.cyber) #panel,
body.kids:not(.cyber) #marbleDock,
body.kids:not(.cyber) #viewbar,
body.kids:not(.cyber) #context,
body.kids:not(.cyber) dialog,
body.kids:not(.cyber) #headerMoreMenu{
  background:radial-gradient(circle at 90% 4%,#fff4cfde 0,transparent 28%),
             linear-gradient(170deg,#ffffff,#f1f7ff 58%,#f7efff);
  border-color:#d5def5;box-shadow:0 3px 0 #dfebfb,0 10px 24px #95a8d733;
}
body.kids:not(.cyber) #marbleDock{
  background:radial-gradient(circle at 10% 10%,#dff7ff 0,transparent 26%),
             radial-gradient(circle at 88% 12%,#f9f1ff 0,transparent 30%),
             radial-gradient(circle at 90% 88%,#fff5ca 0,transparent 28%),
             linear-gradient(180deg,#ffffff,#f1f7ff 54%,#f7efff);
}
body.kids:not(.cyber) .brand{color:#6e78b2;text-shadow:1px 1px 0 #fff}
body.kids:not(.cyber) .brand small{color:#8790bd}
body.kids:not(.cyber) .panelhead strong,
body.kids:not(.cyber) #marbleDock .marble-top strong{color:#6b6eb0}
body.kids:not(.cyber) #saveState{color:#7d86b0}
body.kids:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip){
  position:relative;isolation:isolate;overflow:hidden;
  border-color:#bcd0ef;color:#6a72a8;
  background:
    radial-gradient(ellipse 64% 35% at 43% 12%,#ffffffdd,transparent 78%),
    linear-gradient(160deg,#fefeff,#edf5ff 72%,#ddeaff);
  box-shadow:inset 0 2px 0 #ffffffdc,inset 0 -2px 0 #d4e3fb80,
             0 3px 0 #cbd8f4,0 5px 7px #94a5cb29;
  text-shadow:none;transition:filter .12s ease,box-shadow .12s ease;
}
body.kids:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):active:not(:disabled){
  box-shadow:inset 0 2px 4px #8f9fd13a,0 1px 0 #c6d5ef;filter:saturate(1.13);
}
body.kids:not(.cyber) :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom,#headerMoreMenu) button:not(.swatch):not(.color-chip):is(.active,.primary){
  background:radial-gradient(ellipse 60% 38% at 44% 13%,#ffffffcf,transparent 80%),
             linear-gradient(155deg,#f5f6ff,#d7e8ff 82%);
  border-color:#99bdf3;color:#5d72ac;
  box-shadow:inset 0 2px 0 #fff8,0 3px 0 #b6cdf6,0 5px 7px #8ca0d73a;
}
body.kids:not(.cyber) nav button:nth-child(4n+1){background:linear-gradient(155deg,#fff8ce,#ffe08b)!important;border-color:#ebca79!important;box-shadow:inset 0 2px 0 #fff9,0 3px 0 #e7c15f!important}
body.kids:not(.cyber) nav button:nth-child(4n+2){background:linear-gradient(155deg,#e7fbff,#bfeeff)!important;border-color:#a5d8ef!important;box-shadow:inset 0 2px 0 #fff9,0 3px 0 #96cae2!important}
body.kids:not(.cyber) nav button:nth-child(4n+3){background:linear-gradient(155deg,#f7ecff,#d8c7ff)!important;border-color:#c4b4f0!important;box-shadow:inset 0 2px 0 #fff9,0 3px 0 #b5a2e5!important}
body.kids:not(.cyber) nav button:nth-child(4n){background:linear-gradient(155deg,#e6f7ff,#c5e7ff)!important;border-color:#a8d3ef!important;box-shadow:inset 0 2px 0 #fff9,0 3px 0 #95c0df!important}
body.kids:not(.cyber) nav button.active{outline:2px solid #84a6f4;outline-offset:-2px}
body.kids:not(.cyber) #cyberToggle{
  background:linear-gradient(155deg,#eef1ff,#d7ecff);border-color:#9ec3ef;color:#5573a6;
  box-shadow:inset 0 2px 0 #fff9,0 3px 0 #a3c7e2;
}
body.kids:not(.cyber) .choices button.active{outline:2px solid #8caef7;outline-offset:-3px}
body.kids:not(.cyber) :is(input,select,textarea){accent-color:#8aaef7}
body.kids:not(.cyber) input:not([type=color]):not([type=range]):not([type=checkbox]),body.kids:not(.cyber) select{
 background:#ffffff;border-color:#d7dff3;color:#606896;
}
body.kids:not(.cyber) #toast{background:#6a74aa;color:#fff}