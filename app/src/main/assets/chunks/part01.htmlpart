<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"><meta name="theme-color" content="#f8fafc"><title>ART STUDIO v4.0 · 나의 작은 작업실</title>
<style>
:root{--bg:#f8fafc;--panel:#fff;--line:#e2e8f0;--blue:#0284c7;--text:#0f172a;--muted:#64748b;--hit:48px}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px system-ui,-apple-system,'Segoe UI',sans-serif;overflow:hidden}button,input,select{font:inherit}button{min-height:var(--hit);min-width:var(--hit);border:1px solid transparent;background:transparent;border-radius:10px;color:inherit;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:8px 12px;touch-action:manipulation}button:hover{background:#f1f5f9}button:active{background:#e0f2fe}button.active,button.primary{background:#e0f2fe;color:#0369a1;border-color:#bae6fd}button.primary{background:var(--blue);color:white}button:disabled{opacity:.35;cursor:default}svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}header{height:64px;display:flex;align-items:center;padding:6px max(10px,env(safe-area-inset-right)) 6px max(12px,env(safe-area-inset-left));background:white;border-bottom:1px solid var(--line);gap:4px;overflow-x:auto;white-space:nowrap}.brand{font-weight:800;letter-spacing:1.5px;font-size:16px}.brand small{font-size:10px;color:var(--muted);font-weight:500;letter-spacing:0;display:block;text-align:left}.divider{height:26px;width:1px;background:var(--line);margin:0 8px;flex-shrink:0}.spacer{flex:1}#saveState{font-size:11px;color:var(--muted);padding:0 10px;white-space:nowrap}#workspace{position:absolute;top:64px;bottom:76px;left:0;right:0;display:flex}nav{width:68px;flex:none;border-right:1px solid var(--line);background:#fff;padding:12px 7px;display:flex;flex-direction:column;align-items:center;gap:6px;overflow-y:auto;z-index:4}nav button{flex-direction:column;gap:3px;font-size:10px;padding:6px;width:52px;min-height:54px}#stage{position:relative;flex:1;overflow:hidden;background:#eaf0f5;touch-action:none;user-select:none}#view{position:absolute;left:0;top:0;touch-action:none}#bottom{position:absolute;bottom:0;left:0;right:0;min-height:76px;padding:10px max(14px,env(safe-area-inset-right)) max(10px,env(safe-area-inset-bottom));background:white;border-top:1px solid var(--line);display:flex;align-items:center;gap:14px;overflow:hidden;white-space:nowrap}.palette{display:flex;align-items:center;gap:2px}.swatch{width:40px;min-width:40px;height:48px;padding:8px}.swatch i{width:24px;height:24px;border-radius:50%;background:var(--c);border:1px solid #0002}.swatch.active i{outline:2px solid var(--blue);outline-offset:3px}input[type=color]{width:44px;height:44px;padding:3px;border:1px solid var(--line);border-radius:10px;background:white}input[type=range]{accent-color:var(--blue);width:110px;min-height:44px}label{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px}select,input[type=number],input[type=text]{background:white;color:var(--text);border:1px solid var(--line);border-radius:8px;padding:10px;min-height:44px;max-width:100%}input[type=checkbox]{width:20px;height:20px;accent-color:var(--blue)}#panel{position:absolute;top:12px;left:80px;width:270px;max-height:calc(100% - 24px);overflow:auto;border:1px solid var(--line);background:#fffffff5;backdrop-filter:blur(12px);border-radius:16px;box-shadow:0 8px 30px #0f172a12;z-index:5;padding:14px}#panel[hidden], [hidden]{display:none!important}.panelhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}.panelhead strong{font-size:15px}.panelhead button{min-width:40px;min-height:40px;padding:8px}.choices{display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.choices button{border:1px solid var(--line);font-size:12px;padding:7px 4px}.field{display:flex;justify-content:space-between;align-items:center;margin:12px 0;gap:8px}.field label{color:var(--text)}.field input[type=range]{width:115px}.note{font-size:12px;line-height:1.65;color:var(--muted);margin:10px 0}.section{font-size:11px;color:var(--muted);margin:18px 0 8px;letter-spacing:.7px}#viewbar{position:absolute;right:16px;bottom:14px;display:flex;background:#fffffff0;border:1px solid var(--line);border-radius:12px;align-items:center;z-index:3;box-shadow:0 2px 10px #00000005}#viewbar button{min-width:44px;padding:7px}#zoomLabel{font-size:12px;min-width:44px;text-align:center}#hint{position:absolute;bottom:20px;left:20px;font-size:11px;color:#64748b;pointer-events:none}#context{position:absolute;display:flex;align-items:center;background:white;box-shadow:0 4px 22px #0002;border:1px solid var(--line);border-radius:12px;padding:4px;z-index:6;max-width:calc(100% - 20px);overflow:auto}#context button{font-size:12px;white-space:nowrap;min-width:44px;padding:7px}body.left #workspace{flex-direction:row-reverse}body.left nav{border-left:1px solid var(--line);border-right:0}body.left #panel{left:auto;right:80px}#toast{position:fixed;left:50%;transform:translateX(-50%);bottom:95px;background:#0f172a;color:white;border-radius:12px;padding:12px 20px;z-index:40;max-width:90vw;font-size:13px;box-shadow:0 4px 20px #0002;pointer-events:none}dialog{border:1px solid var(--line);border-radius:20px;padding:24px;width:min(600px,94vw);max-height:90dvh;box-shadow:0 20px 80px #0f172a30;color:var(--text)}dialog::backdrop{background:#0f172a55;backdrop-filter:blur(3px)}dialog h2{margin:0 0 6px;font-size:22px}dialog .actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px;flex-wrap:wrap}dialog .rows{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:18px 0}dialog .rows label{display:flex;flex-direction:column;align-items:stretch}#marbleCanvas{width:100%;max-height:48vh;object-fit:contain;border-radius:10px;touch-action:none;border:1px solid var(--line);background:white}#printRoot{display:none}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.work{border:1px solid var(--line);border-radius:12px;padding:8px}.work img{width:100%;height:100px;object-fit:contain;background:#f1f5f9}.work strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.work button{font-size:12px}#exportPreview{max-width:100%;max-height:32vh;object-fit:contain;display:block;margin:auto;background:repeating-conic-gradient(#eee 0 25%,white 0 50%) 0/16px 16px;border:1px solid var(--line)}.status{padding:8px;border-radius:8px;background:#f1f5f9;font-size:12px;line-height:1.7}details{margin:10px 0}summary{cursor:pointer;min-height:44px;padding-top:12px;font-weight:600}pre{white-space:pre-wrap;font:12px/1.6 ui-monospace,monospace}.danger{color:#b91c1c}#sizeOut,#alphaOut{min-width:32px;color:var(--text)}@media(max-width:760px){header{height:58px}.brand{font-size:13px}.brand small{display:none}header .label,#saveState{display:none}.divider{margin:0 3px}header button{padding:8px}#workspace{top:58px;bottom:72px}nav{width:60px;padding:8px 4px}nav button{width:50px}#panel{left:68px;width:min(260px,calc(100vw - 82px))}body.left #panel{right:68px}#bottom{min-height:72px;gap:10px;padding:8px}#bottom .palette{gap:0}.swatch{min-width:34px;width:34px;padding:6px}#bottom input[type=range]{width:75px}#hint{display:none}#viewbar{bottom:10px;right:10px}dialog{padding:18px}}@media print{@page{size:A4 portrait;margin:10mm}body{overflow:visible;background:white}body>*{display:none!important}#printRoot{display:flex!important;align-items:center;justify-content:center;width:100%;height:var(--print-height,277mm)}#printRoot img{max-width:100%;max-height:100%;object-fit:contain}}

:root{--rail:calc(var(--hit) + 20px)}nav{width:var(--rail)}nav button{width:calc(var(--hit) + 4px);min-height:calc(var(--hit) + 6px)}#panel{left:calc(var(--rail) + 12px)}body.left #panel{right:calc(var(--rail) + 12px)}.swatch{width:48px;min-width:48px}#bottom .swatch{width:48px;min-width:48px}.panelhead button,#viewbar button,#context button{min-width:48px;min-height:48px}header{overflow-y:hidden}
@media(max-width:760px){:root{--rail:calc(var(--hit) + 12px)}#panel{width:min(260px,calc(100vw - var(--rail) - 24px))}}

/* v1.2 responsive stability: existing regions and order retained. */
header{flex-shrink:0;scrollbar-width:thin}header>button{flex-shrink:0}#projectBtn{flex-shrink:0}.brand{white-space:nowrap}
@media(max-width:480px){header{gap:0;padding:4px 3px;height:58px}header .divider{display:none}header button{min-width:44px;width:44px;padding:6px;border-radius:8px}header #projectBtn{width:122px;min-width:122px;padding:4px;gap:3px}.brand{font-size:12px;letter-spacing:.8px}#workspace{top:58px}#bottom{height:76px;overflow:hidden;flex-wrap:nowrap}#bottom>*{flex-shrink:0}#bottom input[type=range]{width:56px}}
#marbleProgress{font-size:12px;padding:8px;color:#0369a1;background:#e0f2fe;border-radius:8px}#marbleProgress[hidden]{display:none}
/* v1.6: marble controls sit over the drawing canvas, never in a modal. */
#marbleDock{position:absolute;right:12px;top:12px;width:min(465px,calc(100% - 24px));max-height:calc(100% - 24px);overflow-y:auto;z-index:8;background:#fffffff5;border:1px solid #cbd5e1;border-radius:15px;box-shadow:0 8px 28px #0f172a25;padding:10px 12px;overscroll-behavior:contain}
#marbleDock[hidden]{display:none!important}#marbleDock .marble-top{display:flex;align-items:center;gap:5px;flex-wrap:wrap}#marbleDock .marble-top strong{margin-right:auto;font-size:13px}#marbleDock button{min-height:44px;min-width:44px;padding:6px 9px;font-size:12px}#marbleDock .marble-quick{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:6px}#marbleDock .marble-quick label{gap:5px}#marbleDock input[type=color]{width:42px;height:42px}#marbleDock input[type=range]{min-height:36px;width:88px}#marbleDock details{margin:4px 0}#marbleDock summary{font-size:12px;padding:7px 0;min-height:30px}#marbleDock .marble-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}#marbleDock .marble-fields label{display:flex;flex-direction:column;align-items:stretch;gap:4px;font-size:11px}#marbleDock .marble-fields input[type=range]{width:100%}#marbleDock .marble-fields select{min-height:38px;padding:4px}#marbleDock .marble-tools{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}#marbleFlowStatus{margin:5px 0 0!important;font-size:11px!important}#marbleProgress{margin-top:4px}body.marbling header,body.marbling nav,body.marbling #bottom,body.marbling #viewbar{pointer-events:none;opacity:.55}body.marbling #context{display:none!important}body.marbling #bottom{pointer-events:auto;opacity:1}body.marbling #bottom>label,body.marbling #bottom>#optionsBtn{pointer-events:none;opacity:.40}
@media(max-width:480px){#marbleDock{right:6px;top:6px;width:min(340px,calc(100% - 12px));padding:8px}#marbleDock .marble-top{gap:2px}#marbleDock .marble-top button{padding:5px 7px}#marbleDock .marble-quick{gap:4px}}


/* Startup sentinel: normal operation is unaffected; a blocked or failed script is explicit. */
#runtimeAlert{position:absolute;z-index:12;top:45%;left:50%;transform:translate(-50%,-50%);width:min(480px,calc(100vw - 112px));border:1px solid #f59e0b;background:#fffaf0;color:#78350f;border-radius:16px;padding:20px 22px;box-shadow:0 8px 25px #0002;line-height:1.65;font-size:14px;visibility:hidden;animation:runtimeReveal 0s 3s forwards}
#runtimeAlert strong{display:block;font-size:17px;margin-bottom:8px}#runtimeAlert p{margin:5px 0}#runtimeAlert code{font-size:12px;word-break:break-all}
@keyframes runtimeReveal{to{visibility:visible}}
html.art-ready #runtimeAlert{display:none!important}
@media(max-width:550px){#runtimeAlert{width:calc(100vw - 85px);padding:14px;font-size:12px;top:36%}#runtimeAlert strong{font-size:14px}}

/* V1.4 color palette, tool-specific active color state, and full-screen controls. */
.color-controls{display:flex;align-items:center;gap:5px;flex:0 0 auto;min-width:0;transition:filter .15s ease,opacity .15s ease}
.color-controls{display:flex;align-items:center;gap:2px;min-width:0;flex:1 1 auto}.color-controls .palette{min-width:0;overflow:hidden;scrollbar-width:none;display:flex;gap:1px;flex:1 1 auto}
.color-controls .palette .swatch{flex:0 0 48px}.color-controls.compact .palette .swatch{width:40px;min-width:40px}.color-controls .swatch.is-hidden{display:none!important}
.color-controls .more-colors{flex:none;min-width:70px;min-height:48px;border:1px solid #e2e8f0;background:#f1f5f9;font-size:12px;font-weight:650;padding:6px 8px}
.color-controls.is-eraser{filter:grayscale(1);opacity:.40;user-select:none}
.color-controls.is-eraser button,.color-controls.is-eraser input{cursor:not-allowed}
.color-controls.is-eraser .swatch i{outline:0}
.color-sections{max-height:52vh;overflow:auto;padding:2px 4px 8px}
.color-section{margin-bottom:14px}.color-section strong{display:block;font-size:13px;margin-bottom:7px}
.color-grid{display:grid;grid-template-columns:repeat(10,minmax(0,1fr));gap:5px}
.color-grid .color-chip{min-width:0;width:100%;min-height:44px;padding:7px;border:1px solid #e2e8f0}
.color-chip i{display:block;background:var(--c);width:100%;height:29px;border-radius:7px;border:1px solid #0002}
#fullscreenBtn{min-width:48px;min-height:48px}
@media(max-width:760px){.color-grid{grid-template-columns:repeat(6,minmax(0,1fr))}.color-controls .more-colors{min-width:62px;padding:6px;font-size:11px}#bottom input[type=range]{width:68px}#bottom{gap:8px}}
@media(max-width:420px){.color-controls .more-colors{min-width:56px}#bottom{gap:6px;padding:8px}#bottom input[type=range]{width:56px}.swatch{width:34px;min-width:34px;height:44px;padding:5px}.swatch i{width:22px;height:22px}label{gap:6px;font-size:11px}#sizeOut,#alphaOut{min-width:28px;font-size:11px}}
#marbleDock .marble-mode{display:flex;flex-wrap:wrap;gap:4px;align-items:center}
#marbleDock .marble-mode button{border:1px solid #cbd5e1;background:#f8fafc;min-height:44px;white-space:nowrap}
#marbleDock .marble-mode button.active{background:#dbeafe;color:#075985;border-color:#7dd3fc;font-weight:700}
#marbleDock .marble-quick{gap:7px}
#marbleDock .marble-quick label{white-space:nowrap}
@media(max-width:480px){#marbleDock .marble-mode{width:100%}#marbleDock .marble-mode button{flex:1;font-size:11px}}

/* v1.6.7: compact, finger-friendly user stamp management. */
.custom-stamp-list{display:grid;gap:8px;max-height:55dvh;overflow-y:auto}
.custom-stamp-row{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:12px;padding:8px;min-width:0}
.custom-stamp-row img{width:64px;height:64px;object-fit:contain;flex:none;background:#f1f5f9;border-radius:8px}
.custom-stamp-row span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.custom-stamp-row button{flex:none;border:1px solid #fecaca;background:#fff7f7;color:#b91c1c}

/* v1.6.12: restore native finger-swipe to ALL 20 quick colors while fixing other controls in place. */
#bottom{overflow:hidden;min-width:0}
#bottom>.divider,#bottom>label,#bottom>#optionsBtn{flex-shrink:0}
#colorControls{min-width:0;flex:1 1 auto;overflow:hidden}
#colorControls>#color{flex:none}
#colorControls>.more-colors{flex:none}
#colorControls .palette{min-width:0;flex:1 1 0;overflow-x:auto;overflow-y:hidden;
  overscroll-behavior-x:contain;-webkit-overflow-scrolling:touch;
  touch-action:pan-x;scrollbar-width:none;scroll-behavior:auto}
#colorControls .palette::-webkit-scrollbar{display:none}
#colorControls .palette .swatch{flex:0 0 48px;width:48px;min-width:48px;touch-action:pan-x}
#colorControls.compact .palette .swatch{flex-basis:40px;width:40px;min-width:40px}
#colorControls .palette .swatch.is-hidden{display:inline-flex!important}
@media(max-width:560px){
  #bottom{height:124px;min-height:124px;display:grid;
    grid-template-columns:minmax(0,1fr) minmax(0,1fr) 48px;
    grid-template-rows:50px 48px;gap:4px 8px;padding:8px 9px;
    align-content:center;align-items:center}
  #workspace{bottom:124px}
  #colorControls{grid-column:1/-1;grid-row:1;width:100%;min-width:0;overflow:hidden}
  #bottom>.divider{display:none}
  #bottom>label:first-of-type{grid-column:1;grid-row:2}
  #bottom>label:nth-of-type(2){grid-column:2;grid-row:2}
  #bottom>label{min-width:0;gap:4px;justify-content:flex-start;font-size:12px}
  #bottom>label input[type=range]{min-width:24px;flex:1 1 auto;width:30px}
  #sizeOut,#alphaOut{min-width:28px;font-size:11px}
  #bottom>#optionsBtn{grid-column:3;grid-row:2;min-width:44px;width:48px;min-height:48px;padding:7px}
  #colorControls .palette .swatch{flex-basis:40px;width:40px;min-width:40px;height:44px;padding:5px}
  #colorControls>.more-colors{min-width:62px}
}

/* v1.6.15: 두 손가락 지우개 추가. 색칠과 같은 띠 경로를 사용하여 그림·도형·스탬프를 투명하게 지우며 한 번의 작업으로 Undo/Redo. 마스크를 프로젝트에 보존하고 저장/출력에도 적용.\n\nv1.6.14: separate the marbling start action from the effect choices. */
#panelBody #openMarble{margin-top:12px}
#marbleDock #marbleDropSizeRow,#marbleDock #marbleStirSizeRow{gap:6px;min-width:0}
#marbleDock #marbleDropSizeRow output,#marbleDock #marbleStirSizeRow output{min-width:22px;text-align:right;font-size:12px;color:#334155;font-variant-numeric:tabular-nums}
#marbleDock #marbleDropSizeRow[hidden],#marbleDock #marbleStirSizeRow[hidden]{display:none!important}
@media(max-width:480px){#marbleDock #marbleDropSizeRow,#marbleDock #marbleStirSizeRow{flex:1 1 170px}}

/* v1.6.16 — panel header controls: centered pin and equal-size close icon. */
.panelhead{gap:8px;min-height:46px;align-items:center}
.panelhead strong{flex:1 1 auto;min-width:0}
.panelhead-actions{display:flex;flex:0 0 auto;align-items:center;justify-content:flex-end;gap:5px}
.panelhead-actions button{box-sizing:border-box;flex:0 0 44px;width:44px;min-width:44px;max-width:44px;height:44px;min-height:44px;max-height:44px;padding:10px;margin:0;line-height:1;border:1px solid transparent;border-radius:10px;background:transparent;display:inline-flex;align-items:center;justify-content:center}
.panelhead-actions button svg{display:block;width:23px;height:23px;flex-shrink:0;stroke:currentColor;stroke-width:2.1;stroke-linejoin:round;stroke-linecap:round;fill:none;transform:none}
.panelhead-actions button:hover{background:#f1f5f9}
.panelhead-actions button:focus-visible{outline:2px solid #0284c7;outline-offset:2px}
.panelhead-actions #pinBtn.active{background:#e0f2fe;border-color:#bae6fd;color:#0369a1}
.panelhead-actions #closePanel svg{stroke-width:2.4}
</style><style id="cyber-art-studio-skin">
/* CYBER ART STUDIO · visual layer only. No engine/geometry/input modifications.
   Keep actual paper RGB and printed art untouched. Preserve palette swipe and
   all original 48px tap targets. Scope appearance to body.cyber only. */
.cy-neon-title,.cy-art-mark{display:none}
#cyberToggle{flex:none;white-space:nowrap;min-height:48px;min-width:48px;padding:8px 10px;
  border:1px solid #24344a;border-radius:3px;background:#0b1725;color:#fff;font-weight:800;gap:4px}
#cyberToggle .cy-switch-label{font-size:10px;letter-spacing:.05em}
@media(max-width:480px){#cyberToggle{width:44px;min-width:44px;padding:5px}#cyberToggle .cy-switch-label{display:none}}
@media screen{
body.cyber{
  --bg:#03050d;--panel:#080c19;--line:#1d3153;--text:#eaf3ff;--muted:#99add1;--blue:#00e8ff;
  --cyn:#00e8ff;--pnk:#ff2bd1;--grn:#35ff9a;--yel:#ffe600;
  background:#03050d;color:#eaf3ff;color-scheme:dark;
}
html:has(body.cyber){background:#03050d}
body.cyber header,body.cyber nav,body.cyber #bottom{
  background:#060913;color:#eaf3ff;border-color:#203457;
}
body.cyber header{box-shadow:0 1px 0 rgba(0,232,255,.3)}
body.cyber nav{box-shadow:inset -1px 0 rgba(0,232,255,.1)}
body.cyber .divider{background:linear-gradient(180deg,transparent,rgba(0,232,255,.48),transparent)}
body.cyber .cy-std-title{display:none}
body.cyber .cy-neon-title{display:inline;color:#fff;font-weight:900;letter-spacing:.095em;
  text-shadow:0 0 2px #fff,0 0 8px #fff,0 0 14px #00e8ff,0 0 20px rgba(0,232,255,.4)}
body.cyber .cy-neon-title .cy-bad{display:inline-block;animation:cyArtBad 6.7s steps(1,end) infinite}
@keyframes cyArtBad{0%,22%,25%,51%,54%,79%,82%,100%{opacity:1}23%,52%,80%{opacity:.20}23.8%,52.7%,80.6%{opacity:.72}}
body.cyber .brand small{color:#ffb8ed}
body.cyber #saveState{color:#a6bad8}
body.cyber .brand{color:#fff}
body.cyber #stage{
 background:
   radial-gradient(circle at 52% 45%,rgba(0,232,255,.08),transparent 59%),
   linear-gradient(rgba(0,232,255,.05) 1px,transparent 1px) 0 0/30px 30px,
   linear-gradient(90deg,rgba(0,232,255,.05) 1px,transparent 1px) 0 0/30px 30px,
   #040713;
}
/* Drawing remains the original pristine white paper. The logo is an
   independent pointer-transparent visual, never painted into output data. */
body.cyber .cy-art-mark{
 display:flex;position:absolute;left:50%;top:9%;transform:translateX(-50%);
 z-index:2;width:min(58%,520px);min-width:0;max-width:calc(100% - 20px);
 flex-direction:column;align-items:center;justify-content:center;
 pointer-events:none;user-select:none;isolation:isolate;
 opacity:.14;transition:opacity .15s ease,visibility .15s,transform .15s ease;
 filter:drop-shadow(0 0 12px rgba(0,232,255,.10));
}
body.cyber #stage.cy-art-empty .cy-art-mark{
 opacity:.92;
 padding:0;
 background:none;
}
body.cyber #stage.cy-art-working .cy-art-mark{opacity:0;visibility:hidden}
body.cyber .cy-art-logo{width:100%;max-width:520px}
body.cyber .cy-art-logo>svg,body.cyber .cy-art-logo>img{display:block;width:100%;height:auto;overflow:visible}
body.cyber .cy-art-sub{display:block;max-width:100%;text-align:center;
  white-space:normal;font-size:clamp(7px,1vw,11px);font-weight:900;letter-spacing:.20em;
  color:#ddfaff;opacity:.84;text-shadow:0 0 2px white,0 0 11px rgba(0,232,255,.75)}
body.cyber #stage.cy-art-empty .cy-art-logo>img{animation:cyArtLogoHum 6.5s ease-in-out infinite;opacity:.94}
@keyframes cyArtLogoHum{0%,100%{opacity:.88}50%,70%{opacity:1}71%{opacity:.65}72%{opacity:1}}
body.cyber #panel,body.cyber #marbleDock,body.cyber #context,
body.cyber #viewbar,body.cyber dialog{
 background:#080d1aed;color:#eaf3ff;border-color:#28466c;
 box-shadow:0 0 0 1px rgba(0,232,255,.07),0 12px 26px rgba(0,0,0,.37);
 backdrop-filter:none;
}
body.cyber #panel,body.cyber #marbleDock{background-image:
 linear-gradient(rgba(0,232,255,.022) 1px,transparent 1px),
 linear-gradient(90deg,rgba(255,43,209,.016) 1px,transparent 1px);
 background-size:34px 34px;
}
body.cyber #panel::before,body.cyber #marbleDock::before{
 content:'';position:absolute;left:-1px;top:-1px;width:17px;height:17px;
 border-left:2px solid #00e8ff;border-top:2px solid #00e8ff;
 box-shadow:-2px -2px 8px rgba(0,232,255,.18);pointer-events:none;
}
body.cyber #panel::after,body.cyber #marbleDock::after{
 content:'';position:absolute;right:-1px;bottom:-1px;width:16px;height:16px;
 border-right:2px solid #ff2bd1;border-bottom:2px solid #ff2bd1;
 pointer-events:none;
}
body.cyber .panelhead strong,body.cyber #marbleDock strong{
 color:#f2fdff;text-shadow:0 0 9px rgba(0,232,255,.35)}
body.cyber .section,body.cyber .note,body.cyber label,body.cyber .status{color:#acc0db}
body.cyber .field label{color:#e3f1ff}
body.cyber #hint{color:#7fa8c5}
body.cyber #sizeOut,body.cyber #alphaOut,body.cyber #zoomLabel{color:#dffaff}
body.cyber .status{background:#091322;color:#d1eaff}
body.cyber #marbleFlowStatus{background:#071625;color:#dcefff}
body.cyber #marbleProgress{position:relative;overflow:hidden;background:linear-gradient(180deg,#081321,#0a1b2d);color:#eafcff;border:1px solid #00e8ff;border-radius:12px;min-height:36px;padding:9px 12px;box-shadow:0 0 0 1px rgba(0,232,255,.10),0 0 18px rgba(0,232,255,.14),inset 0 0 12px rgba(0,232,255,.08)}
body.cyber #marbleProgress::before{content:'';position:absolute;inset:0;width:var(--cy-progress,22%);background:linear-gradient(90deg,rgba(0,232,255,.16),rgba(0,232,255,.38) 50%,rgba(255,43,209,.20));box-shadow:0 0 20px rgba(0,232,255,.22);pointer-events:none;transition:width .18s linear}
body.cyber #marbleProgress::after{content:'';position:absolute;top:3px;bottom:3px;left:calc(var(--cy-progress,22%) - 16px);width:30px;border-radius:10px;background:radial-gradient(circle at 50% 50%,rgba(255,255,255,.95),rgba(0,232,255,.78) 35%,rgba(0,232,255,0) 70%);box-shadow:0 0 10px rgba(255,255,255,.85),0 0 18px rgba(0,232,255,.65),0 0 26px rgba(255,43,209,.28);opacity:var(--cy-bar-active,0);pointer-events:none}
body.cyber .custom-stamp-row,body.cyber .work{border-color:#273e62}
body.cyber .custom-stamp-row img,body.cyber .work img{background:#f1f5f9} /* true artwork thumbs */
body.cyber input:not([type=color]):not([type=range]):not([type=checkbox]),body.cyber select,body.cyber textarea{
 background:#050b18;color:#edf8ff;border:1px solid #314b72;
}
body.cyber input:focus,body.cyber select:focus,body.cyber textarea:focus{