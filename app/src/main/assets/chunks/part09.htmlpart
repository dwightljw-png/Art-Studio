}
function buildDecal(scale=1){
 // Preview runs at reduced resolution while moving the fold; final always uses full document resolution.
 const w=Math.max(1,Math.round(doc.w*scale)),h=Math.max(1,Math.round(doc.h*scale));
 const sx=w/doc.w,sy=h/doc.h,aa={x:axis.a.x*sx,y:axis.a.y*sy},bb={x:axis.b.x*sx,y:axis.b.y*sy};
 const input=canvas(w,h),ig=input.getContext('2d',{willReadFrequently:true});ig.drawImage(board,0,0,w,h);
 const fold=canvas(w,h),fg=fold.getContext('2d',{willReadFrequently:true});fg.setTransform(...reflectionMatrix(aa,bb));fg.drawImage(input,0,0);fg.resetTransform();
 const base=ig.getImageData(0,0,w,h),other=fg.getImageData(0,0,w,h),a=base.data,b=other.data;
 // Equal, bilateral pigment contact: whichever half the paint started on has the same priority.
 for(let k=0;k<a.length;k+=4){const pa=a[k+3]/255,pb=b[k+3]/255;if(!pb)continue;
  if(pa){const sum=pa+pb;for(let c=0;c<3;c++)a[k+c]=(a[k+c]*pa+b[k+c]*pb)/sum}
  else for(let c=0;c<3;c++)a[k+c]=b[k+c];
  a[k+3]=255*(pa+pb-pa*pb);
 }
 const n=foldNormal(aa,bb),m={x:(aa.x+bb.x)/2,y:(aa.y+bb.y)/2};
 const half=canvas(w,h);half.getContext('2d').putImageData(decalPressPixels(base,w,h,settings.press,settings.spread,n,m,Math.min(sx,sy)),0,0);
 const result=canvas(w,h),g=result.getContext('2d');g.drawImage(half,0,0);g.setTransform(...reflectionMatrix(aa,bb));g.drawImage(half,0,0);g.resetTransform();
 input.width=input.height=1;fold.width=fold.height=1;half.width=half.height=1;
 return result;
}
function decalPreviewScale(){return Math.min(1,460/Math.max(doc.w,doc.h))}

let reflectionSource=null;
function buildReflection(draft=false){if(!axis||Math.hypot(axis.b.x-axis.a.x,axis.b.y-axis.a.y)<2)return;if(settings.effect==='decal'){reflectionSource=null;preview=buildDecal(draft?decalPreviewScale():1);paint();return;}const c=canvas(doc.w,doc.h),g=c.getContext('2d'),n=axisNormal(),m=axisMid(),dx=axis.b.x-axis.a.x,dy=axis.b.y-axis.a.y,l=Math.hypot(dx,dy),u={x:dx/l,y:dy/l},far=Math.max(doc.w,doc.h)*6,sgn=-axis.dir;g.beginPath();g.moveTo(m.x-u.x*far,m.y-u.y*far);g.lineTo(m.x+u.x*far,m.y+u.y*far);g.lineTo(m.x+u.x*far+n.x*far*sgn,m.y+u.y*far+n.y*far*sgn);g.lineTo(m.x-u.x*far+n.x*far*sgn,m.y-u.y*far+n.y*far*sgn);g.closePath();g.clip();g.drawImage(board,0,0);reflectionSource=c;preview=canvas(doc.w,doc.h);const pg=preview.getContext('2d');pg.transform(...reflectionMatrix(axis.a,axis.b));pg.drawImage(c,0,0);paint()}
async function applyReflection(){if(!preview)return;if(settings.effect==='decal')preview=buildDecal(1);checkpoint();const out=canvas(doc.w,doc.h),g=out.getContext('2d');if(settings.effect!=='decal')g.drawImage(board,0,0);if(settings.effect==='mirror'){g.globalCompositeOperation='destination-out';g.drawImage(reflectionSource,0,0);g.globalCompositeOperation='source-over'}g.drawImage(preview,0,0);await replaceWithCanvas(out);cancelEffect();changed()}
function cancelEffect(){axis=null;preview=null;reflectionSource=null;paint()}
function tilePath(g,x,y,size,type,angle=0,seed=1){g.save();g.translate(x,y);g.rotate(angle*Math.PI/180);g.beginPath();const r=size/2;if(type==='circle')g.arc(0,0,r,0,Math.PI*2);else if(type==='triangle'){g.moveTo(0,-r);g.lineTo(r,r);g.lineTo(-r,r);g.closePath()}else if(type==='paper'){for(let i=0;i<7;i++){const a=i*Math.PI*2/7,rr=r*(.7+.3*seeded(seed+i));g[i?'lineTo':'moveTo'](Math.cos(a)*rr,Math.sin(a)*rr)}g.closePath()}else g.rect(-r,-r,size,size);g.fill();g.restore()}
function addTile(p){const n=settings.tileSize,c=canvas(n*1.5,n*1.5),g=c.getContext('2d');g.fillStyle=settings.color;tilePath(g,c.width/2,c.height/2,Math.max(1,n-settings.gap),settings.tile,settings.tileAngle,Date.now());const src=c.toDataURL();assets.set(src,c);doc.objects.push({id:uid(),kind:'image',src,x:p.x,y:p.y,w:c.width,h:c.height,alpha:settings.alpha});render()}
function mosaicPalette(samples,k){if(!samples.length)return[[255,255,255]];const sorted=[...samples].sort((a,b)=>a.reduce((x,y)=>x+y)-b.reduce((x,y)=>x+y));let centers=Array.from({length:Math.min(k,sorted.length)},(_,i)=>sorted[Math.floor(i*(sorted.length-1)/Math.max(1,k-1))].slice());for(let t=0;t<7;t++){const sums=centers.map(()=>[0,0,0,0]);for(const p of samples){let best=0,d=Infinity;centers.forEach((q,i)=>{const n=p.reduce((s,v,j)=>s+(v-q[j])**2,0);if(n<d){best=i;d=n}});p.forEach((v,j)=>sums[best][j]+=v);sums[best][3]++}centers=centers.map((c,i)=>sums[i][3]?sums[i].slice(0,3).map(v=>v/sums[i][3]):c)}return centers}
function mosaicPreview(){const source=exportCanvas(true),src=source.getContext('2d').getImageData(0,0,doc.w,doc.h).data,c=canvas(doc.w,doc.h),g=c.getContext('2d'),n=settings.tileSize;let rect={x:0,y:0,w:doc.w,h:doc.h};const o=objectById();if(o)rect={x:Math.max(0,o.x-o.w/2),y:Math.max(0,o.y-o.h/2),w:o.w,h:o.h};const tiles=[];for(let y=rect.y;y<Math.min(doc.h,rect.y+rect.h);y+=n)for(let x=rect.x;x<Math.min(doc.w,rect.x+rect.w);x+=n){let sums=[0,0,0],count=0;for(let yy=y;yy<Math.min(doc.h,y+n);yy+=Math.max(1,n/4))for(let xx=x;xx<Math.min(doc.w,x+n);xx+=Math.max(1,n/4)){const k=(Math.floor(yy)*doc.w+Math.floor(xx))*4;for(let ch=0;ch<3;ch++)sums[ch]+=src[k+ch];count++}tiles.push({x,y,rgb:sums.map(v=>v/count)})}const sample=tiles.filter((_,i)=>i%Math.max(1,Math.ceil(tiles.length/3000))===0).map(t=>t.rgb),colors=mosaicPalette(sample,settings.tileColors);g.drawImage(board,0,0);g.clearRect(rect.x,rect.y,rect.w,rect.h);g.save();g.beginPath();g.rect(rect.x,rect.y,rect.w,rect.h);g.clip();for(const t of tiles){let best=colors[0],dist=Infinity;for(const c of colors){const d=c.reduce((s,v,i)=>s+(v-t.rgb[i])**2,0);if(d<dist){dist=d;best=c}}g.fillStyle=`rgb(${best.map(Math.round).join(',')})`;tilePath(g,t.x+n/2,t.y+n/2,Math.max(1,n-settings.gap),settings.tile,settings.tileAngle,t.x+t.y)}g.restore();preview=c;axis=null;$('panel').hidden=true;paint()}
/* Deferred marbling replay: pure, dependency-free worker body. Logical space stays 320×220. */
function marbleWorkerMain(){
 function mapOp(o,x,y){
  if(o.type==='drop'){const dx=x-o.x,dy=y-o.y,d=Math.hypot(dx,dy);if(d<1)return[x,y];const v=Math.sqrt(Math.max(0,d*d-o.r*o.r))/d;return[o.x+dx*v,o.y+dy*v]}
  if(o.type==='stir'){const r=o.r||Math.sqrt(1200),d=(x-o.x)**2+(y-o.y)**2,k=Math.exp(-d/(r*r))*.85;return[x-o.dx*k,y-o.dy*k]}
  if(o.type==='flow'){const steps=o.steps||1,dx=o.tx*.035*o.str*steps,dy=o.ty*.035*o.str*steps,eddy=o.str*steps*.013;return[x-dx-Math.sin(y*.04+o.t+Math.sin(x*.017))*eddy*Math.abs(o.tx),y-dy-Math.sin(x*.04-o.t+Math.sin(y*.015))*eddy*Math.abs(o.ty)];}
  return[x+Math.sin(y*.12+o.t)*o.strength,y+Math.sin(x*.09-o.t)*o.strength*.65];
 }
 async function replay(data,post,yieldRows){const{ops,w,h,base}=data;let a=new Uint8ClampedArray(w*h*4),b=new Uint8ClampedArray(a.length);const sx=w/320,sy=h/220;
   if(base?.buffer){
    const raw=new Uint8ClampedArray(base.buffer),bw=base.w,bh=base.h;
    if(bw===w&&bh===h){a.set(raw)}
    else {for(let y=0;y<h;y++)for(let x=0;x<w;x++){
      const bx=Math.min(bw-1,Math.max(0,(x+.5)*bw/w-.5)),by=Math.min(bh-1,Math.max(0,(y+.5)*bh/h-.5));
      const xx=Math.floor(bx),yy=Math.floor(by),xr=Math.min(bw-1,xx+1),yr=Math.min(bh-1,yy+1),fx=bx-xx,fy=by-yy;
      const i=(y*w+x)*4,j=(yy*bw+xx)*4,k=(yy*bw+xr)*4,l=(yr*bw+xx)*4,n=(yr*bw+xr)*4;
      for(let ch=0;ch<4;ch++)a[i+ch]=raw[j+ch]*(1-fx)*(1-fy)+raw[k+ch]*fx*(1-fy)+raw[l+ch]*(1-fx)*fy+raw[n+ch]*fx*fy;
    }}
   }else a.fill(255);
  for(let n=0;n<ops.length;n++){const o=ops[n];for(let y=0;y<h;y++){for(let x=0;x<w;x++){const q=mapOp(o,x/sx,y/sy),xx=Math.max(0,Math.min(w-1,q[0]*sx)),yy=Math.max(0,Math.min(h-1,q[1]*sy)),x0=Math.floor(xx),y0=Math.floor(yy),x1=Math.min(w-1,x0+1),y1=Math.min(h-1,y0+1),fx=xx-x0,fy=yy-y0,k=(y*w+x)*4,i00=(y0*w+x0)*4,i10=(y0*w+x1)*4,i01=(y1*w+x0)*4,i11=(y1*w+x1)*4;
   const near=(Math.round(yy)*w+Math.round(xx))*4;
   const contrast=Math.max(Math.abs(a[i00]-a[i11]),Math.abs(a[i00+1]-a[i11+1]),Math.abs(a[i00+2]-a[i11+2]),Math.abs(a[i10]-a[i01]),Math.abs(a[i10+1]-a[i01+1]),Math.abs(a[i10+2]-a[i01+2]));
   for(let ch=0;ch<3;ch++){const bilinear=a[i00+ch]*(1-fx)*(1-fy)+a[i10+ch]*fx*(1-fy)+a[i01+ch]*(1-fx)*fy+a[i11+ch]*fx*fy;b[k+ch]=contrast>38?a[near+ch]*.68+bilinear*.32:bilinear}b[k+3]=255;
   if(o.type==='drop'){const d=Math.hypot(x/sx-o.x,y/sy-o.y),cover=Math.max(0,Math.min(1,(o.r-d)*sx+.5));for(let ch=0;ch<3;ch++)b[k+ch]=o.rgb[ch]*cover+b[k+ch]*(1-cover)}
  }if(yieldRows&&y%24===0)await yieldRows();}const tmp=a;a=b;b=tmp;post({progress:Math.round((n+1)/ops.length*100)});}
  return{buffer:a.buffer,w,h};
 }
 if(typeof self!=='undefined'&&typeof document==='undefined')self.onmessage=async e=>{try{const r=await replay(e.data,v=>self.postMessage(v));self.postMessage(r,[r.buffer])}catch(e){self.postMessage({error:e.message})}};
 return{mapOp,replay};
}
const marbleReplay=marbleWorkerMain();
let marbleWorker=null,marbleWorkerURL=null,marbleCancelToken=0,marbleReject=null;
function releaseMarbleWorker(){marbleCancelToken++;if(marbleReject){const reject=marbleReject;marbleReject=null;reject(Error('렌더링 취소'))}if(marbleWorker)marbleWorker.terminate();marbleWorker=null;if(marbleWorkerURL)URL.revokeObjectURL(marbleWorkerURL);marbleWorkerURL=null}
async function marbleRenderOutput(){if(!marble)throw Error('마블링 작업실이 닫혔습니다');const m=marble;
  m.rendering=true;
  if(m.compacting)await m.compacting;
  if(m!==marble)throw Error('마블링 작업실이 닫혔습니다');
  const quality=$('marbleQuality').value,w=quality==='auto'?Math.min(1600,Math.max(640,Math.round(doc.w*.8))):+quality,h=Math.round(w*220/320),ops=m.ops.map(o=>({...o}));
  if(!ops.length&&!m.snapshot){m.rendering=false;return m.c}
 const token=++marbleCancelToken;$('marbleProgress').hidden=false;$('marbleApply').disabled=true;$('marbleStamp').disabled=true;
 const progress=v=>{if($('marbleProgress'))$('marbleProgress').textContent=`고해상도 렌더링 ${v.progress}% · ${w} × ${h}px`};
 const payload={ops,w,h,base:m.snapshot||null};let result;
 try{if(typeof Worker==='function'){try{marbleWorkerURL=URL.createObjectURL(new Blob(['('+marbleWorkerMain.toString()+')()'],{type:'text/javascript'}));marbleWorker=new Worker(marbleWorkerURL);result=await new Promise((resolve,reject)=>{marbleReject=reject;marbleWorker.onmessage=e=>{if(e.data.error)reject(Error(e.data.error));else if(e.data.buffer)resolve(e.data);else progress(e.data)};marbleWorker.onerror=e=>reject(Error(e.message||'Worker 실행 불가'));marbleWorker.postMessage(payload)})}catch(e){if(token!==marbleCancelToken)throw Error('렌더링 취소');if(marbleWorker)marbleWorker.terminate();marbleWorker=null;result=await marbleReplay.replay(payload,progress,async()=>{await new Promise(r=>setTimeout(r,0));if(token!==marbleCancelToken)throw Error('렌더링 취소')})}}
 else result=await marbleReplay.replay(payload,progress,async()=>{await new Promise(r=>setTimeout(r,0));if(token!==marbleCancelToken)throw Error('렌더링 취소')});
 if(token!==marbleCancelToken||marble!==m)throw Error('렌더링 취소');const c=canvas(result.w,result.h);c.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(result.buffer),result.w,result.h),0,0);return c;
 }finally{if(marble===m){m.rendering=false;if($('marbleApply'))$('marbleApply').disabled=false;if($('marbleStamp'))$('marbleStamp').disabled=false}if(token===marbleCancelToken){marbleReject=null;if(marbleWorker)marbleWorker.terminate();marbleWorker=null;if(marbleWorkerURL)URL.revokeObjectURL(marbleWorkerURL);marbleWorkerURL=null}}
}
// Snapshot long marbling sessions, preserving the rendered pigment instead of dropping steps.
// A quality-matched checkpoint plus a short replay tail prevents unbounded operation logs.
const MARBLE_COMPACT_AT=160;
function marbleCheckpointWidth(){const quality=$('marbleQuality').value;return quality==='auto'?Math.min(1600,Math.max(640,Math.round(doc.w*.8))):+quality}
function compactMarbleIfNeeded(){
 const m=marble;
 if(!m||m.rendering||m.compacting||m.ops.length<MARBLE_COMPACT_AT)return;
 if(m.compactFailureAt&&Date.now()-m.compactFailureAt<60000)return;
 const count=m.ops.length,ops=m.ops.slice(0,count).map(o=>({...o}));
 const w=marbleCheckpointWidth(),h=Math.round(w*220/320),base=m.snapshot||null;
 m.compacting=(async()=>{
  let worker=null,url=null,result=null;
  try{
   const payload={ops,w,h,base};
   if(typeof Worker==='function'){
    try{
     url=URL.createObjectURL(new Blob(['('+marbleWorkerMain.toString()+')()'],{type:'text/javascript'}));
     worker=new Worker(url);m.compactWorker=worker;
     result=await new Promise((resolve,reject)=>{
      worker.onmessage=e=>{if(e.data.error)reject(Error(e.data.error));else if(e.data.buffer)resolve(e.data)};
      worker.onerror=e=>reject(Error(e.message||'마블링 압축 실패'));
      m.compactAbort=reject;worker.postMessage(payload);
     });
    }catch(e){
     if(marble!==m)throw e;
     // File viewers may prohibit blob workers; preserve compaction with cooperative yielding.
     if(worker)worker.terminate();worker=null;m.compactWorker=null;m.compactAbort=null;
     result=await marbleReplay.replay(payload,()=>{},async()=>{await new Promise(r=>setTimeout(r,0));if(marble!==m)throw Error('취소')});
    }
   }else{
    result=await marbleReplay.replay(payload,()=>{},async()=>{await new Promise(r=>setTimeout(r,0));if(marble!==m)throw Error('취소')});
   }
   if(marble!==m)return;
   m.snapshot={w:result.w,h:result.h,buffer:result.buffer};m.compactFailureAt=0;
   m.ops.splice(0,count);
   m.checkpoints=(m.checkpoints||0)+1;
  }catch(e){if(marble===m){m.compactFailureAt=Date.now();console.warn('마블링 이력 압축 실패 · 기존 기록 유지',e)}}
  finally{
   if(worker)worker.terminate();if(url)URL.revokeObjectURL(url);
   if(m.compactWorker===worker)m.compactWorker=null;m.compactAbort=null;
  }
 })().finally(()=>{m.compacting=null;if(marble===m&&!m.rendering&&!m.compactFailureAt&&m.ops.length>=MARBLE_COMPACT_AT)setTimeout(compactMarbleIfNeeded,0)});
}
function marbleWarp(o){
 if(!marble||marble.rendering)return;
 const last=marble.ops.at(-1);
 if(o.type==='flow'&&last?.type==='flow'&&(last.steps||1)<5&&
  Math.abs(o.tx-last.tx)<.35&&Math.abs(o.ty-last.ty)<.35&&Math.abs(o.str-last.str)<.015){
  // Keep roughly identical velocity fields in a bounded replay operation.
  const k=last.steps||1;last.tx=(last.tx*k+o.tx)/(k+1);last.ty=(last.ty*k+o.ty)/(k+1);
  last.str=(last.str*k+o.str)/(k+1);last.t=(last.t*k+o.t)/(k+1);last.steps=k+1;
  }else marble.ops.push(o);
  marbleAdvect((x,y)=>{const p=marbleReplay.mapOp(o,x,y);return{x:p[0],y:p[1]}});
  if(marble.ops.length>=MARBLE_COMPACT_AT)compactMarbleIfNeeded();
  paint();
}

let marble=null,marbleRAF=0,sensorEnabled=false;
/* Live marble mode: same canvas, temporary worker buffer; commit exactly once. */
let marblePointerId=null,marblePriorTool='draw';
function marbleCanvasPoint(e){const r=stage.getBoundingClientRect();const p=toDoc(e.clientX-r.left,e.clientY-r.top);return {x:clamp(p.x/doc.w*320,0,320),y:clamp(p.y/doc.h*220,0,220),inside:inPaper(p)}}
function marblePointerStart(e){if(!marble||marble.rendering||marblePointerId!==null)return;const p=marbleCanvasPoint(e);if(!p.inside)return;if(e.pointerType==='touch'&&marble.down)return;e.preventDefault();view.setPointerCapture(e.pointerId);marblePointerId=e.pointerId;marble.down=true;marble.last=p;if(marble.mode==='drop')marbleDrop(p);paint()}
function marblePointerMove(e){if(!marble||!marble.down||marblePointerId!==e.pointerId||marble.rendering)return;e.preventDefault();const p=marbleCanvasPoint(e),a=marble.last;if(!a)return;const dist=Math.hypot(p.x-a.x,p.y-a.y);if(dist>.04){if(marble.mode==='stir')marbleWarp({type:'stir',x:p.x,y:p.y,dx:p.x-a.x,dy:p.y-a.y,r:+$('stirSize').value});marble.last=p;paint()}}
function marblePointerEnd(e){if(marblePointerId!==e.pointerId)return;marblePointerId=null;if(marble){marble.down=false;marble.last=null}paint()}
function openMarble(){if(marble){$('marbleDock').hidden=false;return}if($('modal').open){toast('열려 있는 창을 닫은 뒤 마블링을 시작하세요');return}if(pointerMap.size||live||drag){toast('현재 작업을 마친 뒤 시작하세요');return}
 cancelEffect();selected=null;const c=$('marbleCanvas'),g=c.getContext('2d',{willReadFrequently:true});c.width=480;c.height=330;g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);
 marble={c,g,last:null,down:false,tx:0,ty:0,vx:0,vy:0,t:0,lastTime:0,ops:[],snapshot:null,checkpoints:0,compacting:null,compactWorker:null,compactAbort:null,compactFailureAt:0,pixels:null,spare:null,slowFrames:0,rendering:false,mode:'drop'};marblePointerId=null;
 $('marbleDock').hidden=false;$('marbleDropSizeRow').hidden=false;$('marbleStirSizeRow').hidden=true;$('marbleDropMode').classList.add('active');$('marbleStirMode').classList.remove('active');$('marbleDropMode').setAttribute('aria-pressed','true');$('marbleStirMode').setAttribute('aria-pressed','false');document.body.classList.add('marbling');$('panel').hidden=true;$('marbleProgress').hidden=true;$('marbleFlowStatus').textContent='물감 방울을 떨어뜨린 뒤, 휘젓기를 선택해 무늬를 늘려보세요.';
 updateColorControls();marbleRAF=requestAnimationFrame(marbleTick);paint();}
function closeMarbleSession(){stopMarble();$('marbleDock').hidden=true;document.body.classList.remove('marbling');if(tool==='effects'){settings.effect='marble';setTool('draw');$('panel').hidden=true}updateColorControls();paint()}
$('marbleCancel').onclick=()=>{if(marble?.rendering)releaseMarbleWorker();closeMarbleSession()};
$('marbleClear').onclick=()=>{if(!marble||marble.rendering)return;const{c,g}=marble;g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height);marble.ops=[];marble.snapshot=null;marble.checkpoints=0;marble.pixels=null;marble.spare=null;marble.vx=0;marble.vy=0;paint()};
$('marbleStamp').onclick=async()=>{if(!marble)return;try{const output=await marbleRenderOutput();await registerStamp(output);toast('마블링 소재를 등록했습니다')}catch(e){toast(e.message)}};
$('marbleApply').onclick=async()=>{if(!marble)return;try{const m=marble,output=await marbleRenderOutput();if(m!==marble)return;checkpoint();const src=output.toDataURL();assets.set(src,output);doc.objects.push({id:uid(),kind:'image',src,x:doc.w/2,y:doc.h/2,w:doc.w,h:doc.h});closeMarbleSession();changed()}catch(e){toast('마블링 적용 실패: '+e.message)}};
function setMarbleMode(mode){if(!marble)return;marble.mode=mode;marble.down=false;marble.last=null;marblePointerId=null;$('marbleDropMode').classList.toggle('active',mode==='drop');$('marbleStirMode').classList.toggle('active',mode==='stir');$('marbleDropMode').setAttribute('aria-pressed',String(mode==='drop'));$('marbleStirMode').setAttribute('aria-pressed',String(mode==='stir'));$('marbleDropSizeRow').hidden=mode!=='drop';$('marbleStirSizeRow').hidden=mode!=='stir';$('marbleFlowStatus').textContent=mode==='drop'?'물감 방울을 떨어뜨리세요. 방울을 겹쳐 놓으면 이전 색을 밀어냅니다.':'휘젓기 굵기를 조절한 다음 물감 경계를 끌어 무늬를 만드세요. 값이 작을수록 가늘게 휘저어집니다.'}
$('marbleDropMode').onclick=()=>setMarbleMode('drop');$('marbleStirMode').onclick=()=>setMarbleMode('stir');
$('dropSize').addEventListener('input',()=>{$('dropSizeValue').textContent=$('dropSize').value});
$('stirSize').addEventListener('input',()=>{$('stirSizeValue').textContent=$('stirSize').value});
$('sensorBtn').onclick=toggleSensor;$('shakeBtn').onclick=toggleShake;$('manualWave').onclick=()=>marbleWave(9);
function marbleDrop(p){if(!marble||marble.rendering)return;const r=+$('dropSize').value,color=settings.color,rgb=color.match(/\w\w/g).map(v=>parseInt(v,16));marbleWarp({type:'drop',x:p.x,y:p.y,r,rgb});const{c,g}=marble;g.save();g.scale(c.width/320,c.height/220);g.fillStyle=color;g.beginPath();g.arc(p.x,p.y,r,0,Math.PI*2);g.fill();g.restore();marble.pixels=g.getImageData(0,0,c.width,c.height);paint()}
function marbleAdvect(map){
 if(!marble)return;
 const begun=performance.now(),{c,g}=marble,w=c.width,h=c.height,sx=w/320,sy=h/220;
 if(!marble.pixels)marble.pixels=g.getImageData(0,0,w,h);
 if(!marble.spare)marble.spare=g.createImageData(w,h);
 const a=marble.pixels.data,b=marble.spare.data;
 for(let y=0;y<h;y++)for(let x=0;x<w;x++){
  const p=map(x/sx,y/sy),xx=clamp(p.x*sx,0,w-1),yy=clamp(p.y*sy,0,h-1),x0=Math.floor(xx),y0=Math.floor(yy),x1=Math.min(w-1,x0+1),y1=Math.min(h-1,y0+1),fx=xx-x0,fy=yy-y0,k=(y*w+x)*4;
  const a00=(y0*w+x0)*4,a10=(y0*w+x1)*4,a01=(y1*w+x0)*4,a11=(y1*w+x1)*4;
  // A sharp paint boundary follows the nearest pigment, instead of mixing with white every animation frame.
  const near=(Math.round(yy)*w+Math.round(xx))*4;
  const difference=Math.max(Math.abs(a[a00]-a[a11]),Math.abs(a[a00+1]-a[a11+1]),Math.abs(a[a00+2]-a[a11+2]),Math.abs(a[a10]-a[a01]),Math.abs(a[a10+1]-a[a01+1]),Math.abs(a[a10+2]-a[a01+2]));
  const edge=difference>38;
  for(let ch=0;ch<3;ch++){
   const bilinear=a[a00+ch]*(1-fx)*(1-fy)+a[a10+ch]*fx*(1-fy)+a[a01+ch]*(1-fx)*fy+a[a11+ch]*fx*fy;
   b[k+ch]=edge?a[near+ch]*.68+bilinear*.32:bilinear;
  }b[k+3]=255;
 }
 g.putImageData(marble.spare,0,0);
 [marble.pixels,marble.spare]=[marble.spare,marble.pixels];
 if(performance.now()-begun>35)marble.slowFrames++;else marble.slowFrames=Math.max(0,marble.slowFrames-1);
 if(marble.slowFrames>=5&&w>320){const tmp=canvas(320,220);tmp.getContext('2d').drawImage(c,0,0,320,220);c.width=320;c.height=220;g.drawImage(tmp,0,0);marble.pixels=null;marble.spare=null;marble.slowFrames=0;toast('태블릿 성능에 맞춰 미리보기를 조정했습니다. 최종 출력 해상도는 유지됩니다.')}
}