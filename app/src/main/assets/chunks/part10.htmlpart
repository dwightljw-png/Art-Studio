function marbleTick(t){
 if(!marble)return;
 if(marble.rendering){marbleRAF=requestAnimationFrame(marbleTick);return}
 if(t-marble.lastTime>55){
  const m=marble,dt=m.lastTime?clamp((t-m.lastTime)/55,.5,2):1;m.lastTime=t;m.t+=.06*dt;
  const tx=sensorEnabled?m.tx:+$('tiltX').value,ty=sensorEnabled?m.ty:+$('tiltY').value;
  const viscosity=+$('viscosity').value/100,str=+$('flow').value/100*(1-viscosity*.72);
  // Inertia: quick changes accelerate water gradually, level tablet damps flow.
  const response=1-Math.exp(-dt*(.32-viscosity*.17));
  m.vx+=((tx-m.vx)*response);m.vy+=((ty-m.vy)*response);
  if(Math.abs(tx)<.2&&Math.abs(m.vx)<.15)m.vx=0;
  if(Math.abs(ty)<.2&&Math.abs(m.vy)<.15)m.vy=0;
  if(Math.abs(m.vx)+Math.abs(m.vy)>.22)marbleWarp({type:'flow',tx:m.vx,ty:m.vy,str,t:m.t});
  const el=$('marbleFlowStatus');if(el)el.textContent=`흐름 ${Math.round(Math.hypot(m.vx,m.vy)*str*3)}% · 기울기 ${sensorEnabled?'센서':'수동'} · 기록 ${m.ops.length}개 / 중간 저장 ${m.checkpoints||0}회`;
 }
 marbleRAF=requestAnimationFrame(marbleTick);
}
async function toggleSensor(){if(sensorEnabled){sensorEnabled=false;window.removeEventListener('deviceorientation',orientation);$('sensorBtn').textContent='기울기 센서 ON';return}try{if(!window.DeviceOrientationEvent)throw Error('이 환경은 센서를 지원하지 않습니다. 수동 기울기를 사용하세요.');if(typeof DeviceOrientationEvent.requestPermission==='function'){const p=await DeviceOrientationEvent.requestPermission();if(p!=='granted')throw Error('센서 권한이 없습니다. 수동 기울기를 사용하세요.')}window.addEventListener('deviceorientation',orientation);sensorEnabled=true;$('sensorBtn').textContent='기울기 센서 OFF';toast('센서 수신 대기 · 움직이지 않으면 수동 기울기를 사용하세요')}catch(e){toast(e.message)}}
let shakeEnabled=false,lastShake=0;
function marbleWave(strength){if(!marble)return;const t=Date.now()*.001;marbleWarp({type:'wave',strength,t})}
function motion(e){const a=e.acceleration;if(!marble||!a)return;const mag=Math.hypot(a.x||0,a.y||0,a.z||0);if(mag>3&&Date.now()-lastShake>90){lastShake=Date.now();marbleWave(Math.min(12,mag*.6)*(+$('sensitivity').value/100))}}
async function toggleShake(){if(shakeEnabled){window.removeEventListener('devicemotion',motion);shakeEnabled=false;$('shakeBtn').textContent='흔들림 센서 ON';return}try{if(!window.DeviceMotionEvent)throw Error('흔들림 센서를 지원하지 않습니다. 수동 파동을 사용하세요.');if(typeof DeviceMotionEvent.requestPermission==='function'&&await DeviceMotionEvent.requestPermission()!=='granted')throw Error('센서 권한이 없습니다');window.addEventListener('devicemotion',motion);shakeEnabled=true;$('shakeBtn').textContent='흔들림 센서 OFF';toast('흔들림 수신 대기 · 지원 기기에서 반응합니다')}catch(e){toast(e.message)}}
function orientation(e){if(!marble||e.beta==null||e.gamma==null)return;const a=((screen.orientation?.angle??window.orientation??0)*Math.PI/180),k=+$('sensitivity').value/100;marble.tx=clamp((e.gamma*Math.cos(a)+e.beta*Math.sin(a))*k,-30,30);marble.ty=clamp((e.beta*Math.cos(a)-e.gamma*Math.sin(a))*k,-30,30)}
/* Project validation, IndexedDB transaction verification and crash recovery. */
function validateDoc(d){if(d?.format!=='ART-STUDIO'||d.version!==1)throw Error('지원하지 않는 프로젝트 형식입니다');if(!Number.isInteger(d.w)||!Number.isInteger(d.h)||d.w<32||d.h<32||d.w*d.h>16e6||d.w>8192||d.h>8192)throw Error('캔버스 크기를 확인하세요 (최대 1600만 화소 / 한 변 8192)');if(!Array.isArray(d.objects)||d.objects.length>50000)throw Error('객체 정보가 올바르지 않습니다');if(typeof d.id!=='string'||typeof d.name!=='string'||!(d.bg==='transparent'||/^#[0-9a-f]{6}$/i.test(d.bg)))throw Error('프로젝트 속성이 올바르지 않습니다');for(const o of d.objects){if(!['shape','stamp','stroke','image','eraseMask'].includes(o.kind))throw Error('알 수 없는 객체');for(const k of ['x','y','w','h','angle','alpha','size','lineWidth'])if(o[k]!==undefined&&(!Number.isFinite(o[k])||Math.abs(o[k])>1e7))throw Error('유효하지 않은 객체 좌표');if((o.kind==='image'||o.kind==='eraseMask')&&(!/^data:image\/(png|jpeg|webp);base64,/.test(o.src)))throw Error('프로젝트에 외부 이미지 링크를 사용할 수 없습니다');if(o.points&&(!Array.isArray(o.points)||o.points.some(p=>!Number.isFinite(p.x)||!Number.isFinite(p.y))))throw Error('잘못된 선 좌표')}return true}
function hash(s){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return(h>>>0).toString(16)}
async function loadDoc(d,reset=true){validateDoc(d);await Promise.all(d.objects.filter(o=>o.src).map(o=>getAsset(o.src)));doc=clone(d);releaseRibbonBuffer();selected=null;live=null;drag=null;axis=null;preview=null;if(reset){history=[];future=[];fit()}render();pruneAssets();updateUndo()}
function openDB(){return new Promise((resolve,reject)=>{const r=indexedDB.open('ART-STUDIO-1',1);r.onupgradeneeded=()=>{r.result.createObjectStore('projects',{keyPath:'id'});r.result.createObjectStore('meta',{keyPath:'id'})};r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}
function dbPut(store,value){return new Promise((resolve,reject)=>{const tx=db.transaction(store,'readwrite');tx.objectStore(store).put(value);tx.oncomplete=resolve;tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error||Error('저장 중단'))})}
function dbGet(store,id){return new Promise((resolve,reject)=>{const r=db.transaction(store).objectStore(store).get(id);r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}
async function saveLocal(){if(!db){$('saveState').textContent='자동저장 불가 · 원본 저장 필요';return}if(saving){saveTimer=setTimeout(saveLocal,500);return}saving=true;const text=JSON.stringify(doc),checksum=hash(text),id=doc.id;try{validateDoc(doc);const thumb=canvas(220,220*doc.h/doc.w);thumb.getContext('2d').drawImage(exportCanvas(true),0,0,thumb.width,thumb.height);const previous=await dbGet('projects',id);if(previous&&hash(previous.text)===previous.checksum)await dbPut('meta',{id:'backup:'+id,value:previous});await dbPut('projects',{id,name:doc.name,updated:Date.now(),text,checksum,thumb:thumb.toDataURL('image/jpeg',.6)});const verify=await dbGet('projects',id);if(verify.checksum!==hash(verify.text))throw Error('저장 검증 실패');await dbPut('meta',{id:'last',value:id});const current=JSON.stringify(doc)===text;if(current)dirty=false;$('saveState').textContent=(current?'자동저장됨 · ':'추가 변경 저장 대기 · ')+new Date().toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})}catch(e){$('saveState').textContent='저장 실패 · 파일로 저장하세요';toast('자동저장 실패: '+e.message)}finally{saving=false}}
async function initStore(){try{db=await openDB();const prefs=await dbGet('meta','preferences');if(prefs){document.body.classList.toggle('left',prefs.value.left);document.documentElement.style.setProperty('--hit',prefs.value.hit+'px');Object.assign(settings,{grid:prefs.value.grid,snap:prefs.value.snap,penOnly:prefs.value.penOnly})}const stamps=await dbGet('meta','stamps');if(stamps){customStamps=stamps.value;await Promise.all(customStamps.map(getAsset))}const last=await dbGet('meta','last');if(last){const r=await dbGet('projects',last.value);let recovered=r;if(r&&hash(r.text)!==r.checksum){const backup=await dbGet('meta','backup:'+last.value);recovered=backup?.value;if(!recovered||hash(recovered.text)!==recovered.checksum)throw Error('자동저장과 백업 검증 실패');toast('손상된 자동저장 대신 이전 정상 저장본을 복구합니다')}if(recovered){await loadDoc(JSON.parse(recovered.text));toast('마지막 정상 저장 작업을 복구했습니다');$('saveState').textContent='이전 작업 복구됨'}}}catch(e){$('saveState').textContent='자동저장 사용 불가';toast('자동저장이 제한된 환경입니다. 상단 저장으로 원본을 보관하세요.')}}
window.addEventListener('beforeunload',e=>{if(dirty||live){e.preventDefault();e.returnValue=''}});document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden'&&dirty)saveLocal()});
function modal(html){$('modalBody').innerHTML=html;$('modalBody').querySelectorAll('[data-close]').forEach(b=>b.onclick=closeModal);if(!$('modal').open)$('modal').showModal()}
function closeModal(){const p=$('exportPreview');if(p)p.removeAttribute('src');$('modal').close()}
function stopMarble(){releaseMarbleWorker();if(marble?.compactAbort)marble.compactAbort(Error('마블링 취소'));if(marble?.compactWorker)marble.compactWorker.terminate();marblePointerId=null;shakeEnabled=false;window.removeEventListener('devicemotion',motion);cancelAnimationFrame(marbleRAF);marble=null;sensorEnabled=false;window.removeEventListener('deviceorientation',orientation)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function projectMenu(){modal(`<h2>내 작업실</h2><p class="note">${esc(doc.name)} · ${doc.w} × ${doc.h}px</p><div class="choices"><button id="newProject">새 캔버스</button><button id="galleryBtn">작품 보관함</button><button id="openProject">원본 열기</button><button id="importPhoto">사진 불러오기</button><button id="renameProject">작품 이름</button><button id="backupBtn">원본 저장</button></div><p class="note">자동저장은 현재 브라우저에 보관됩니다. 브라우저 데이터 삭제에 대비하여 .artstudio 원본 파일도 저장하세요.</p><div class="actions"><button data-close>닫기</button></div>`);$('newProject').onclick=newProjectDialog;$('galleryBtn').onclick=gallery;$('openProject').onclick=()=>{$('projectInput').value='';$('projectInput').click()};$('importPhoto').onclick=()=>{closeModal();importImage()};$('renameProject').onclick=()=>{modal(`<h2>작품 이름</h2><input id="nameInput" type="text" maxlength="80" value="${esc(doc.name)}"><div class="actions"><button data-close>취소</button><button id="nameOK" class="primary">저장</button></div>`);$('nameOK').onclick=()=>{checkpoint();doc.name=$('nameInput').value.trim()||'제목 없는 작품';changed();closeModal()}};$('backupBtn').onclick=saveFile}
$('projectBtn').onclick=projectMenu;
function newProjectDialog(){modal(`<h2>새 캔버스</h2><p class="note">기존 작업을 보관한 뒤 새로 시작합니다. A4는 150dpi 기준입니다.</p><div class="choices"><button data-size="1754,1240">A4 가로</button><button data-size="1240,1754">A4 세로</button><button data-size="1400,1400">정사각형</button></div><div class="rows"><label>너비 (px)<input id="newW" type="number" value="1400" min="32" max="8192"></label><label>높이 (px)<input id="newH" type="number" value="990" min="32" max="8192"></label><label>배경색<input id="newBG" type="color" value="#ffffff"></label><label><input id="transparentBG" type="checkbox">투명 배경</label></div><div class="actions"><button data-close>취소</button><button id="createCanvas" class="primary">새로 만들기</button></div>`);document.querySelectorAll('[data-size]').forEach(b=>b.onclick=()=>{[$('newW').value,$('newH').value]=b.dataset.size.split(',')});$('createCanvas').onclick=async()=>{const d={format:'ART-STUDIO',version:1,id:uid(),name:'제목 없는 작품',w:+$('newW').value,h:+$('newH').value,bg:$('transparentBG').checked?'transparent':$('newBG').value,objects:[],updated:Date.now()};try{validateDoc(d);if(dirty){await saveLocal();if(dirty&&!confirm('자동저장이 완료되지 않았습니다. 기존 작업을 파일로 저장하지 않고 새로 시작할까요?'))return}await loadDoc(d);changed();closeModal()}catch(e){toast(e.message)}}}
async function gallery(){if(!db)return toast('이 환경에서는 작품 보관함을 사용할 수 없습니다');await saveLocal();const rs=await new Promise((res,rej)=>{const r=db.transaction('projects').objectStore('projects').getAll();r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)});rs.sort((a,b)=>b.updated-a.updated);modal('<h2>작품 보관함</h2><p class="note">이 브라우저에 저장된 작품</p><div class="gallery" id="works"></div><div class="actions"><button data-close>닫기</button></div>');for(const r of rs){const div=document.createElement('div');div.className='work';const img=document.createElement('img');img.src=r.thumb;div.append(img);const strong=document.createElement('strong');strong.textContent=r.name;div.append(strong);const b=document.createElement('button');b.textContent='열기';b.onclick=async()=>{try{if(hash(r.text)!==r.checksum)throw Error('저장 데이터 손상');await loadDoc(JSON.parse(r.text));closeModal();await dbPut('meta',{id:'last',value:doc.id})}catch(e){toast(e.message)}};div.append(b);$('works').append(div)}}
$('projectInput').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{if(f.size>90e6)throw Error('원본 파일이 너무 큽니다');const d=JSON.parse(await readFile(f,true));validateDoc(d);if(dirty)await saveLocal();await loadDoc(d);closeModal();changed();toast('원본을 불러왔습니다')}catch(err){toast(err.message)}};
/* Shared output raster, native PDF serializer (JPEG page, no external dependency). */
function exportCanvas(background=true,scale=1){
 const c=canvas(doc.w*scale,doc.h*scale),g=c.getContext('2d');
 if(scale===1){g.scale(scale,scale);if(background){g.fillStyle=doc.bg==='transparent'?'#ffffff':doc.bg;g.fillRect(0,0,doc.w,doc.h)}g.drawImage(board,0,0);return c}
 // Repaint vector strokes and shapes at the requested pixel resolution instead of upscaling the preview bitmap.
 // Keep eraser compositing on a transparent paint surface, then place the background underneath.
 const paintLayer=canvas(c.width,c.height),pg=paintLayer.getContext('2d');pg.scale(scale,scale);
 for(const o of doc.objects)drawObject(pg,o);
 if(background){g.fillStyle=doc.bg==='transparent'?'#ffffff':doc.bg;g.fillRect(0,0,c.width,c.height)}
 g.drawImage(paintLayer,0,0);paintLayer.width=paintLayer.height=1;return c
}
function download(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),60000)}
function saveFile(){if(live?.kind==='shape'&&live.points?.length>=2)finishPolygon();const d=JSON.stringify(doc);download(new Blob([d],{type:'application/json'}),(doc.name||'ART_STUDIO')+'.artstudio');saveLocal();toast('재편집 가능한 원본 파일을 저장합니다')}$('saveBtn').onclick=saveFile;
function outputDialog(print=false){modal(`<h2>${print?'인쇄 준비':'내보내기'}</h2><p class="note">원본 비율을 유지하며 출력합니다. PDF와 인쇄는 A4 한 장에 맞춥니다.</p><img id="exportPreview" alt="출력 미리보기"><div class="rows">${print?'<label>인쇄 해상도<select id="outPrintScale"><option value="1">원본 (100%)</option><option value="2" selected>고화질 (200%)</option><option value="3">초고화질 (300%)</option></select></label>':'<label>형식<select id="outFormat"><option>PNG</option><option>JPG</option><option>PDF</option></select></label><label>출력 해상도<select id="outScale"><option value="1">원본 크기</option><option value="0.5">50%</option><option value="2">200%</option></select></label><label>JPG / PDF 화질<select id="outQuality"><option value="0.92">높음 (92%)</option><option value="0.8">표준 (80%)</option><option value="1">최대 (100%)</option></select></label>'}<label>용지 방향<select id="outOrientation"><option value="landscape" ${doc.w>=doc.h?'selected':''}>A4 가로</option><option value="portrait" ${doc.w<doc.h?'selected':''}>A4 세로</option></select></label><label>여백 (mm)<input id="outMargin" type="number" min="0" max="40" value="10"></label><label><input id="outBG" type="checkbox" checked>배경 포함</label></div><p class="note">PNG는 배경 제외 시 투명도를 보존합니다. JPG·PDF·인쇄의 투명 부분은 흰색입니다.</p><div class="actions"><button data-close>닫기</button><button id="outputGo" class="primary">${print?'인쇄 미리보기 열기':'파일 저장'}</button></div>`);outputPreview();for(const id of ['outBG','outOrientation','outMargin','outFormat'])if($(id))$(id).oninput=outputPreview;$('outputGo').onclick=async()=>{try{const scale=print?+$('outPrintScale').value:+$('outScale').value;if(doc.w*doc.h*scale*scale>20e6)throw Error('출력 크기가 2000만 화소를 초과합니다. 해상도를 낮춰주세요');const c=exportCanvas($('outBG').checked,scale),format=print?'PRINT':$('outFormat').value,orientation=$('outOrientation').value,margin=clamp(+$('outMargin').value||0,0,40);if(format==='PRINT'){printCanvas(c,orientation,margin);return}if(format==='PDF'){download(makePDF(c,orientation,margin,+$('outQuality').value),doc.name+'.pdf')}else{if(format==='JPG'){const g=c.getContext('2d');g.globalCompositeOperation='destination-over';g.fillStyle='#fff';g.fillRect(0,0,c.width,c.height)}c.toBlob(b=>download(b,doc.name+(format==='PNG'?'.png':'.jpg')),format==='PNG'?'image/png':'image/jpeg',+$('outQuality').value)}toast('내보내기 파일을 저장합니다')}catch(e){toast(e.message)}}}
function pageLayout(w,h,orientation,margin){const pw=orientation==='landscape'?297:210,ph=orientation==='landscape'?210:297,m=clamp(margin,0,40),scale=Math.min((pw-2*m)/w,(ph-2*m)/h);return{pw,ph,x:(pw-w*scale)/2,y:(ph-h*scale)/2,w:w*scale,h:h*scale}}
function outputPreview(){const paged=!$('outFormat')||$('outFormat').value==='PDF';$('outOrientation').disabled=!paged;$('outMargin').disabled=!paged;if(!paged){$('exportPreview').src=exportCanvas($('outBG').checked).toDataURL();return}const p=pageLayout(doc.w,doc.h,$('outOrientation').value,+$('outMargin').value||0),c=canvas(p.pw*2,p.ph*2),g=c.getContext('2d');g.fillStyle='white';g.fillRect(0,0,c.width,c.height);g.drawImage(exportCanvas($('outBG').checked),p.x*2,p.y*2,p.w*2,p.h*2);$('exportPreview').src=c.toDataURL()}
function makePDF(c,orientation,margin,quality){const flat=canvas(c.width,c.height),fg=flat.getContext('2d');fg.fillStyle='#fff';fg.fillRect(0,0,c.width,c.height);fg.drawImage(c,0,0);c=flat;const jpg=atob(c.toDataURL('image/jpeg',quality).split(',')[1]),layout=pageLayout(c.width,c.height,orientation,margin),pw=layout.pw*72/25.4,ph=layout.ph*72/25.4,w=layout.w*72/25.4,h=layout.h*72/25.4,x=layout.x*72/25.4,y=layout.y*72/25.4,stream=`q\n${w.toFixed(3)} 0 0 ${h.toFixed(3)} ${x.toFixed(3)} ${y.toFixed(3)} cm\n/Im0 Do\nQ\n`;let s='%PDF-1.4\n',offsets=[0];function obj(n,t){offsets[n]=s.length;s+=`${n} 0 obj\n${t}\nendobj\n`}obj(1,'<< /Type /Catalog /Pages 2 0 R >>');obj(2,'<< /Type /Pages /Kids [3 0 R] /Count 1 >>');obj(3,`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${pw} ${ph}] /Resources << /XObject << /Im0 4 0 R >> >> /Contents 5 0 R >>`);obj(4,`<< /Type /XObject /Subtype /Image /Width ${c.width} /Height ${c.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${jpg.length} >>\nstream\n${jpg}\nendstream`);obj(5,`<< /Length ${stream.length} >>\nstream\n${stream}endstream`);const start=s.length;s+='xref\n0 6\n0000000000 65535 f \n';for(let i=1;i<=5;i++)s+=String(offsets[i]).padStart(10,'0')+' 00000 n \n';s+=`trailer\n<< /Size 6 /Root 1 0 R >>\nstartxref\n${start}\n%%EOF`;return new Blob([Uint8Array.from(s,ch=>ch.charCodeAt(0))],{type:'application/pdf'})}
// The print image is temporary and must be dropped after the native print dialog.
let printCleanupTimer=null,printRun=0;
function cleanupPrintResource(){
 clearTimeout(printCleanupTimer);printCleanupTimer=null;
 const root=$('printRoot');for(const im of root.querySelectorAll('img')){im.onload=null;im.onerror=null;im.removeAttribute('src');}
 root.replaceChildren();
}
window.addEventListener('afterprint',()=>{cleanupPrintResource()});
window.addEventListener('pagehide',cleanupPrintResource);
/* Android print preview may ignore @page landscape and leave a landscape
   image small on a portrait A4 sheet. Keep the native sheet portrait and rotate
   ONLY the temporary print image, so the printed page can be turned sideways.
   PNG/JPG/PDF output and the live drawing canvas are not affected. */
function printPageGeometry(w,h,orientation,margin){
 const m=clamp(margin,0,40),rotated=orientation==='landscape';
 // Keep 1mm clearance on each side to prevent Chrome's second blank page.
 const availW=210-2*m-2,availH=297-2*m-2;
 const maxW=rotated?availH:availW,maxH=rotated?availW:availH;
 const ratio=Math.min(maxW/w,maxH/h);
 return{rotate:rotated,margin:m,printW:w*ratio,printH:h*ratio,
   visibleW:rotated?h*ratio:w*ratio,visibleH:rotated?w*ratio:h*ratio,
   sheetW:210-2*m,sheetH:297-2*m-1};
}
function printCanvas(c,orientation,margin){
 const run=++printRun;cleanupPrintResource();
 let style=$('printStyle');if(!style){style=document.createElement('style');style.id='printStyle';document.head.append(style)}
 const p=printPageGeometry(c.width,c.height,orientation,margin);
 // Print portrait paper in both cases. Rotating landscape content in CSS is
 // deliberate: Android/embedded viewers do not reliably honor @page landscape.
 style.textContent=`@media print{
   @page{size:A4 portrait;margin:${p.margin}mm}
   #printRoot{display:flex!important;position:relative!important;align-items:center!important;
     justify-content:center!important;overflow:visible!important;width:${p.sheetW}mm!important;
     height:${p.sheetH}mm!important;margin:0 auto!important;padding:0!important}
   #printRoot img{display:block!important;flex:0 0 auto!important;
     width:${p.printW.toFixed(4)}mm!important;height:${p.printH.toFixed(4)}mm!important;
     min-width:0!important;max-width:none!important;max-height:none!important;
     margin:0!important;object-fit:fill!important;
     transform:${p.rotate?'rotate(90deg)':'none'}!important;
     transform-origin:center center!important}
 }`;
 const im=new Image();im.onload=()=>{if(run!==printRun)return;closeModal();requestAnimationFrame(()=>{try{window.print()}catch(e){toast('인쇄를 시작할 수 없습니다: '+e.message);cleanupPrintResource()}})};
 im.onerror=()=>{toast('인쇄 이미지 준비 실패');cleanupPrintResource()};
 try{im.src=c.toDataURL();$('printRoot').append(im)}finally{c.width=c.height=1}
 // Some embedded file viewers do not fire `afterprint`; this is a fallback,
 // deliberately delayed so that a slow print dialog is not cut off.
 printCleanupTimer=setTimeout(()=>{if(run===printRun)cleanupPrintResource()},120000);
}
$('exportBtn').onclick=()=>outputDialog();$('printBtn').onclick=()=>outputDialog(true);
function settingsDialog(){modal(`<h2>작업실 설정</h2><p class="note">실행 환경: ${location.protocol==='file:'?'로컬 파일 · 저장 지원은 브라우저별로 다릅니다. 원본 파일을 함께 보관하세요.':(window.isSecureContext?'보안 컨텍스트 · 이 브라우저 저장소 사용':'HTTP · 센서 권한이 제한될 수 있습니다.')}</p><div class="rows"><label>주로 쓰는 손<select id="hand"><option value="right">오른손 · 왼쪽 도구바</option><option value="left" ${document.body.classList.contains('left')?'selected':''}>왼손 · 오른쪽 도구바</option></select></label><label>버튼 크기<select id="hitSize"><option value="48">기본 48px</option><option value="56">크게 56px</option><option value="64">매우 크게 64px</option></select></label><label><input id="gridSetting" type="checkbox" ${settings.grid?'checked':''}>격자 표시</label><label><input id="snapSetting" type="checkbox" ${settings.snap?'checked':''}>25px 격자 스냅</label><label><input id="penSetting" type="checkbox" ${settings.penOnly?'checked':''}>펜 전용 (손가락 입력 차단)</label></div><p class="note">일반 정전식 터치펜은 손가락으로 인식되므로 펜 전용을 끄세요. 터치펜 입력 중 터치는 무시하지만 기기별 팜리젝션은 실기기 확인이 필요합니다.</p><div class="actions"><button data-close>닫기</button><button id="settingsApply" class="primary">적용</button></div>`);$('hitSize').value=getComputedStyle(document.documentElement).getPropertyValue('--hit').trim().replace('px','');$('settingsApply').onclick=()=>{document.body.classList.toggle('left',$('hand').value==='left');document.documentElement.style.setProperty('--hit',$('hitSize').value+'px');settings.grid=$('gridSetting').checked;settings.snap=$('snapSetting').checked;settings.penOnly=$('penSetting').checked;if(db)dbPut('meta',{id:'preferences',value:{left:document.body.classList.contains('left'),hit:$('hitSize').value,grid:settings.grid,snap:settings.snap,penOnly:settings.penOnly}}).catch(()=>toast('설정 저장 실패'));closeModal();resize();paint()}}$('settingsBtn').onclick=settingsDialog;
document.addEventListener('keydown',e=>{if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)||$('modal').open)return;if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='z'){e.preventDefault();e.shiftKey?redo():undo()}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveFile()}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='c'){const o=objectById();if(o){copyBuffer=clone(o);toast('선택 객체를 복사했습니다')}}if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='v'&&copyBuffer){checkpoint();const o=clone(copyBuffer);o.id=uid();o.x+=24;o.y+=24;doc.objects.push(o);selected=o.id;changed()}if(e.key==='Delete'||e.key==='Backspace'){if(selected){e.preventDefault();contextAction('delete')}}if(e.key==='Escape'){cancelEffect();selected=null;live=null;$('panel').hidden=true;paint()}if(e.key==='Enter')finishPolygon()});
/* Validation: isolated tests do not mutate the current artwork. */
async function selfTest(){const results=[];const test=(name,f)=>{try{f();results.push('PASS · '+name)}catch(e){results.push('FAIL · '+name+' — '+e.message)}};const assert=(v,s='조건 불일치')=>{if(!v)throw Error(s)};
test('프로젝트 JSON 왕복 / 형식 검증',()=>{const d=clone(doc);validateDoc(d);assert(JSON.stringify(d)===JSON.stringify(doc))});
test('잘못된 파일 버전 거부',()=>{let rejected=false;try{validateDoc({...doc,version:999})}catch(e){rejected=true}assert(rejected)});
test('과대 캔버스 거부',()=>{let rejected=false;try{validateDoc({...doc,w:9000})}catch(e){rejected=true}assert(rejected)});
test('뷰포트 ↔ 그림 좌표 왕복',()=>{for(const p of [{x:0,y:0},{x:183.25,y:726.5},{x:doc.w,y:doc.h}]){const q=toDoc(camera.x+p.x*camera.z,camera.y+p.y*camera.z);assert(Math.abs(q.x-p.x)<1e-7&&Math.abs(q.y-p.y)<1e-7)}});
test('임의 각도 반전의 2회 적용 = 원위치',()=>{for(const b of [{x:0,y:100},{x:100,y:0},{x:83,y:47}]){const m=reflectionMatrix({x:13,y:17},b),f=p=>({x:m[0]*p.x+m[2]*p.y+m[4],y:m[1]*p.x+m[3]*p.y+m[5]}),p={x:84,y:127},q=f(f(p));assert(Math.hypot(q.x-p.x,q.y-p.y)<1e-7)}});
test('브러시 권장값 유효성',()=>{for(const [name,p] of Object.entries(brushProfiles))assert(p.size>=1&&p.size<=160&&p.alpha>0&&p.alpha<=1,name)});
test('색상 사용 도구별 활성 상태',()=>{const before={tool,brush:settings.brush,effect:settings.effect};try{tool='select';assert(!colorControlsActive());tool='eraser';assert(!colorControlsActive());tool='shape';assert(colorControlsActive());tool='draw';settings.brush='smudge';assert(!colorControlsActive());settings.brush='brush';assert(colorControlsActive());tool='effects';settings.effect='copy';assert(!colorControlsActive());settings.effect='tile';assert(colorControlsActive())}finally{tool=before.tool;settings.brush=before.brush;settings.effect=before.effect}});
test('붓 알파 중첩 방지 및 연속 선',()=>{const c=canvas(120,60),g=c.getContext('2d');drawStroke(g,{brush:'brush',points:[{x:15,y:30,p:.5},{x:45,y:30,p:.5},{x:75,y:30,p:.5},{x:100,y:30,p:.5}],color:'#ff0000',alpha:.5,size:20,pressure:false});const a=g.getImageData(35,30,1,1).data[3],b=g.getImageData(45,30,1,1).data[3];assert(Math.abs(a-b)<=1&&a>=125&&a<=129,'연결 지점이 과도하게 진해짐 '+a+' '+b)});
test('필압 붓과 필압 펜 연속성',()=>{for(const brush of ['brush','pen','eraser']){const c=canvas(140,65),g=c.getContext('2d');g.fillStyle='#335577';g.fillRect(0,0,140,65);drawStroke(g,{brush,points:[{x:12,y:32,p:.3},{x:40,y:31,p:.6},{x:75,y:29,p:.9},{x:120,y:32,p:.6}],color:'#f00',alpha:.8,size:22,pressure:true});const d=g.getImageData(70,30,1,1).data;assert(brush==='eraser'?d[3]<255:d[0]>51,brush+' 필압 경로 미적용')}});

test('에어브러시 기본 농도와 원터치 가시성',()=>{
 const c=canvas(160,90),g=c.getContext('2d');
 drawStroke(g,{brush:'airbrush',points:[{x:80,y:45,p:.5}],color:'#0284c7',size:50,alpha:.5,pressure:false});
 const a=g.getImageData(80,45,1,1).data[3];
 assert(a>=25&&a<255,'에어브러시 한 번 찍기 불투명도 비정상: '+a);
});
test('에어브러시 빠른 획 연결과 농도 반영',()=>{
 const op={brush:'airbrush',points:[{x:20,y:45,p:.5},{x:160,y:45,p:.5}],color:'#0284c7',size:50,pressure:false};
 const c=canvas(190,90),g=c.getContext('2d');drawStroke(g,{...op,alpha:.5});
 const mid=g.getImageData(90,45,1,1).data[3];assert(mid>45,'빠른 선 이동 시 가운데 분사가 끊김: '+mid);
 const d=canvas(190,90),h=d.getContext('2d');drawStroke(h,{...op,alpha:.1});
 assert(h.getImageData(90,45,1,1).data[3]<mid,'농도 조절이 에어브러시에 반영되지 않음');
});
test('팔레트 색상 코드',()=>{assert(palette.length>=18);for(const group of Object.values(extraColorGroups))for(const c of group)assert(/^#[0-9a-f]{6}$/i.test(c),c)});
test('빠른 색상 20개 스와이프와 표시',()=>{const p=$('palette');assert(p.children.length===20);assert(getComputedStyle(p).overflowX==='auto');assert([...p.children].every(e=>getComputedStyle(e).display!=='none'))});
test('붓 / 지우개 합성',()=>{const c=canvas(60,60),g=c.getContext('2d');drawStroke(g,{points:[{x:30,y:30,p:.5}],size:20,color:'#ff0000',alpha:1,brush:'pen'});assert(g.getImageData(30,30,1,1).data[0]===255);drawStroke(g,{points:[{x:30,y:30,p:.5}],size:20,color:'#000000',alpha:1,brush:'eraser'});assert(g.getImageData(30,30,1,1).data[3]===0)});
test('13종 기본 도형 경로 생성',()=>{const g=canvas(100,100).getContext('2d');g.translate(50,50);for(const t of ['line','rect','round','circle','ellipse','triangle','diamond','pentagon','hexagon','star','arrow','heart','bubble']){pathShape(g,t,50,40);g.fill();g.stroke()}});
test('24종 기본 스탬프 렌더링·고유 이름',()=>{
 assert(builtInStamps.length===24);
 assert(new Set(builtInStamps.map(([id])=>id)).size===24);
 assert(new Set(builtInStamps.map(([,name])=>name)).size===24);
 const signatures=[];
 for(const [name] of builtInStamps){
  const c=canvas(100,100),g=c.getContext('2d');g.translate(50,50);stampArt(g,name,80,80,'#0284c7');
  const data=g.getImageData(0,0,100,100).data;
  const pixels=data.reduce((n,v,i)=>n+(i%4===3&&v>20?1:0),0);
  assert(pixels>50,name+' 스탬프가 제대로 그려지지 않음');
  // Coarse alpha grid avoids classifying only a color change as distinct art.