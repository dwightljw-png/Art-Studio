const marbleReplay=marbleWorkerMain();
let marbleWorker=null,marbleWorkerURL=null,marbleCancelToken=0,marbleReject=null;
function releaseMarbleWorker(){marbleCancelToken++;if(marbleReject){const reject=marbleReject;marbleReject=null;reject(Error('렌더링 취소'))}if(marbleWorker)marbleWorker.terminate();marbleWorker=null;if(marbleWorkerURL)URL.revokeObjectURL(marbleWorkerURL);marbleWorkerURL=null}
async function marbleRenderOutput(){if(!marble)throw Error('마블링 작업실이 닫혔습니다');const m=marble;
  m.rendering=true;
  if(m.compacting)await m.compacting;
  if(m!==marble)throw Error('마블링 작업실이 닫혔습니다');
  const quality=$('marbleQuality').value,w=quality==='auto'?Math.min(1600,Math.max(640,Math.round(doc.w*.8))):+quality,h=Math.round(w*220/320),ops=m.ops.map(o=>({...o}));
  if(!ops.length&&!m.snapshot){m.rendering=false;return m.c}
 const token=++marbleCancelToken;$('marbleProgress').hidden=false;$('marbleApply').disabled=true;$('marbleStamp').disabled=true;
 const progress=v=>{if($('marbleProgress'))$('marbleProgress').textContent=`고해상도 렌더링 ${v.progress}% · ${w} × ${h}px`};
 const payload={ops,w,h,base:m.snapshot||null};let result;
 try{if(typeof Worker==='function'){try{marbleWorkerURL=URL.createObjectURL(new Blob(['('+marbleWorkerMain.toString()+')()'],{type:'text/javascript'}));marbleWorker=new Worker(marbleWorkerURL);result=await new Promise((resolve,reject)=>{marbleReject=reject;marbleWorker.onmessage=e=>{if(e.data.error)reject(Error(e.data.error));else if(e.data.buffer)resolve(e.data);else progress(e.data)};marbleWorker.onerror=e=>reject(Error(e.message||'Worker 실행 불가'));marbleWorker.postMessage(payload)})}catch(e){if(token!==marbleCancelToken)throw Error('렌더링 취소');if(marbleWorker)marbleWorker.terminate();marbleWorker=null;result=await marbleReplay.replay(payload,progress,async()=>{await new Promise(r=>setTimeout(r,0));if(token!==marbleCancelToken)throw Error('렌더링 취소')})}}
 else result=await marbleReplay.replay(payload,progress,async()=>{await new Promise(r=>setTimeout(r,0));if(token!==marbleCancelToken)throw Error('렌더링 취소')});
 if(token!==marbleCancelToken||marble!==m)throw Error('렌더링 취소');const c=canvas(result.w,result.h);c.getContext('2d').putImageData(new ImageData(new Uint8ClampedArray(result.buffer),result.w,result.h),0,0);return c;
 }finally{if(marble===m){m.rendering=false;if($('marbleApply'))$('marbleApply').disabled=false;if($('marbleStamp'))$('marbleStamp').disabled=false}if(token===marbleCancelToken){marbleReject=null;if(marbleWorker)marbleWorker.terminate();marbleWorker=null;if(marbleWorkerURL)URL.revokeObjectURL(marbleWorkerURL);marbleWorkerURL=null}}
