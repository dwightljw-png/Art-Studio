 const sx=w/doc.w,sy=h/doc.h,aa={x:axis.a.x*sx,y:axis.a.y*sy},bb={x:axis.b.x*sx,y:axis.b.y*sy};
 const input=canvas(w,h),ig=input.getContext('2d',{willReadFrequently:true});ig.drawImage(board,0,0,w,h);
 const fold=canvas(w,h),fg=fold.getContext('2d',{willReadFrequently:true});fg.setTransform(...reflectionMatrix(aa,bb));fg.drawImage(input,0,0);fg.resetTransform();
