// Snapshot long marbling sessions, preserving the rendered pigment instead of dropping steps.
// A quality-matched checkpoint plus a short replay tail prevents unbounded operation logs.
const MARBLE_COMPACT_AT=160;
function marbleCheckpointWidth(){const quality=$('marbleQuality').value;return quality==='auto'?Math.min(1600,Math.max(640,Math.round(doc.w*.8))):+quality}
function compactMarbleIfNeeded(){
 const m=marble;
 if(!m||m.rendering||m.compacting||m.ops.length<MARBLE_COMPACT_AT)return;
 if(m.compactFailureAt&&Date.now()-m.compactFailureAt<60000)return;
 const count=m.ops.length,ops=m.ops.slice(0,count).map(o=>({...o}));
 const w=marbleCheckpointWidth(),h=Math.round(w*220/320),base=m.snapshot||null;
 m.compacting=(async()=>{
  let worker=null,url=null,result=null;
  try{
   const payload={ops,w,h,base};
   if(typeof Worker==='function'){
    try{
     url=URL.createObjectURL(new Blob(['('+marbleWorkerMain.toString()+')()'],{type:'text/javascript'}));
     worker=new Worker(url);m.compactWorker=worker;
     result=await new Promise((resolve,reject)=>{
      worker.onmessage=e=>{if(e.data.error)reject(Error(e.data.error));else if(e.data.buffer)resolve(e.data)};
      worker.onerror=e=>reject(Error(e.message||'마블링 압축 실패'));
