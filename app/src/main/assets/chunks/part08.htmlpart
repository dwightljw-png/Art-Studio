 for(let i=0;i<ps.length;i++){
  const prev=ps[Math.max(0,i-1)],next=ps[Math.min(ps.length-1,i+1)];
  let dx=next.x-prev.x,dy=next.y-prev.y,len=Math.hypot(dx,dy);
  if(len<1e-5){dx=1;dy=0;len=1}
  const nx=-dy/len,ny=dx/len,r=size*(pressure?clamp(.25+(ps[i].p??.5),.15,1.25):1)/2;
  normals.push(Math.atan2(ny,nx));
  left.push({x:ps[i].x+nx*r,y:ps[i].y+ny*r,r});
  right.push({x:ps[i].x-nx*r,y:ps[i].y-ny*r,r});
 }
 g.beginPath();g.moveTo(left[0].x,left[0].y);
 for(let i=1;i<left.length;i++)g.lineTo(left[i].x,left[i].y);
 const last=ps.length-1;
 g.arc(ps[last].x,ps[last].y,left[last].r,normals[last],normals[last]+Math.PI,true);
 for(let i=last;i>=0;i--)g.lineTo(right[i].x,right[i].y);
 g.arc(ps[0].x,ps[0].y,left[0].r,normals[0]+Math.PI,normals[0]+2*Math.PI,true);
 g.closePath();g.fill();
}
/* v1.6.5: soft airbrush dabs, distance-spaced rather than event-spaced.
   A 96px tinted gradient stamp is cached by color (bounded to 12 colors).
   Stroke opacity is applied only once, without the previous 0.035 multiplier. */
const airbrushStampCache=new Map();
function getAirbrushStamp(color){
 let stamp=airbrushStampCache.get(color);
 if(stamp)return stamp;
 const rgb=/^#([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(color);
 const rr=rgb?parseInt(rgb[1],16):2,gg=rgb?parseInt(rgb[2],16):132,bb=rgb?parseInt(rgb[3],16):199;
 stamp=canvas(96,96);const sg=stamp.getContext('2d');
 const radial=sg.createRadialGradient(48,48,0,48,48,48);
 const rgba=a=>`rgba(${rr},${gg},${bb},${a})`;
 radial.addColorStop(0,rgba(.48));
 radial.addColorStop(.25,rgba(.38));
 radial.addColorStop(.58,rgba(.13));
 radial.addColorStop(1,rgba(0));
 sg.fillStyle=radial;sg.fillRect(0,0,96,96);
 if(airbrushStampCache.size>=12)airbrushStampCache.delete(airbrushStampCache.keys().next().value);
 airbrushStampCache.set(color,stamp);
 return stamp;
}
function drawAirbrush(g,o){
 const ps=o.points;if(!ps.length)return;
 const stamp=getAirbrushStamp(o.color),baseRadius=Math.max(.75,o.size*.5),step=Math.max(.75,baseRadius*.40);
 const dab=p=>{
  const pressure=o.pressure?clamp(.5+(p.p??.5),.3,1.5):1;
  const r=baseRadius*pressure;
  g.drawImage(stamp,p.x-r,p.y-r,2*r,2*r);
 };
 // A tap deposits a visible soft dot, and sparse/fast moves never skip segments.
 dab(ps[0]);let total=0,next=step;
 for(let i=1;i<ps.length;i++){
  const a=ps[i-1],b=ps[i],dx=b.x-a.x,dy=b.y-a.y,len=Math.hypot(dx,dy);
  if(len<.00001)continue;
  while(next<=total+len){
   const t=clamp((next-total)/len,0,1);
   dab({x:a.x+dx*t,y:a.y+dy*t,p:(a.p??.5)+((b.p??.5)-(a.p??.5))*t});
   next+=step;
  }
  total+=len;
 }
 if(ps.length>1&&total>0&&total-(next-step)>step*.55)dab(ps[ps.length-1]);
}
function drawStroke(g,o){const ps=o.points;if(!ps.length)return;g.save();g.globalAlpha=o.alpha;g.globalCompositeOperation=o.brush==='eraser'?'destination-out':'source-over';g.strokeStyle=o.color;g.fillStyle=o.color;g.lineCap='round';g.lineJoin='round';let seed=o.seed||1;
 if(o.brush==='airbrush'){drawAirbrush(g,o)}
 else if(['pastel','pencil'].includes(o.brush)){
  for(let i=0;i<ps.length;i++){
   const a=ps[Math.max(0,i-1)],b=ps[i],d=Math.hypot(b.x-a.x,b.y-a.y),steps=Math.max(1,Math.ceil(d/Math.max(1,o.size*.12)));
   for(let j=0;j<steps;j++){
    const t=j/steps,x=a.x+(b.x-a.x)*t,y=a.y+(b.y-a.y)*t,r=o.size*(o.pressure?(.25+b.p):.5),count=o.brush==='pencil'?7:24;
    g.globalAlpha=o.alpha*.16;
    for(let k=0;k<count;k++){
     const s=seed+i*400+j*37+k,ang=seeded(s)*Math.PI*2,rr=Math.sqrt(seeded(s+7))*r;
     g.fillRect(x+Math.cos(ang)*rr,y+Math.sin(ang)*rr,o.brush==='pencil'?.8:1.6,o.brush==='pencil'?.8:1.6)
    }
   }
  }
 }else{
  if(o.brush==='marker')g.globalAlpha=o.alpha*.25;
  if(ps.length===1){const radius=o.size*(o.pressure?clamp(.25+(ps[0].p??.5),.15,1.25):1)/2;g.beginPath();g.arc(ps[0].x,ps[0].y,radius,0,Math.PI*2);g.fill()}
  else if(o.pressure)strokePressureOutline(g,ps,o.size,true);
  else{g.lineWidth=o.size;g.beginPath();g.moveTo(ps[0].x,ps[0].y);for(let i=1;i<ps.length;i++)g.lineTo(ps[i].x,ps[i].y);g.stroke()}
 }
 g.restore()
}
function drawObject(g,o){if(o.kind==='ribbonPreview'){const c=renderRibbonBuffer();if(c)g.drawImage(c,0,0);return}if(o.kind==='eraseMask'){const mask=assets.get(o.src);if(mask){g.save();g.globalCompositeOperation='destination-out';g.drawImage(mask,0,0,doc.w,doc.h);g.restore()}return}if(o.kind==='stroke'){drawStroke(g,o);return}g.save();if(o.matrix)g.transform(...o.matrix);g.translate(o.x||0,o.y||0);g.rotate(o.angle||0);g.scale(o.fx||1,o.fy||1);g.globalAlpha=o.alpha??1;
if(o.kind==='image'){const im=assets.get(o.src);if(im)g.drawImage(im,-o.w/2,-o.h/2,o.w,o.h)}else if(o.kind==='stamp')stampArt(g,o.stamp,o.w,o.h,o.color);else if(o.kind==='shape'){g.strokeStyle=o.color;g.fillStyle=o.fillColor||o.color;g.lineWidth=o.lineWidth||2;if(o.points){g.beginPath();o.points.forEach((p,i)=>g[i?'lineTo':'moveTo'](p.x,p.y));if(o.closed)g.closePath()}else pathShape(g,o.shape,o.w,o.h);if(o.fill&&o.shape!=='line')g.fill();if(o.stroke)g.stroke()}g.restore()}
function render(){if(board.width!==doc.w||board.height!==doc.h){board.width=doc.w;board.height=doc.h}ctx.clearRect(0,0,doc.w,doc.h);for(const o of doc.objects)drawObject(ctx,o);paint()}
function paint(){if(framePending)return;framePending=true;requestAnimationFrame(()=>{framePending=false;drawView()})}
function drawView(){vctx.setTransform(dpr,0,0,dpr,0,0);vctx.clearRect(0,0,view.width/dpr,view.height/dpr);vctx.save();vctx.translate(camera.x,camera.y);vctx.scale(camera.z,camera.z);vctx.shadowColor='#0f172a18';vctx.shadowBlur=24/camera.z;vctx.fillStyle=doc.bg==='transparent'?'#fff':doc.bg;vctx.fillRect(0,0,doc.w,doc.h);vctx.shadowBlur=0;if(doc.bg==='transparent'){vctx.fillStyle='#e2e8f0';for(let y=0;y<doc.h;y+=20)for(let x=0;x<doc.w;x+=20)if((x/20+y/20)%2===0)vctx.fillRect(x,y,20,20)}vctx.save();vctx.beginPath();vctx.rect(0,0,doc.w,doc.h);vctx.clip();if(!(preview&&(!axis||settings.effect==='decal')))vctx.drawImage(board,0,0);if(live){if(live.kind==='stroke'){if(live.brush==='eraser'){const tmp=canvas(doc.w,doc.h),tg=tmp.getContext('2d');tg.drawImage(board,0,0);drawStroke(tg,live);vctx.fillStyle=doc.bg==='transparent'?'#fff':doc.bg;vctx.fillRect(0,0,doc.w,doc.h);vctx.drawImage(tmp,0,0)}else drawStroke(vctx,live)}else if(live.kind==='ribbonErasePreview'){const tmp=renderRibbonErasePreview();if(tmp){vctx.fillStyle=doc.bg==='transparent'?'#fff':doc.bg;vctx.fillRect(0,0,doc.w,doc.h);vctx.drawImage(tmp,0,0)}}else drawObject(vctx,live)}if(marble)vctx.drawImage(marble.c,0,0,doc.w,doc.h);if(preview){vctx.globalAlpha=axis&&settings.effect!=='decal'?.7:1;if(axis&&settings.effect==='decal')vctx.drawImage(preview,0,0,doc.w,doc.h);else vctx.drawImage(preview,0,0);vctx.globalAlpha=1}if(settings.grid&&camera.z>.15){vctx.strokeStyle='#64748b22';vctx.lineWidth=1/camera.z;vctx.beginPath();for(let x=0;x<=doc.w;x+=25){vctx.moveTo(x,0);vctx.lineTo(x,doc.h)}for(let y=0;y<=doc.h;y+=25){vctx.moveTo(0,y);vctx.lineTo(doc.w,y)}vctx.stroke()}vctx.restore();
const o=objectById();if(o&&o.kind!=='stroke'){vctx.save();if(o.matrix)vctx.transform(...o.matrix);vctx.translate(o.x,o.y);vctx.rotate(o.angle||0);vctx.strokeStyle='#0284c7';vctx.lineWidth=1.5/camera.z;vctx.setLineDash([5/camera.z,4/camera.z]);vctx.strokeRect(-o.w/2,-o.h/2,o.w,o.h);vctx.setLineDash([]);vctx.beginPath();vctx.moveTo(0,-o.h/2);vctx.lineTo(0,-o.h/2-28/camera.z);vctx.stroke();for(const p of [[-o.w/2,-o.h/2],[o.w/2,-o.h/2],[-o.w/2,o.h/2],[o.w/2,o.h/2],[0,-o.h/2-28/camera.z]]){vctx.fillStyle='white';vctx.beginPath();vctx.arc(...p,6/camera.z,0,Math.PI*2);vctx.fill();vctx.stroke()}vctx.restore()}
if(drag&&['rectselect','lasso'].includes(drag.type)){vctx.strokeStyle='#0284c7';vctx.lineWidth=1.5/camera.z;vctx.setLineDash([5/camera.z,4/camera.z]);vctx.beginPath();if(drag.type==='rectselect')vctx.rect(drag.start.x,drag.start.y,drag.last.x-drag.start.x,drag.last.y-drag.start.y);else drag.points.forEach((p,i)=>vctx[i?'lineTo':'moveTo'](p.x,p.y));vctx.stroke();vctx.setLineDash([])}
if(axis){vctx.strokeStyle='#0284c7';vctx.lineWidth=2/camera.z;vctx.setLineDash([8/camera.z,6/camera.z]);vctx.beginPath();vctx.moveTo(axis.a.x,axis.a.y);vctx.lineTo(axis.b.x,axis.b.y);vctx.stroke();vctx.setLineDash([]);for(const p of [axis.a,axis.b]){vctx.fillStyle='white';vctx.beginPath();vctx.arc(p.x,p.y,7/camera.z,0,7);vctx.fill();vctx.stroke()}if(settings.effect!=='decal'){const m=axisMid(),n=axisNormal();vctx.beginPath();vctx.moveTo(m.x,m.y);const tip={x:m.x+n.x*axis.dir*40/camera.z,y:m.y+n.y*axis.dir*40/camera.z};vctx.lineTo(tip.x,tip.y);vctx.moveTo(tip.x-n.x*axis.dir*10/camera.z-n.y*6/camera.z,tip.y-n.y*axis.dir*10/camera.z+n.x*6/camera.z);vctx.lineTo(tip.x,tip.y);vctx.lineTo(tip.x-n.x*axis.dir*10/camera.z+n.y*6/camera.z,tip.y-n.y*axis.dir*10/camera.z-n.x*6/camera.z);vctx.stroke()}}vctx.restore();$('zoomLabel').textContent=Math.round(camera.z*100)+'%';placeContext()}
function setTool(t){if(marble){toast('마블링을 먼저 적용하거나 취소하세요');return}if(pointerMap.size)return;const prev=tool;if(prev!==t)rememberBrushProfile();if(axis)cancelEffect();live=null;drag=null;tool=t;if(t==='draw'&&['bucket','eyedrop'].includes(settings.brush))settings.brush=lastDrawingBrush;if(t==='fill'&&!['bucket','eyedrop'].includes(settings.brush))settings.brush='bucket';if(prev!==t&&(t==='draw'||t==='eraser'))restoreBrushProfile(t==='eraser'?'eraser':settings.brush);updateColorControls();if(t!=='effects')selected=null;document.querySelectorAll('[data-tool]').forEach(b=>b.classList.toggle('active',b.dataset.tool===t));showPanel();paint()}
function choice(key,entries){return '<div class="choices">'+entries.map(([v,n])=>`<button data-key="${key}" data-val="${v}" class="${settings[key]===v?'active':''}">${n}</button>`).join('')+'</div>'}
function range(key,name,min,max,step=1){return `<div class="field"><label>${name}</label><input type="range" data-range="${key}" min="${min}" max="${max}" step="${step}" value="${settings[key]}"><output>${settings[key]}</output></div>`}
function check(key,name){return `<div class="field"><label><input type="checkbox" data-check="${key}" ${settings[key]?'checked':''}>${name}</label></div>`}
function showPanel(){$('panel').hidden=false;$('panelTitle').textContent=toolNames[tool];let s='';
if(tool==='draw')s=choice('brush',[['pencil','연필'],['pen','펜'],['brush','붓'],['marker','형광펜'],['airbrush','에어브러시'],['pastel','파스텔'],['smudge','문지르기']])+range('smooth','선 보정',0,.85,.05)+check('pressure','터치펜 필압 사용')+'<p class="note">두 손가락을 함께 움직이면 두 점 사이에 띠 모양으로 채색합니다. 화면 이동·확대는 선택 도구에서 가능합니다.</p>';
if(tool==='shape')s=choice('shape',[['line','직선'],['polyline','꺾은선'],['polygon','다각형'],['rect','사각형'],['round','둥근 사각형'],['circle','원'],['ellipse','타원'],['triangle','삼각형'],['diamond','마름모'],['pentagon','오각형'],['hexagon','육각형'],['star','별'],['arrow','화살표'],['heart','하트'],['bubble','말풍선']])+check('stroke','테두리 표시')+check('fillShape','내부 채우기')+'<p class="note">드래그하여 그립니다. 꺾은선·다각형은 꼭짓점을 터치한 뒤 완료를 누르세요.</p><button id="finishPoly">다각형 완료</button>';
if(tool==='select')s=choice('select',[['tap','객체 선택'],['rect','사각 선택'],['lasso','올가미']])+'<p class="note">객체를 터치하여 선택합니다. 모서리 핸들은 크기, 위쪽 핸들은 회전입니다. 빈 공간 드래그 또는 두 손가락으로 화면을 이동합니다. 영역 선택은 현재 그림을 합성한 뒤 잘라내므로 실행취소로 원래 객체를 복구할 수 있습니다.</p>';
if(tool==='fill')s=choice('brush',[['bucket','페인트통'],['eyedrop','스포이트']])+range('tolerance','색 허용차',0,100)+'<p class="note">페인트통은 연결된 영역을 채웁니다. 채우기 시 현재 그림을 하나의 이미지로 합칩니다.</p>';
if(tool==='stamp')s=choice('stamp',[...builtInStamps,...customStamps.map((_,i)=>['custom'+i,'내 그림 '+(i+1)])])+range('stampSize','크기',20,500)+range('stampSpace','연속 간격',10,200)+'<button id="importStamp">이미지로 등록</button><button id="canvasStamp">현재 그림 등록</button><button id="manageStamps">등록 스탬프 관리'+(customStamps.length?' ('+customStamps.length+')':'')+'</button><p class="note">터치 또는 드래그하여 연속으로 찍습니다. 저장한 소재는 이 브라우저에서 다시 사용할 수 있습니다.</p>';
if(tool==='effects')s=choice('effect',[['mirror','기준선 반전'],['copy','대칭 복사'],['decal','데칼코마니'],['marble','마블링'],['tile','직접 모자이크'],['mosaic','자동 모자이크']])+(settings.effect==='decal'?range('spread','번짐',0,20)+range('press','압착',0,.7,.05):'')+(['mirror','copy','decal'].includes(settings.effect)?'<p class="note">'+(settings.effect==='decal'?'캔버스에 접을 기준선을 그리세요. 점선 양쪽 물감이 함께 눌리고 퍼집니다. 방향 지정 없이 결과가 양면에 동일하게 전사됩니다.':'캔버스에 기준선을 그리세요. 선을 드래그해 조절하고, 화살표로 반전·복사 방향을 바꿉니다.')+'</p>':'')+(['tile','mosaic'].includes(settings.effect)?choice('tile',[['square','정사각형'],['triangle','삼각형'],['circle','원형'],['paper','색종이']])+range('tileSize','조각 크기',8,120)+range('gap','간격',0,20)+range('tileAngle','회전',0,180)+range('tileColors','최대 색상 수',2,32)+(settings.effect==='mosaic'?'<button id="mosaicPreview" class="primary">자동 모자이크 미리보기</button>':''):'')+(settings.effect==='marble'?'<button id="openMarble" class="primary">캔버스에서 마블링 시작</button><p class="note">현재 캔버스 위에서 물감을 떨어뜨리고 휘젓습니다. 적용 전까지 원본 그림은 변경되지 않습니다.</p>':'');
if(tool==='eraser')s='<p class="note">한 손가락이나 펜은 일반 지우개입니다. 두 손가락을 함께 움직이면 두 접점 사이를 넓게 지웁니다. 그림·도형·스탬프에도 적용되며, 두 손가락으로 지운 작업은 한 번에 실행취소할 수 있습니다.</p>'+check('pressure','터치펜 필압 사용');
$('panelBody').innerHTML=s;$('pinBtn').classList.toggle('active',settings.pin);$('pinBtn').setAttribute('aria-pressed',String(!!settings.pin));
$('panelBody').querySelectorAll('[data-key]').forEach(b=>b.onclick=()=>{if(tool==='draw'&&b.dataset.key==='brush'&&brushProfiles[b.dataset.val]){rememberBrushProfile();settings.brush=b.dataset.val;lastDrawingBrush=b.dataset.val;restoreBrushProfile(b.dataset.val)}else settings[b.dataset.key]=b.dataset.val;if(b.dataset.key==='effect')cancelEffect();updateColorControls();showPanel();if(b.dataset.key==='effect'&&b.dataset.val==='marble')openMarble()});$('panelBody').querySelectorAll('[data-range]').forEach(i=>i.oninput=()=>{settings[i.dataset.range]=+i.value;i.nextElementSibling.textContent=i.value;if(axis)buildReflection(true)});$('panelBody').querySelectorAll('[data-check]').forEach(i=>i.onchange=()=>settings[i.dataset.check]=i.checked);
if($('finishPoly'))$('finishPoly').onclick=finishPolygon;if($('importStamp'))$('importStamp').onclick=()=>importImage(true);if($('canvasStamp'))$('canvasStamp').onclick=()=>registerStamp(exportCanvas(false));if($('manageStamps'))$('manageStamps').onclick=manageStamps;if($('openMarble'))$('openMarble').onclick=openMarble;if($('mosaicPreview'))$('mosaicPreview').onclick=mosaicPreview}
$('optionsBtn').onclick=()=>{$('panel').hidden?!showPanel():$('panel').hidden=true};$('closePanel').onclick=()=>$('panel').hidden=true;$('pinBtn').onclick=()=>{settings.pin=!settings.pin;$('pinBtn').classList.toggle('active',settings.pin);$('pinBtn').setAttribute('aria-pressed',String(settings.pin))};
$('color').oninput=e=>applyColor(e.target.value);$('size').oninput=e=>{settings.size=+e.target.value;$('sizeOut').textContent=e.target.value;rememberBrushProfile()};$('alpha').oninput=e=>{settings.alpha=+e.target.value/100;$('alphaOut').textContent=e.target.value+'%';rememberBrushProfile()};
function syncSelectedStyle(){const o=objectById();if(o&&['shape','stamp'].includes(o.kind)){checkpoint();o.color=settings.color;o.fillColor=settings.color;changed()}}
$('undoBtn').onclick=undo;$('redoBtn').onclick=redo;$('zoomIn').onclick=()=>zoom(1.2);$('zoomOut').onclick=()=>zoom(1/1.2);$('fitBtn').onclick=fit;
// Browser fullscreen is independent of drawing UI: never hide the toolbar or header.
function refreshFullscreenButton(){const active=!!document.fullscreenElement;$('fullscreenBtn').innerHTML=icon(active?'restore':'fullscreen');$('fullscreenBtn').title=active?'전체화면 종료':'전체화면';$('fullscreenBtn').setAttribute('aria-label',active?'전체화면 종료':'전체화면');requestAnimationFrame(resize)}
$('fullscreenBtn').onclick=async()=>{if(document.fullscreenElement){try{await document.exitFullscreen()}catch(e){toast('전체화면 종료 실패: '+e.message)}return}if(typeof document.documentElement.requestFullscreen!=='function'){toast('이 브라우저에서는 전체화면을 지원하지 않습니다.');return}try{await document.documentElement.requestFullscreen()}catch(e){toast('전체화면을 사용할 수 없습니다. 브라우저 권한이나 실행 방식을 확인하세요.')}};
document.addEventListener('fullscreenchange',refreshFullscreenButton);
/* Input: pointer events, coalesced samples, explicit gesture cancellation. */
function inPaper(p){return p.x>=0&&p.y>=0&&p.x<=doc.w&&p.y<=doc.h}
function startStroke(p,e){live={id:uid(),kind:'stroke',brush:tool==='eraser'?'eraser':settings.brush,points:[p],color:settings.color,size:settings.size,alpha:settings.alpha,pressure:e.pointerType==='pen'&&settings.pressure,seed:Math.floor(Math.random()*1e5)}}
function localPoint(o,p){let x=p.x-o.x,y=p.y-o.y,a=-(o.angle||0);return{x:x*Math.cos(a)-y*Math.sin(a),y:x*Math.sin(a)+y*Math.cos(a)}}
function hit(p){for(let i=doc.objects.length-1;i>=0;i--){const o=doc.objects[i];if(o.kind==='stroke'||o.kind==='eraseMask'||o.matrix)continue;const q=localPoint(o,p);if(Math.abs(q.x)<=o.w/2+6/camera.z&&Math.abs(q.y)<=o.h/2+6/camera.z)return o}return null}
function selectedHandle(p){const o=objectById();if(!o)return null;const q=localPoint(o,p),r=18/camera.z;if(Math.hypot(q.x,q.y+o.h/2+28/camera.z)<r)return'rotate';for(const x of [-1,1])for(const y of [-1,1])if(Math.hypot(q.x-x*o.w/2,q.y-y*o.h/2)<r)return'resize';return null}
view.addEventListener('pointerdown',e=>{if(marble){marblePointerStart(e);return}if($('modal').open)return;if(e.pointerType==='touch'&&(penActive||settings.penOnly))return;if(e.pointerType==='pen'){if([...pointerMap.values()].some(p=>p.type==='touch')){rollbackInteraction();pointerMap.clear();gesture=null;gestureBlock=false}penActive=true;}e.preventDefault();view.setPointerCapture(e.pointerId);const p=point(e);pointerMap.set(e.pointerId,{...p,cx:e.clientX,cy:e.clientY,type:e.pointerType});
if(pointerMap.size===2&&e.pointerType==='touch'){rollbackInteraction();const ps=[...pointerMap.values()];if(tool==='select'){gesture={type:'view',distance:Math.hypot(ps[1].cx-ps[0].cx,ps[1].cy-ps[0].cy),x:(ps[0].cx+ps[1].cx)/2,y:(ps[0].cy+ps[1].cy)/2}}else if(tool==='draw'||tool==='eraser'){createRibbonBuffer(tool==='eraser'?'erase':'paint');gesture={type:'ribbon',mode:tool==='eraser'?'erase':'paint',old:ps.map(p=>({x:p.x,y:p.y}))}}else gesture={type:'ignore'};gestureBlock=true;paint();return}if(pointerMap.size>1||gestureBlock)return;
if(!settings.pin)$('panel').hidden=true;
if(axis){const da=Math.hypot(p.x-axis.a.x,p.y-axis.a.y),dbb=Math.hypot(p.x-axis.b.x,p.y-axis.b.y);drag={type:'axis',handle:da<22/camera.z?'a':dbb<22/camera.z?'b':'move',start:p,old:clone(axis)};return}
if(tool==='select'||(selected&&selectedHandle(p))){const h=selectedHandle(p),o=h?objectById():hit(p);if(h){checkpoint();drag={type:h,start:p,original:clone(o)};return}if(settings.select==='tap'){if(o){selected=o.id;checkpoint();drag={type:'move',start:p,original:clone(o)}}else{selected=null;drag={type:'pan',cx:e.clientX,cy:e.clientY,x:camera.x,y:camera.y}}}else{selected=null;drag={type:settings.select==='rect'?'rectselect':'lasso',start:p,last:p,points:[p]}}paint();return}
if(!inPaper(p))return;
if(tool==='draw'||tool==='eraser'){if(settings.brush==='smudge'&&tool==='draw'){checkpoint();drag={type:'smudge',last:p};smudge(p,p)}else startStroke(p,e)}
else if(tool==='shape'){if(['polygon','polyline'].includes(settings.shape)){if(!live||live.kind!=='shape'){live={id:uid(),kind:'shape',shape:settings.shape,x:0,y:0,w:1,h:1,points:[],closed:settings.shape==='polygon',fill:settings.fillShape&&settings.shape==='polygon',stroke:settings.stroke,color:settings.color,lineWidth:settings.size,alpha:settings.alpha}}live.points.push(p);paint();return}drag={type:'shape',start:p};live={id:uid(),kind:'shape',shape:settings.shape,x:p.x,y:p.y,w:1,h:1,angle:0,color:settings.color,lineWidth:settings.size,alpha:settings.alpha,stroke:settings.stroke,fill:settings.fillShape}}
else if(tool==='fill'){if(settings.brush==='eyedrop')eyedrop(p);else bucket(p)}
else if(tool==='stamp'){checkpoint();const count=doc.objects.length;addStamp(p);drag={type:'stamp',last:p,count}}
else if(tool==='effects'){if(['mirror','copy','decal'].includes(settings.effect)){axis={a:p,b:{x:p.x+1,y:p.y},dir:1};drag={type:'axisNew'}}else if(settings.effect==='tile'){checkpoint();const count=doc.objects.length;addTile(p);drag={type:'tile',last:p,count}}else if(settings.effect==='marble')openMarble();else mosaicPreview()}paint()});
view.addEventListener('pointermove',e=>{if(marble){marblePointerMove(e);return}if(!pointerMap.has(e.pointerId))return;e.preventDefault();const p=point(e);pointerMap.set(e.pointerId,{...p,cx:e.clientX,cy:e.clientY,type:e.pointerType});if(gesture){const ps=[...pointerMap.values()];if(ps.length<2)return;if(gesture.type==='view'){const distance=Math.hypot(ps[1].cx-ps[0].cx,ps[1].cy-ps[0].cy),x=(ps[0].cx+ps[1].cx)/2,y=(ps[0].cy+ps[1].cy)/2,r=stage.getBoundingClientRect();zoom(distance/Math.max(gesture.distance,1),gesture.x-r.left,gesture.y-r.top);camera.x+=x-gesture.x;camera.y+=y-gesture.y;gesture.distance=distance;gesture.x=x;gesture.y=y}else if(gesture.type==='ribbon'){const now=ps.map(q=>({x:q.x,y:q.y}));appendRibbonQuad([...gesture.old,now[1],now[0]]);gesture.old=now;live={kind:gesture.mode==='erase'?'ribbonErasePreview':'ribbonPreview'}}paint();return}if(gestureBlock)return;
if(live?.kind==='stroke'){const events=e.getCoalescedEvents?.()||[e];for(const ev of events){const q=point(ev),last=live.points.at(-1);if(Math.hypot(q.x-last.x,q.y-last.y)<.15)continue;const s=settings.smooth;q.x=last.x*s+q.x*(1-s);q.y=last.y*s+q.y*(1-s);live.points.push(q)}paint();return}if(!drag)return;
if(drag.type==='pan'){camera.x=drag.x+e.clientX-drag.cx;camera.y=drag.y+e.clientY-drag.cy}
if(['move','resize','rotate'].includes(drag.type)){const o=objectById(),a=drag.original;if(drag.type==='move'){o.x=a.x+p.x-drag.start.x;o.y=a.y+p.y-drag.start.y}if(drag.type==='rotate')o.angle=(a.angle||0)+Math.atan2(p.y-a.y,p.x-a.x)-Math.atan2(drag.start.y-a.y,drag.start.x-a.x);if(drag.type==='resize'){const scale=clamp(Math.hypot(p.x-a.x,p.y-a.y)/Math.max(1,Math.hypot(drag.start.x-a.x,drag.start.y-a.y)),.05,20);o.w=a.w*scale;o.h=a.h*scale;if(o.points)o.points=a.points.map(q=>({x:q.x*scale,y:q.y*scale}))}render()}
if(drag.type==='shape'){let dx=p.x-drag.start.x,dy=p.y-drag.start.y;if(settings.shape==='circle'){dx=(Math.sign(dx)||1)*Math.max(Math.abs(dx),Math.abs(dy));dy=(Math.sign(dy)||1)*Math.abs(dx)}live.x=drag.start.x+dx/2;live.y=drag.start.y+dy/2;live.w=Math.max(1,Math.abs(dx));live.h=Math.max(1,Math.abs(dy));live.fx=dx<0?-1:1;live.fy=dy<0?-1:1}
if(['rectselect','lasso'].includes(drag.type)){drag.last=p;drag.points.push(p)}
if(['stamp','tile'].includes(drag.type)){const gap=drag.type==='stamp'?settings.stampSpace:settings.tileSize+settings.gap;let d=Math.hypot(p.x-drag.last.x,p.y-drag.last.y);if(d>=gap){const a=drag.last,n=Math.min(100,Math.floor(d/gap));for(let i=1;i<=n;i++){const q={x:a.x+(p.x-a.x)*i*gap/d,y:a.y+(p.y-a.y)*i*gap/d};drag.type==='stamp'?addStamp(q):addTile(q);drag.last=q}}}
if(drag.type==='smudge'){smudge(drag.last,p);drag.last=p}
if(drag.type==='axisNew'){axis.b=p;paint()}
if(drag.type==='axis'){if(drag.handle==='move'){axis.a={x:drag.old.a.x+p.x-drag.start.x,y:drag.old.a.y+p.y-drag.start.y};axis.b={x:drag.old.b.x+p.x-drag.start.x,y:drag.old.b.y+p.y-drag.start.y}}else axis[drag.handle]=p;buildReflection(true)}paint()});
function rollbackInteraction(){
 releaseRibbonBuffer();live=null;
 if(drag){if(['move','resize','rotate'].includes(drag.type)){const o=objectById();if(o)Object.assign(o,drag.original);history.pop()}
 else if(['stamp','tile'].includes(drag.type)){doc.objects.length=drag.count;history.pop()}
 else if(drag.type==='smudge'){history.pop()}
 else if(drag.type==='axisNew'){cancelEffect()}
 else if(drag.type==='axis'){axis=drag.old;buildReflection()}}
 drag=null;render();updateUndo();
}
async function pointerEnd(e,cancel=false){if(marble){marblePointerEnd(e);return}if(!pointerMap.has(e.pointerId))return;pointerMap.delete(e.pointerId);if(e.pointerType==='pen')penActive=false;
if(gesture){if(gesture.type==='ribbon'&&ribbonBuffer?.hasPath&&!cancel){checkpoint();doc.objects.push(finishRibbon(gesture.mode));changed()}releaseRibbonBuffer();live=null;gesture=null;gestureBlock=pointerMap.size>0;paint();return}if(gestureBlock){if(!pointerMap.size)gestureBlock=false;return}if(cancel){rollbackInteraction();return}
if(live?.kind==='stroke'){const end=point(e),last=live.points.at(-1);if(Math.hypot(end.x-last.x,end.y-last.y)>.1)live.points.push(end);checkpoint();doc.objects.push(live);live=null;changed()}else if(drag?.type==='shape'&&live){checkpoint();doc.objects.push(live);selected=live.id;live=null;changed()}
if(drag){if(['move','resize','rotate','stamp','tile'].includes(drag.type))changed(drag.type==='stamp');if(drag.type==='smudge')await commitBoard();if(['rectselect','lasso'].includes(drag.type))await selectRegion(drag);if(['axisNew','axis'].includes(drag.type))buildReflection()}drag=null;paint()}
view.addEventListener('pointerup',e=>pointerEnd(e));view.addEventListener('pointercancel',e=>pointerEnd(e,true));view.addEventListener('lostpointercapture',e=>{if(pointerMap.has(e.pointerId))pointerEnd(e,true)});
view.addEventListener('wheel',e=>{e.preventDefault();const r=stage.getBoundingClientRect();zoom(Math.exp(-e.deltaY*.0015),e.clientX-r.left,e.clientY-r.top)},{passive:false});

let ribbonBuffer=null;
function createRibbonBuffer(mode='paint'){
 releaseRibbonBuffer();const c=canvas(doc.w,doc.h);
 ribbonBuffer={c,g:c.getContext('2d'),path:new Path2D(),dirty:false,hasPath:false,
   mode,color:settings.color,alpha:settings.alpha,preview:null,previewDirty:true};
 return ribbonBuffer;
}
function appendRibbonQuad(ps){
 if(!ribbonBuffer)createRibbonBuffer();
 ps.forEach((p,i)=>ribbonBuffer.path[i?'lineTo':'moveTo'](p.x,p.y));
 ribbonBuffer.path.closePath();ribbonBuffer.dirty=true;ribbonBuffer.hasPath=true;ribbonBuffer.previewDirty=true;
}
function renderRibbonBuffer(){
 const b=ribbonBuffer;if(!b)return null;
 if(b.dirty){b.g.clearRect(0,0,b.c.width,b.c.height);b.g.globalAlpha=b.alpha;
  b.g.fillStyle=b.mode==='erase'?'#000000':b.color;b.g.fill(b.path);b.dirty=false;b.previewDirty=true}
 return b.c;
}
function renderRibbonErasePreview(){
 const b=ribbonBuffer;if(!b||b.mode!=='erase')return null;
 const mask=renderRibbonBuffer();
 if(!b.preview){b.preview=canvas(doc.w,doc.h);b.previewDirty=true}
 if(b.previewDirty){const g=b.preview.getContext('2d');g.globalCompositeOperation='source-over';
  g.clearRect(0,0,doc.w,doc.h);g.drawImage(board,0,0);
  g.globalCompositeOperation='destination-out';g.drawImage(mask,0,0);
  g.globalCompositeOperation='source-over';b.previewDirty=false}
 return b.preview;
}
function releaseRibbonBuffer(){
 if(ribbonBuffer){ribbonBuffer.c.width=ribbonBuffer.c.height=1;
  if(ribbonBuffer.preview)ribbonBuffer.preview.width=ribbonBuffer.preview.height=1;
  ribbonBuffer=null}
}
function finishRibbon(mode='paint'){
 const c=renderRibbonBuffer();if(!c)return null;
 const src=c.toDataURL(),retained=canvas(c.width,c.height);
 retained.getContext('2d').drawImage(c,0,0);assets.set(src,retained);
 const o={id:uid(),kind:mode==='erase'?'eraseMask':'image',src,
  x:doc.w/2,y:doc.h/2,w:doc.w,h:doc.h,alpha:1};
 releaseRibbonBuffer();return o;
}
function pruneAssets(){
 // Preserve resources used by the active artwork, user stamps, clipboard and Undo/Redo.
 // Releasing a cache entry must never invalidate a retained historical state.
 const keep=new Set([...customStamps,...doc.objects.filter(o=>o.src).map(o=>o.src)]);
 if(copyBuffer?.src)keep.add(copyBuffer.src);
 if(live?.src)keep.add(live.src);
 for(const src of assets.keys()){
  if(keep.has(src)||history.some(h=>h.includes(src))||future.some(h=>h.includes(src)))continue;
  // Data URLs are the authoritative serialized resource; this is only a decoded cache.
  assets.delete(src);
  // An image may be referenced elsewhere (e.g. thumbnails), so don't mutate its bitmap here.
 }
}
function ribbonObject(polys){const c=canvas(doc.w,doc.h),g=c.getContext('2d');g.fillStyle=settings.color;g.globalAlpha=settings.alpha;g.beginPath();for(const ps of polys){ps.forEach((p,i)=>g[i?'lineTo':'moveTo'](p.x,p.y));g.closePath()}g.fill();const src=c.toDataURL();assets.set(src,c);return{id:uid(),kind:'image',src,x:doc.w/2,y:doc.h/2,w:doc.w,h:doc.h,alpha:1}}
function finishPolygon(){if(!live||!Array.isArray(live.points)||live.points.length<2)return;const ps=live.points,xs=ps.map(p=>p.x),ys=ps.map(p=>p.y),x=(Math.min(...xs)+Math.max(...xs))/2,y=(Math.min(...ys)+Math.max(...ys))/2;live.x=x;live.y=y;live.w=Math.max(1,Math.max(...xs)-Math.min(...xs));live.h=Math.max(1,Math.max(...ys)-Math.min(...ys));live.points=ps.map(p=>({x:p.x-x,y:p.y-y}));checkpoint();doc.objects.push(live);selected=live.id;live=null;changed()}
/* Selection and object editing. */
function contextHTML(c,html){if(c.dataset.html!==html){c.innerHTML=html;c.dataset.html=html}}
function placeContext(){const c=$('context');if(live?.kind==='shape'&&live.points?.length){c.hidden=false;contextHTML(c,'<button data-act="finishPoly" class="primary">완료</button><button data-act="cancelPoly">취소</button>');const p=live.points.at(-1);positionContext(p.x,p.y+30/camera.z);c.querySelectorAll('button').forEach(b=>b.onclick=()=>{if(b.dataset.act==='finishPoly')finishPolygon();else{live=null;paint()}});return}if(axis&&!drag){c.hidden=false;contextHTML(c,settings.effect==='decal'?'<button data-act="apply" class="primary">양면 압착 적용</button><button data-act="cancel">취소</button>':'<button data-act="direction" title="방향 반전">⇄ 방향</button><button data-act="apply" class="primary">적용</button><button data-act="cancel">취소</button>');const m=axisMid();positionContext(m.x,m.y+35/camera.z)}else if(preview&&!axis){c.hidden=false;contextHTML(c,'<button data-act="applyMosaic" class="primary">모자이크 적용</button><button data-act="cancel">취소</button>');positionContext(doc.w/2,doc.h*.15)}else{const o=objectById();if(!o){c.hidden=true;return}c.hidden=false;contextHTML(c,'<button data-act="copy" title="복사·붙여넣기">복제</button><button data-act="flipx" title="좌우 반전">↔</button><button data-act="flipy" title="상하 반전">↕</button><button data-act="edit">속성</button><button data-act="stamp">소재 등록</button><button data-act="delete" title="선택 삭제">삭제</button>');positionContext(o.x,o.y+o.h/2+18/camera.z)}c.querySelectorAll('button').forEach(b=>b.onclick=()=>contextAction(b.dataset.act))}
function positionContext(x,y){const c=$('context'),w=c.offsetWidth||280;c.style.left=clamp(camera.x+x*camera.z-w/2,10,Math.max(10,stage.clientWidth-w-10))+'px';let top=camera.y+y*camera.z;if(top+c.offsetHeight>stage.clientHeight-65)top-=c.offsetHeight+80;c.style.top=clamp(top,10,Math.max(10,stage.clientHeight-c.offsetHeight-65))+'px'}
async function contextAction(a){if(a==='direction'){if(settings.effect==='decal')return;axis.dir*=-1;buildReflection();return}if(a==='apply'){await applyReflection();return}if(a==='cancel'){cancelEffect();return}if(a==='applyMosaic'){checkpoint();await replaceWithCanvas(preview);preview=null;changed();return}const o=objectById();if(!o)return;if(a==='edit'){editObject(o);return}if(a==='stamp'){const c=canvas(Math.ceil(o.w+20),Math.ceil(o.h+20)),g=c.getContext('2d'),q=clone(o);q.x=c.width/2;q.y=c.height/2;q.angle=0;drawObject(g,q);registerStamp(c);return}checkpoint();if(a==='copy'){const q=clone(o);q.id=uid();q.x+=24;q.y+=24;doc.objects.push(q);selected=q.id}if(a==='flipx')o.fx=-(o.fx||1);if(a==='flipy')o.fy=-(o.fy||1);if(a==='delete'){doc.objects=doc.objects.filter(q=>q.id!==o.id);selected=null}changed()}
function editObject(o){modal(`<h2>선택한 그림 편집</h2><div class="rows"><label>너비<input id="objW" type="number" min="1" value="${Math.round(o.w)}"></label><label>높이<input id="objH" type="number" min="1" value="${Math.round(o.h)}"></label><label>회전 (°)<input id="objA" type="number" value="${Math.round((o.angle||0)*180/Math.PI)}"></label><label>투명도 (%)<input id="objO" type="number" min="1" max="100" value="${Math.round((o.alpha??1)*100)}"></label>${o.kind==='shape'?`<label>테두리 색<input id="objC" type="color" value="${o.color}"></label><label>채우기 색<input id="objF" type="color" value="${o.fillColor||o.color}"></label><label><input id="objFill" type="checkbox" ${o.fill?'checked':''}>내부 채우기</label><label><input id="objStroke" type="checkbox" ${o.stroke?'checked':''}>테두리</label>`:''}</div><div class="actions"><button data-close>취소</button><button id="objApply" class="primary">적용</button></div>`);$('objApply').onclick=()=>{const w=+$('objW').value,h=+$('objH').value;if(!(w>0&&h>0&&w<20000&&h<20000))return toast('크기를 확인하세요');checkpoint();if(o.points)o.points=o.points.map(p=>({x:p.x*w/o.w,y:p.y*h/o.h}));o.w=w;o.h=h;o.angle=(+$('objA').value||0)*Math.PI/180;o.alpha=clamp(+$('objO').value/100,.01,1);if(o.kind==='shape'){o.color=$('objC').value;o.fillColor=$('objF').value;o.fill=$('objFill').checked;o.stroke=$('objStroke').checked}closeModal();changed()}}
async function selectRegion(d){const ps=d.type==='rectselect'?[d.start,{x:d.last.x,y:d.start.y},d.last,{x:d.start.x,y:d.last.y}]:d.points;if(ps.length<3)return;const xs=ps.map(p=>p.x),ys=ps.map(p=>p.y),x=Math.floor(clamp(Math.min(...xs),0,doc.w)),y=Math.floor(clamp(Math.min(...ys),0,doc.h)),w=Math.ceil(clamp(Math.max(...xs),0,doc.w)-x),h=Math.ceil(clamp(Math.max(...ys),0,doc.h)-y);if(w<3||h<3)return;checkpoint();const cut=canvas(w,h),cg=cut.getContext('2d');cg.beginPath();ps.forEach((p,i)=>cg[i?'lineTo':'moveTo'](p.x-x,p.y-y));cg.closePath();cg.clip();cg.drawImage(board,-x,-y);ctx.save();ctx.globalCompositeOperation='destination-out';ctx.beginPath();ps.forEach((p,i)=>ctx[i?'lineTo':'moveTo'](p.x,p.y));ctx.closePath();ctx.fill();ctx.restore();await replaceWithCanvas(board);const src=cut.toDataURL();assets.set(src,cut);const o={id:uid(),kind:'image',src,x:x+w/2,y:y+h/2,w,h};doc.objects.push(o);selected=o.id;changed()}
async function restoreRaster(src){const im=await getAsset(src);ctx.clearRect(0,0,doc.w,doc.h);ctx.drawImage(im,0,0);paint()}
async function replaceWithCanvas(c){const frozen=canvas(c.width,c.height);frozen.getContext('2d').drawImage(c,0,0);const src=frozen.toDataURL();assets.set(src,frozen);doc.objects=[{id:uid(),kind:'image',src,x:doc.w/2,y:doc.h/2,w:doc.w,h:doc.h}];selected=null}
async function commitBoard(){await replaceWithCanvas(board);changed()}
function getAsset(src){if(assets.has(src))return Promise.resolve(assets.get(src));return new Promise((resolve,reject)=>{const im=new Image();im.onload=()=>{assets.set(src,im);resolve(im)};im.onerror=()=>reject(Error('이미지 읽기 실패'));im.src=src})}
/* Smudge: pigment transport on the CURRENT composited bitmap. The brush
   carries color and alpha from the trailing contact footprint to the new one,
   with feathered mixing rather than stamping a translucent old patch. */
function smudgeStep(a,b){
 const r=clamp(Math.round(settings.size*.5),4,100),size=r*2+2;
 const ax=Math.round(a.x-r),ay=Math.round(a.y-r),bx=Math.round(b.x-r),by=Math.round(b.y-r);
 const source=ctx.getImageData(ax,ay,size,size).data;
 const dst=ctx.getImageData(bx,by,size,size),out=dst.data;
 const strength=clamp(settings.alpha,0,1);
 let active=false;
 for(let y=1;y<size-1;y++)for(let x=1;x<size-1;x++){
  const nx=(x-r-1)/r,ny=(y-r-1)/r,rr=nx*nx+ny*ny;
  if(rr>=1)continue;
  const edge=(1-rr)*(1-rr);
  // Tiny local diffusion softens the chalk grains, while the offset source
  // sample actually pulls pigment along the finger's travel direction.
  const j=(y*size+x)*4,jl=j-4,jr=j+4,ju=j-size*4,jd=j+size*4;
  const sa=(source[j+3]*.70+(source[jl+3]+source[jr+3]+source[ju+3]+source[jd+3])*.075)/255;
  const da=out[j+3]/255;
  const transport=clamp(edge*strength*.80,0,.82);
  const smudgeAlpha=(source[j+3]*.70+(source[jl+3]+source[jr+3]+source[ju+3]+source[jd+3])*.075)/255;
  const newAlpha=da*(1-transport)+smudgeAlpha*transport;
  if(!newAlpha)continue;
  for(let ch=0;ch<3;ch++){
   const sourceColor=(source[j+ch]*source[j+3]*.70+
    (source[jl+ch]*source[jl+3]+source[jr+ch]*source[jr+3]+source[ju+ch]*source[ju+3]+source[jd+ch]*source[jd+3])*.075)/255;
   const dstColor=out[j+ch]*da;
   out[j+ch]=clamp(Math.round((dstColor*(1-transport)+sourceColor*transport)/newAlpha),0,255);
  }
  out[j+3]=Math.round(newAlpha*255);active=true;
 }
 if(active)ctx.putImageData(dst,bx,by);
}
function smudge(a,b){
 const dist=Math.hypot(b.x-a.x,b.y-a.y),step=Math.max(2,settings.size*.16);
 // Keep each substep within a fraction of the finger pad so pigment doesn't
 // jump or leave disconnected stamps on fast swipes.
 const n=clamp(Math.ceil(dist/step),1,80);
 for(let k=1;k<=n;k++){
  const t=k/n,p={x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t};
  const previous={x:a.x+(b.x-a.x)*(k-1)/n,y:a.y+(b.y-a.y)*(k-1)/n};
  smudgeStep(previous,p);
 }
 paint();
}
function eyedrop(p){const g=exportCanvas(true).getContext('2d'),d=g.getImageData(clamp(Math.floor(p.x),0,doc.w-1),clamp(Math.floor(p.y),0,doc.h-1),1,1).data;settings.color='#'+[...d.slice(0,3)].map(n=>n.toString(16).padStart(2,'0')).join('');$('color').value=settings.color;document.querySelectorAll('.swatch').forEach(b=>b.classList.toggle('active',b.dataset.color===settings.color));toast('색상을 가져왔습니다')}
function floodPixels(match,dest,w,h,px,py,color,alpha,tolerance){
 const x0=clamp(Math.floor(px),0,w-1),y0=clamp(Math.floor(py),0,h-1),i0=(y0*w+x0)*4,target=Array.from(match.slice(i0,i0+4)),seen=new Uint8Array(w*h),stack=[y0*w+x0];let count=0;
 const matches=p=>{if(seen[p])return false;const i=p*4;return Math.abs(match[i]-target[0])<=tolerance&&Math.abs(match[i+1]-target[1])<=tolerance&&Math.abs(match[i+2]-target[2])<=tolerance&&Math.abs(match[i+3]-target[3])<=tolerance};
 while(stack.length){const pos=stack.pop();if(!matches(pos))continue;const y=Math.floor(pos/w);let x=pos%w;while(x>0&&matches(y*w+x-1))x--;let up=false,down=false;for(;x<w&&matches(y*w+x);x++){const p=y*w+x,i=p*4;seen[p]=1;count++;const da=dest[i+3]/255,oa=alpha+da*(1-alpha);for(let ch=0;ch<3;ch++)dest[i+ch]=oa?(color[ch]*alpha+dest[i+ch]*da*(1-alpha))/oa:0;dest[i+3]=Math.round(oa*255);if(y>0){const yes=matches(p-w);if(yes&&!up)stack.push(p-w);up=yes}if(y<h-1){const yes=matches(p+w);if(yes&&!down)stack.push(p+w);down=yes}}}return count;
}
async function bucket(p){checkpoint();const visible=exportCanvas(true).getContext('2d').getImageData(0,0,doc.w,doc.h),c=exportCanvas(false),g=c.getContext('2d'),im=g.getImageData(0,0,doc.w,doc.h),rgb=settings.color.match(/\w\w/g).map(x=>parseInt(x,16));floodPixels(visible.data,im.data,doc.w,doc.h,p.x,p.y,rgb,settings.alpha,settings.tolerance);g.putImageData(im,0,0);await replaceWithCanvas(c);changed()}
// Registered stamp management. Deleting a library entry must not delete artwork that already uses it.
function manageStamps(){
 modal('<h2>등록 스탬프 관리</h2><p class="note">보관함에서 제거해도 캔버스에 이미 찍은 그림은 그대로 남습니다.</p><div id="customStampList" class="custom-stamp-list"></div><div class="actions"><button data-close>닫기</button></div>');
 // modal() binds data-close before the dynamic rows are populated.
 renderCustomStampList();
}
function renderCustomStampList(){
 const list=$('customStampList');if(!list)return;
 list.replaceChildren();
 if(!customStamps.length){const p=document.createElement('p');p.className='note';p.textContent='등록한 내 그림이나 사진이 없습니다.';list.append(p);return}
 customStamps.forEach((src,index)=>{
  const row=document.createElement('div');row.className='custom-stamp-row';
  const img=document.createElement('img');img.src=src;img.alt='내 그림 '+(index+1);
  const name=document.createElement('span');name.textContent='내 그림 '+(index+1);
  const del=document.createElement('button');del.className='danger';del.textContent='삭제';del.title='내 그림 '+(index+1)+' 보관함에서 삭제';
  del.onclick=()=>confirmDeleteStamp(index);
  row.append(img,name,del);list.append(row);
 });
}
function confirmDeleteStamp(index){
 if(index<0||index>=customStamps.length)return;
 modal('<h2>등록 스탬프 삭제</h2><p class="note">내 그림 '+(index+1)+'을(를) 스탬프 보관함에서 삭제할까요? 캔버스에 이미 찍은 그림은 지워지지 않습니다.</p><div class="actions"><button id="backToStampList">취소</button><button id="deleteCustomStamp" class="primary">삭제</button></div>');
 $('backToStampList').onclick=manageStamps;
 $('deleteCustomStamp').onclick=async()=>{
  const button=$('deleteCustomStamp');button.disabled=true;