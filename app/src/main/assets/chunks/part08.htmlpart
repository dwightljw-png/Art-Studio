function decalPreviewScale(){return Math.min(1,460/Math.max(doc.w,doc.h))}

let reflectionSource=null;
function buildReflection(draft=false){if(!axis||Math.hypot(axis.b.x-axis.a.x,axis.b.y-axis.a.y)<2)return;if(settings.effect==='decal'){reflectionSource=null;preview=buildDecal(draft?decalPreviewScale():1);paint();return;}const c=canvas(doc.w,doc.h),g=c.getContext('2d'),n=axisNormal(),m=axisMid(),dx=axis.b.x-axis.a.x,dy=axis.b.y-axis.a.y,l=Math.hypot(dx,dy),u={x:dx/l,y:dy/l},far=Math.max(doc.w,doc.h)*6,sgn=-axis.dir;g.beginPath();g.moveTo(m.x-u.x*far,m.y-u.y*far);g.lineTo(m.x+u.x*far,m.y+u.y*far);g.lineTo(m.x+u.x*far+n.x*far*sgn,m.y+u.y*far+n.y*far*sgn);g.lineTo(m.x-u.x*far+n.x*far*sgn,m.y-u.y*far+n.y*far*sgn);g.closePath();g.clip();g.drawImage(board,0,0);reflectionSource=c;preview=canvas(doc.w,doc.h);const pg=preview.getContext('2d');pg.transform(...reflectionMatrix(axis.a,axis.b));pg.drawImage(c,0,0);paint()}
async function applyReflection(){if(!preview)return;if(settings.effect==='decal')preview=buildDecal(1);checkpoint();const out=canvas(doc.w,doc.h),g=out.getContext('2d');if(settings.effect!=='decal')g.drawImage(board,0,0);if(settings.effect==='mirror'){g.globalCompositeOperation='destination-out';g.drawImage(reflectionSource,0,0);g.globalCompositeOperation='source-over'}g.drawImage(preview,0,0);await replaceWithCanvas(out);cancelEffect();changed()}
function cancelEffect(){axis=null;preview=null;reflectionSource=null;paint()}
function tilePath(g,x,y,size,type,angle=0,seed=1){g.save();g.translate(x,y);g.rotate(angle*Math.PI/180);g.beginPath();const r=size/2;if(type==='circle')g.arc(0,0,r,0,Math.PI*2);else if(type==='triangle'){g.moveTo(0,-r);g.lineTo(r,r);g.lineTo(-r,r);g.closePath()}else if(type==='paper'){for(let i=0;i<7;i++){const a=i*Math.PI*2/7,rr=r*(.7+.3*seeded(seed+i));g[i?'lineTo':'moveTo'](Math.cos(a)*rr,Math.sin(a)*rr)}g.closePath()}else g.rect(-r,-r,size,size);g.fill();g.restore()}
function addTile(p){const n=settings.tileSize,c=canvas(n*1.5,n*1.5),g=c.getContext('2d');g.fillStyle=settings.color;tilePath(g,c.width/2,c.height/2,Math.max(1,n-settings.gap),settings.tile,settings.tileAngle,Date.now());const src=c.toDataURL();assets.set(src,c);doc.objects.push({id:uid(),kind:'image',src,x:p.x,y:p.y,w:c.width,h:c.height,alpha:settings.alpha});render()}
function mosaicPalette(samples,k){if(!samples.length)return[[255,255,255]];const sorted=[...samples].sort((a,b)=>a.reduce((x,y)=>x+y)-b.reduce((x,y)=>x+y));let centers=Array.from({length:Math.min(k,sorted.length)},(_,i)=>sorted[Math.floor(i*(sorted.length-1)/Math.max(1,k-1))].slice());for(let t=0;t<7;t++){const sums=centers.map(()=>[0,0,0,0]);for(const p of samples){let best=0,d=Infinity;centers.forEach((q,i)=>{const n=p.reduce((s,v,j)=>s+(v-q[j])**2,0);if(n<d){best=i;d=n}});p.forEach((v,j)=>sums[best][j]+=v);sums[best][3]++}centers=centers.map((c,i)=>sums[i][3]?sums[i].slice(0,3).map(v=>v/sums[i][3]):c)}return centers}
function mosaicPreview(){const source=exportCanvas(true),src=source.getContext('2d').getImageData(0,0,doc.w,doc.h).data,c=canvas(doc.w,doc.h),g=c.getContext('2d'),n=settings.tileSize;let rect={x:0,y:0,w:doc.w,h:doc.h};const o=objectById();if(o)rect={x:Math.max(0,o.x-o.w/2),y:Math.max(0,o.y-o.h/2),w:o.w,h:o.h};const tiles=[];for(let y=rect.y;y<Math.min(doc.h,rect.y+rect.h);y+=n)for(let x=rect.x;x<Math.min(doc.w,rect.x+rect.w);x+=n){let sums=[0,0,0],count=0;for(let yy=y;yy<Math.min(doc.h,y+n);yy+=Math.max(1,n/4))for(let xx=x;xx<Math.min(doc.w,x+n);xx+=Math.max(1,n/4)){const k=(Math.floor(yy)*doc.w+Math.floor(xx))*4;for(let ch=0;ch<3;ch++)sums[ch]+=src[k+ch];count++}tiles.push({x,y,rgb:sums.map(v=>v/count)})}const sample=tiles.filter((_,i)=>i%Math.max(1,Math.ceil(tiles.length/3000))===0).map(t=>t.rgb),colors=mosaicPalette(sample,settings.tileColors);g.drawImage(board,0,0);g.clearRect(rect.x,rect.y,rect.w,rect.h);g.save();g.beginPath();g.rect(rect.x,rect.y,rect.w,rect.h);g.clip();for(const t of tiles){let best=colors[0],dist=Infinity;for(const c of colors){const d=c.reduce((s,v,i)=>s+(v-t.rgb[i])**2,0);if(d<dist){dist=d;best=c}}g.fillStyle=`rgb(${best.map(Math.round).join(',')})`;tilePath(g,t.x+n/2,t.y+n/2,Math.max(1,n-settings.gap),settings.tile,settings.tileAngle,t.x+t.y)}g.restore();preview=c;axis=null;$('panel').hidden=true;paint()}
