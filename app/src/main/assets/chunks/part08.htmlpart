     if(worker)worker.terminate();worker=null;m.compactWorker=null;m.compactAbort=null;
     result=await marbleReplay.replay(payload,()=>{},async()=>{await new Promise(r=>setTimeout(r,0));if(marble!==m)throw Error('취소')});
    }
   }else{
    result=await marbleReplay.replay(payload,()=>{},async()=>{await new Promise(r=>setTimeout(r,0));if(marble!==m)throw Error('취소')});
   }
   if(marble!==m)return;
   m.snapshot={w:result.w,h:result.h,buffer:result.buffer};m.compactFailureAt=0;
   m.ops.splice(0,count);
   m.checkpoints=(m.checkpoints||0)+1;
  }catch(e){if(marble===m){m.compactFailureAt=Date.now();console.warn('마블링 이력 압축 실패 · 기존 기록 유지',e)}}
  finally{
   if(worker)worker.terminate();if(url)URL.revokeObjectURL(url);
   if(m.compactWorker===worker)m.compactWorker=null;m.compactAbort=null;
  }
 })().finally(()=>{m.compacting=null;if(marble===m&&!m.rendering&&!m.compactFailureAt&&m.ops.length>=MARBLE_COMPACT_AT)setTimeout(compactMarbleIfNeeded,0)});
}
