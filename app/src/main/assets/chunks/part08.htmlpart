  if(o.type==='drop'){const dx=x-o.x,dy=y-o.y,d=Math.hypot(dx,dy);if(d<1)return[x,y];const v=Math.sqrt(Math.max(0,d*d-o.r*o.r))/d;return[o.x+dx*v,o.y+dy*v]}
