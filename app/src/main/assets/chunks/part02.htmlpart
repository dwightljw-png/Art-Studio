 outline:1px solid #00e8ff;box-shadow:0 0 9px rgba(0,232,255,.25)}
body.cyber input[type=checkbox],body.cyber input[type=range]{accent-color:#00e8ff}
body.cyber input[type=color]{background:#091225;border-color:#2b4265}
/* Buttons styled, swatches excluded: their actual RGB colors are untouched. */
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip){
 --c:var(--cy-accent,#00e8ff);position:relative;isolation:isolate;overflow:hidden;
 background:linear-gradient(180deg,color-mix(in srgb,var(--c) 11%,#0c1524),#050913 74%);
 border-color:color-mix(in srgb,var(--c) 78%,#1f3553);
 border-radius:3px;color:#f7fbff;
 text-shadow:0 1px 1px #030712,0 0 7px color-mix(in srgb,var(--c) 40%,transparent);
 box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 20%,transparent),0 0 10px color-mix(in srgb,var(--c) 18%,transparent),inset 0 0 8px color-mix(in srgb,var(--c) 9%,transparent);
}
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip):hover:not(:disabled){
 background:linear-gradient(180deg,color-mix(in srgb,var(--c) 18%,#10192a),#050913 78%);
 box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 26%,transparent),0 0 14px color-mix(in srgb,var(--c) 24%,transparent),inset 0 0 10px color-mix(in srgb,var(--c) 12%,transparent);
}
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip):is(.active,.primary,.cy-hot,#cyberToggle.cy-on){
 background:linear-gradient(180deg,color-mix(in srgb,var(--c) 32%,#122033),color-mix(in srgb,var(--c) 16%,#050913));
 border-color:var(--c);
 color:#fff;
 box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 40%,transparent),0 0 18px color-mix(in srgb,var(--c) 42%,transparent),0 0 28px color-mix(in srgb,var(--c) 22%,transparent),inset 0 0 14px color-mix(in srgb,var(--c) 18%,transparent);
 text-shadow:0 0 1px #fff,0 0 11px color-mix(in srgb,var(--c) 68%,transparent);
}
/* Neon tube border. Apply lightly to normal buttons and brighter when ON. */
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip)::before{
 content:'';position:absolute;inset:-1px;pointer-events:none;opacity:.72;
 border:1px solid color-mix(in srgb,var(--c,#00e8ff) 90%,white 0%);border-radius:inherit;
 box-shadow:0 0 4px var(--c,#00e8ff),0 0 11px color-mix(in srgb,var(--c,#00e8ff) 58%,transparent),inset 0 0 7px color-mix(in srgb,var(--c,#00e8ff) 20%,transparent);
 animation:var(--cy-flick,cyArtFlickA) var(--cy-speed,9.2s) steps(1,end) var(--cy-delay,0s) infinite;
}
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip):is(.active,.primary,.cy-hot,#cyberToggle.cy-on)::before{opacity:1}
@keyframes cyArtFlickA{0%,13%,41%,43%,72%,75%,100%{opacity:.9}14%,42%,73%{opacity:.22}15%,42.8%,74%{opacity:1}}
@keyframes cyArtFlickB{0%,28%,30%,58%,61%,100%{opacity:.92}29%,59%{opacity:.22}29.8%,60%{opacity:.97}}
body.cyber #projectBtn{--cy-accent:#00e8ff}
body.cyber #cyberToggle{--cy-accent:#ff2bd1;--cy-speed:8.8s;--cy-delay:-4.1s}
body.cyber #fullscreenBtn{--cy-accent:#35ff9a;--cy-speed:10.9s;--cy-delay:-3.7s}
body.cyber #undoBtn{--cy-accent:#00e8ff;--cy-speed:8.7s;--cy-delay:-2.3s}
body.cyber #redoBtn{--cy-accent:#ff2bd1;--cy-speed:10.4s;--cy-delay:-1.2s}
body.cyber #saveBtn{--cy-accent:#35ff9a;--cy-speed:9.8s;--cy-delay:-1.4s}
body.cyber #exportBtn{--cy-accent:#ffe600;--cy-speed:11.5s;--cy-delay:-5.1s}
body.cyber #printBtn{--cy-accent:#ffe600;--cy-speed:12.4s;--cy-delay:-5.6s}
body.cyber #settingsBtn{--cy-accent:#ff2bd1;--cy-speed:10.7s;--cy-delay:-2.2s}
body.cyber nav button[data-tool=draw],body.cyber nav button[data-tool=select]{--cy-accent:#00e8ff}
body.cyber nav button[data-tool=shape],body.cyber nav button[data-tool=stamp]{--cy-accent:#35ff9a}
body.cyber nav button[data-tool=effects]{--cy-accent:#ffe600}
body.cyber nav button[data-tool=fill],body.cyber nav button[data-tool=eraser]{--cy-accent:#ff2bd1}
body.cyber #panel .choices button:nth-child(4n+1){--cy-accent:#00e8ff}
body.cyber #panel .choices button:nth-child(4n+2){--cy-accent:#35ff9a}
body.cyber #panel .choices button:nth-child(4n+3){--cy-accent:#ff2bd1}
body.cyber #panel .choices button:nth-child(4n){--cy-accent:#ffe600}
body.cyber #moreColorsBtn{--cy-accent:#ffe600}
body.cyber #optionsBtn{--cy-accent:#ff2bd1}
body.cyber #marbleApply,body.cyber #outputGo{--cy-accent:#35ff9a}
body.cyber #marbleCancel,body.cyber #marbleClear{--cy-accent:#ff2bd1}
body.cyber #viewbar button{--cy-accent:#00e8ff}
body.cyber header button:nth-of-type(1){--cy-accent:#00e8ff}
body.cyber header button:nth-of-type(2){--cy-accent:#ff2bd1}
body.cyber header button:nth-of-type(3){--cy-accent:#00e8ff}
body.cyber header button:nth-of-type(4){--cy-accent:#35ff9a}
body.cyber header button:nth-of-type(5){--cy-accent:#00e8ff}
body.cyber header button:nth-of-type(6){--cy-accent:#35ff9a}
body.cyber header button:nth-of-type(7){--cy-accent:#ff2bd1}
body.cyber header button:nth-of-type(8){--cy-accent:#ffe600}
body.cyber nav button:nth-child(4n+1){--cy-accent:#00e8ff}
body.cyber nav button:nth-child(4n+2){--cy-accent:#35ff9a}
body.cyber nav button:nth-child(4n+3){--cy-accent:#ff2bd1}
body.cyber nav button:nth-child(4n){--cy-accent:#ffe600}
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:disabled{opacity:.40!important;filter:none}
body.cyber #colorControls.is-eraser{filter:grayscale(1);opacity:.4} /* original inactive behavior */
body.cyber .swatch.active i{outline-color:#00e8ff}
body.cyber .color-chip,body.cyber .swatch{background:transparent;color:#eaf3ff}
body.cyber #toast{background:#050a15;color:#fff;border:1px solid #00e8ff;box-shadow:0 0 14px rgba(0,232,255,.32)}
body.cyber #runtimeAlert{background:#261405;color:#fff1c8;border-color:#ffe600} /* never suppress startup errors */
/* Actual preview and marbling canvas should remain color-accurate. */
body.cyber #marbleCanvas,body.cyber #exportPreview{filter:none!important}
body.cyber .work img{filter:none!important}
@media(max-width:480px){body.cyber .cy-neon-title{font-size:10px;letter-spacing:0}body.cyber .cy-art-sub{font-size:7px;letter-spacing:.07em}body.cyber .cy-art-mark{top:8%;width:min(72%,360px)}body.cyber #stage.cy-art-empty .cy-art-mark{padding:0 2px}}
@media(prefers-reduced-motion:reduce){body.cyber .cy-bad,body.cyber button::before,body.cyber .cy-art-logo img{animation:none!important}}
}
@media print{#cyberToggle,.cy-art-mark{display:none!important}}

/* v2.1 mobile header: preserve one-tap primary actions; secondary actions in overflow. */
#headerMoreBtn{display:none;flex:0 0 auto}
#headerMoreMenu[hidden]{display:none!important}
#headerMoreMenu{position:fixed;right:8px;top:62px;z-index:50;background:#fff;
  color:#0f172a;border:1px solid #e2e8f0;border-radius:12px;
  padding:7px;box-shadow:0 10px 28px rgba(15,23,42,.22);min-width:172px}
#headerMoreMenu button{display:flex;width:100%;justify-content:flex-start;
  min-height:46px;gap:12px;padding:10px 12px;border-radius:8px}
#headerMoreMenu button svg{height:20px;width:20px}
body.cyber #headerMoreMenu{background:#080d1a;color:#eaf3ff;border-color:#28466c}
body.cyber #headerMoreMenu button{color:#eaf3ff;border:1px solid transparent}
body.cyber #headerMoreMenu button:hover{background:#11243a;border-color:#00e8ff}
@media(max-width:955px){
 header{overflow:hidden!important;gap:0;justify-content:space-between}
 header #exportBtn,header #printBtn,header #settingsBtn,header #saveState,header .divider{display:none!important}
 header #headerMoreBtn{display:inline-flex!important}
 header .spacer{display:none}
 header>button:not(#projectBtn){height:44px;min-height:44px;min-width:44px;width:44px;flex:0 0 44px;padding:6px}
 header #projectBtn{width:122px;min-width:90px;flex:1 1 auto;max-width:156px;overflow:hidden}
 header .brand{font-size:12px;letter-spacing:.3px}
 body.cyber header .cy-neon-title{font-size:11px!important;letter-spacing:0!important}
 body.cyber #cyberToggle{height:44px;min-height:44px;min-width:44px;width:44px}
 body.cyber #cyberToggle .cy-switch-label{display:none!important}
 #headerMoreMenu{top:60px}
}
@media(min-width:956px) and (max-width:1024px){header .divider{margin:0 3px}}
@media(max-width:480px){
 body.cyber header .cy-neon-title{font-size:0!important;letter-spacing:0!important}
 body.cyber header .cy-neon-title::after{content:'CYBER';font-size:12px;letter-spacing:.05em}
}
@media(max-width:390px){
 header #projectBtn{max-width:96px;padding:3px!important}
 header>button:not(#projectBtn){min-width:42px;width:42px;flex-basis:42px}
 body.cyber #cyberToggle{min-width:42px;width:42px}
}
@media(max-width:350px){
 header #redoBtn{display:none!important}
 header #projectBtn{max-width:88px}
 #headerMoreMenu .more-redo{display:flex}
}
@media(min-width:351px){#headerMoreMenu .more-redo{display:none}}
/* Artwork watermark is visible only on truly blank canvases, never over work. */
body.cyber #stage:not(.cy-art-empty) .cy-art-mark{opacity:0!important;visibility:hidden!important}
/* Neon tubes keep a static glow; flicker only selected or processing buttons. */
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip)::before{
 animation:none!important;opacity:.7
}
body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button:not(.swatch):not(.color-chip):is(.active,.primary,.cy-hot,#cyberToggle.cy-on)::before{
 animation:cyArtFlickA 12s steps(1,end) infinite!important;opacity:1
}
@media(prefers-reduced-motion:reduce){body.cyber :is(header,nav,#panel,#marbleDock,#viewbar,#context,dialog,#bottom) button::before{animation:none!important}}

/* v2.0: repair header compression without changing underlying actions. */
@media (max-width:955px){
 header{justify-content:flex-start!important;gap:6px!important;overflow:hidden!important}
 header #projectBtn{width:auto;flex:0 1 186px;max-width:186px;min-width:112px;overflow:hidden;justify-content:flex-start!important}
 header .brand{max-width:100%;overflow:hidden;text-overflow:ellipsis;letter-spacing:.25px!important}
 header .label{display:none!important} /* 44px icon buttons must never retain long text */
 header>button:not(#projectBtn){min-width:44px;width:44px;flex:0 0 44px;padding:7px!important;overflow:hidden;gap:0}
 header .spacer{display:none!important}
 header #headerMoreBtn{margin-left:auto;display:inline-flex!important}
 header #cyberToggle{min-height:44px;height:44px;width:48px!important;min-width:48px!important;flex:0 0 48px!important;padding:5px!important}
 header #cyberToggle .cy-switch-label{display:none!important}
 header #cyberToggle .cy-switch-symbol{font:800 12px/1 system-ui,sans-serif!important;letter-spacing:.02em}
}
@media (max-width:480px){
 header{gap:3px!important;padding:4px 4px!important}
 header #projectBtn{flex:1 1 auto;min-width:72px;max-width:115px;width:auto}
 header>button:not(#projectBtn){min-width:42px;width:42px;flex:0 0 42px}
 header #cyberToggle{width:42px!important;min-width:42px!important;flex:0 0 42px!important}
 header .brand{font-size:11px!important;letter-spacing:0!important}
 body.cyber header .cy-neon-title::after{content:'CYBER';font-size:11px;letter-spacing:0}
 header .brand small{display:block!important;font-size:0!important;line-height:1.2!important;margin-top:2px;color:#64748b}
 header .brand small::after{content:'v4.0';font-size:9px;font-weight:600;letter-spacing:0}
 body.cyber header .brand small{color:#ffb8ed}
}
@media (max-width:350px){
 header{gap:2px!important}
 header #projectBtn{max-width:75px;min-width:62px}
 header>button:not(#projectBtn){min-width:40px;width:40px;flex:0 0 40px}
 header #cyberToggle{width:40px!important;min-width:40px!important;flex:0 0 40px!important}
}
#cyberToggle .cy-switch-symbol{display:inline-block;min-width:18px;text-align:center;font-size:13px;line-height:1;font-weight:850;letter-spacing:0}

/* v2.0.1: button-specific neon accents were masked by the common --c declaration.
   Present the same four original accent hues as brightly lit tubes, not solid rainbow fills.
   Apply only to main actions; leave palettes, canvas, export, panel controls intact. */
body.cyber :is(header,nav) button:not(.active):not(.primary):not(.cy-hot):not(#cyberToggle.cy-on):not(:disabled){
  color:var(--c);
  text-shadow:0 0 7px color-mix(in srgb,var(--c) 75%,transparent);
  border-color:var(--c);
  box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 37%,transparent),
    0 0 12px color-mix(in srgb,var(--c) 39%,transparent),
    inset 0 0 9px color-mix(in srgb,var(--c) 13%,transparent);
}
body.cyber :is(header,nav) button:not(.active):not(.primary):not(.cy-hot):not(#cyberToggle.cy-on):not(:disabled)::before{opacity:.88}
/* The earlier CYBER apps placed the ◢/◧ glyph ahead of the mode label. */
#cyberToggle .cy-switch-symbol{flex:none;min-width:16px}
/* Tablet header has room to show the ◢ symbol AND its mode label. Keep phone's compact icon. */
@media(min-width:600px) and (max-width:955px){
 header #cyberToggle{width:106px!important;min-width:106px!important;flex:0 0 106px!important;gap:5px!important}
 body header #cyberToggle .cy-switch-label, body.cyber header #cyberToggle .cy-switch-label{display:inline!important;font-size:10px!important}
}
/* Keep the graffiti behind the paper, not composited onto or above the art. */
body.cyber #stage .cy-art-mark{z-index:0!important}
body.cyber #stage #view{z-index:1}
body.cyber #stage.cy-art-working .cy-art-mark,body.cyber #stage:not(.cy-art-empty) .cy-art-mark{visibility:hidden!important;opacity:0!important}

/* v2.0.3 · WATERCOLOUR ATELIER (standard mode only)
   The v2.0.1 application engine, original geometry, controls, sizes and output
   paths are untouched. All artwork below is decorative, pre-rendered bitmaps.
   Do not set `position`, width, height, flex, padding, gap, font-size on real UI. */
body:not(.cyber){
 --bg:#eaf7f6;--panel:#f8fdfc;--line:#bcdadf;--blue:#398ca6;
 --text:#375a67;--muted:#70949f;
 background:#eaf7f6;
}
body:not(.cyber) header{
 background:#f4fbfa url("data:image/jpeg;base64,") center / cover no-repeat;